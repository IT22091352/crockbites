{
  "name": "crockbites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CrockBites — easy slow cooker recipes and everyday meals. Static Astro site for Cloudflare Pages.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "keywords": "python3 scripts/build-keyword-ideas.py",
    "check:links": "python3 scripts/check-links.py",
    "logo": "python3 scripts/build-logo.py && node scripts/build-icons.mjs",
    "placeholders": "python3 scripts/build-placeholders.py",
    "verify": "astro check && astro build && python3 scripts/check-links.py && node tests/dom-smoke.test.cjs",
    "test:dom": "node tests/dom-smoke.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@lucide/astro": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0"
  }
}
