{
  "name": "crockbites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CrockBites — easy slow cooker recipes and everyday meals. Static Astro site for Cloudflare Pages.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/bundle-worker.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "keywords": "python scripts/build-keyword-ideas.py",
    "check:links": "python scripts/check-links.py",
    "logo": "python scripts/build-logo.py && node scripts/build-icons.mjs",
    "placeholders": "python scripts/build-placeholders.py",
    "verify": "astro check && astro build && python scripts/check-links.py && node tests/dom-smoke.test.cjs && node --experimental-strip-types tests/auth-security.test.mjs",
    "test:dom": "node tests/dom-smoke.test.cjs",
    "test:auth": "node --experimental-strip-types tests/auth-security.test.mjs",
    "test:recipe": "node --experimental-strip-types tests/recipe-and-cloudinary.test.mjs",
    "test:units": "node --experimental-strip-types tests/cooking-units.test.mjs",
    "test:dietary": "node --experimental-strip-types tests/dietary-and-allergens.test.mjs",
    "test": "npm run test:auth && npm run test:recipe && npm run test:units && npm run test:dietary && npm run test:dom"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource-variable/figtree": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@lucide/astro": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "cloudinary": "^2.11.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261028.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  }
}
