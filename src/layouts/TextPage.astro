---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../utils/jsonld';
interface Props { title: string; description: string; path: string; lead?: string; template?: boolean; noindex?: boolean }
const { title, description, path, lead, template = false, noindex = false } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} noindex={noindex}
  jsonLd={[breadcrumbSchema([{ name: 'Home', url: '/' }, { name: title, url: path }])]}>
  <div class="container-page pt-8">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: title }]} />
    <h1 class="mt-6 max-w-3xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-lg text-ink-soft">{lead}</p>}
    {template && (
      <div class="notice mt-8 max-w-2xl" role="note">
        <p><strong>Template for review.</strong> This page is a starting draft, not legal advice, and it does not make the site compliant with any law by itself. Review it, adapt it to how you actually run the site, and consider having a qualified professional check it before you rely on it.</p>
      </div>
    )}
    <div class="prose-crock mt-10"><slot /></div>
  </div>
</BaseLayout>
