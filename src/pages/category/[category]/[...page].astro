---
import type { GetStaticPaths } from 'astro';
import { ChefHat, Compass, Sparkles, SlidersHorizontal, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Pagination from '../../../components/Pagination.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getAllRecipes, listingPages } from '../../../utils/recipes';
import { categories } from '../../../data/categories';
import { site } from '../../../config/site';
import { breadcrumbSchema } from '../../../utils/jsonld';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getAllRecipes();
  return listingPages(all).flatMap((l) =>
    paginate(l.recipes, {
      params: { category: l.slug },
      props: {
        listing: {
          slug: l.slug,
          name: l.name,
          description: l.description,
          kind: l.kind,
          totalRecipes: l.recipes.length,
        },
      },
      pageSize: site.recipesPerPage,
    }),
  );
}) satisfies GetStaticPaths;

const { page, listing } = Astro.props;
const base = `/category/${listing.slug}/`;
const path = page.currentPage === 1 ? base : `${base}${page.currentPage}/`;
const empty = page.total === 0;
const title = page.currentPage === 1 ? `${listing.name} Recipes` : `${listing.name} Recipes, page ${page.currentPage}`;
---
<BaseLayout
  title={title}
  path={path}
  description={listing.description}
  noindex={empty}
  jsonLd={[breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Recipes', url: '/recipes/' }, { name: listing.name, url: base }])]}
>
  <div class="container-page pt-8 pb-16">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Recipes', href: '/recipes/' }, { name: listing.name }]} />

    <header class="mt-6 max-w-3xl border-b border-line/70 pb-8">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-forest/20 bg-forest/8 px-3 py-0.5 text-xs font-bold uppercase tracking-wider text-forest">
          {listing.kind === 'hub' ? <Compass size={13} aria-hidden="true" /> : <Sparkles size={13} aria-hidden="true" />}
          <span>{listing.kind === 'hub' ? 'Curated Hub' : 'Recipe Category'}</span>
        </span>
        {!empty && (
          <span class="rounded-full bg-cream-deep px-3 py-0.5 text-xs font-semibold text-ink-soft">
            {page.total} {page.total === 1 ? 'kitchen-tested recipe' : 'kitchen-tested recipes'}
          </span>
        )}
      </div>

      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-semibold text-forest">
        {listing.name}
      </h1>
      <p class="mt-3 text-lg leading-relaxed text-ink-soft">
        {listing.description}
      </p>
    </header>

    {empty ? (
      <div class="mt-10 rounded-3xl border border-line bg-paper p-8 sm:p-12 shadow-sm max-w-3xl">
        <div class="flex items-start gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-cream-deep text-forest">
            <ChefHat size={26} class="text-terracotta-deep" aria-hidden="true" />
          </div>
          <div>
            <h2 class="text-xl sm:text-2xl font-display font-semibold text-forest">
              In the Test Kitchen
            </h2>
            <p class="mt-2 text-[1.02rem] leading-relaxed text-ink-soft">
              Our culinary team is currently developing, timing, and thermometer-testing recipes for <strong>{listing.name}</strong>. Each recipe is only published once it has been fully tested by a human cook for flavor, doneness, and food safety.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a class="btn" href="/recipes/">
                Browse All Tested Recipes <ArrowRight size={18} aria-hidden="true" />
              </a>
              <a class="btn btn-outline" href="/category/slow-cooker/">
                Slow Cooker Hub
              </a>
              <a class="btn btn-outline" href="/search/">
                Search Recipes
              </a>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <>
        <!-- Controls & Sorting Bar -->
        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <p class="text-sm font-semibold text-ink-soft">
            Showing {page.data.length} of {page.total} {page.total === 1 ? 'recipe' : 'recipes'}
          </p>

          <div class="flex items-center gap-2">
            <label for="category-sort-select" class="text-xs font-bold uppercase tracking-wider text-forest flex items-center gap-1.5">
              <SlidersHorizontal size={14} aria-hidden="true" />
              <span>Sort:</span>
            </label>
            <select
              id="category-sort-select"
              class="rounded-xl border border-line bg-paper px-3 py-1.5 text-xs font-semibold text-forest shadow-2xs focus-visible:ring-2 focus-visible:ring-forest"
            >
              <option value="default">Default Order</option>
              <option value="time-asc">Quickest Cook</option>
              <option value="title-asc">Title (A–Z)</option>
            </select>
          </div>
        </div>

        <ul id="category-recipe-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {page.data.map((r, i) => (
            <li
              data-recipe-title={r.data.title}
              data-recipe-minutes={r.data.totalMinutes ?? (r.data.prepMinutes + r.data.cookMinutes)}
            >
              <RecipeCard recipe={r} eager={i < 3} />
            </li>
          ))}
        </ul>

        <AdSlot slot="listingMid" />
        <Pagination current={page.currentPage} last={page.lastPage} base={base} />
      </>
    )}

    <!-- Explore More Categories Nav -->
    <nav aria-label="Other categories" class="mt-16 border-t border-line/80 pt-10">
      <div class="flex items-center justify-between">
        <h2 class="text-xl sm:text-2xl font-semibold text-forest">More Categories to Explore</h2>
        <a href="/recipes/" class="link-text font-semibold text-sm">All Recipes &rarr;</a>
      </div>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {categories.filter((c) => c.id !== listing.slug).map((c) => (
          <li>
            <a class="chip py-1.5 px-3.5 text-sm hover:border-forest transition-colors" href={`/category/${c.id}/`}>
              {c.name}
            </a>
          </li>
        ))}
        {listing.slug !== 'slow-cooker' && (
          <li>
            <a class="chip py-1.5 px-3.5 text-sm bg-forest/8 border-forest/20 text-forest font-semibold" href="/category/slow-cooker/">
              Slow Cooker Hub
            </a>
          </li>
        )}
        {listing.slug !== 'dinner-ideas' && (
          <li>
            <a class="chip py-1.5 px-3.5 text-sm bg-forest/8 border-forest/20 text-forest font-semibold" href="/category/dinner-ideas/">
              Dinner Ideas
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const select = document.getElementById('category-sort-select');
    const grid = document.getElementById('category-recipe-grid');
    if (!select || !grid) return;

    const initialItems = Array.from(grid.children);

    select.addEventListener('change', () => {
      const mode = select.value;
      let sorted = [...initialItems];

      if (mode === 'time-asc') {
        sorted.sort((a, b) => {
          const aM = parseInt(a.getAttribute('data-recipe-minutes') || '0', 10);
          const bM = parseInt(b.getAttribute('data-recipe-minutes') || '0', 10);
          return aM - bM;
        });
      } else if (mode === 'title-asc') {
        sorted.sort((a, b) => {
          const aT = (a.getAttribute('data-recipe-title') || '').toLowerCase();
          const bT = (b.getAttribute('data-recipe-title') || '').toLowerCase();
          return aT.localeCompare(bT);
        });
      }

      grid.replaceChildren(...sorted);
    });
  })();
</script>
