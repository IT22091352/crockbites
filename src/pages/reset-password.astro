---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveUserSession } from '../lib/community-server';

const { csrfToken } = await resolveUserSession(Astro.cookies, Astro.locals, Astro.url.protocol);
const token = Astro.url.searchParams.get('token')?.trim() || '';
---

<BaseLayout
  title="Reset Your Password"
  path="/reset-password/"
  description="Set a new password for your CrockBites community account."
  noindex
>
  <div class="container-page py-12">
    <div class="mx-auto max-w-md rounded-3xl border border-line bg-paper p-6 shadow-[var(--shadow-card)] sm:p-10">
      <div class="text-center">
        <div class="mx-auto flex size-14 items-center justify-center rounded-2xl bg-brand-100 text-forest text-2xl">
          🔒
        </div>
        <p class="mt-4 text-xs font-bold uppercase tracking-widest text-terracotta-deep">Security</p>
        <h1 class="mt-1 text-2xl sm:text-3xl text-forest">Reset Password</h1>
      </div>

      {token ? (
        <form id="reset-pw-form" class="mt-6 space-y-4" novalidate>
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <p class="text-sm text-ink-soft">
            Choose a strong new password for your CrockBites account.
          </p>

          <div>
            <div class="mb-1 flex items-center justify-between">
              <label for="new-pw-input" class="text-sm font-semibold text-forest">New Password</label>
              <button type="button" id="toggle-new-pw" class="link-text text-xs font-semibold">Show</button>
            </div>
            <input
              id="new-pw-input"
              name="newPassword"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              class="field w-full"
            />
            <p class="mt-1 text-xs text-ink-soft/80">At least 8 characters containing letters and numbers.</p>
          </div>

          <div>
            <label for="confirm-pw-input" class="mb-1 block text-sm font-semibold text-forest">Confirm New Password</label>
            <input
              id="confirm-pw-input"
              name="confirmPassword"
              type="password"
              required
              minlength="8"
              autocomplete="new-password"
              placeholder="Repeat your new password"
              class="field w-full"
            />
          </div>

          <div id="reset-pw-feedback" class="hidden rounded-xl border p-3.5 text-sm font-medium" role="alert" aria-live="polite"></div>

          <button type="submit" id="reset-pw-submit" class="btn w-full justify-center py-3 text-base font-semibold">
            Update Password & Sign In
          </button>
        </form>
      ) : (
        <div class="mt-6 text-center">
          <p class="text-sm text-ink-soft">
            No password reset token was provided. If you requested a reset link, please open the full link from your email inbox.
          </p>
          <div class="mt-6 flex flex-col gap-3">
            <a href="/forgot-password/" class="btn justify-center py-2.5 text-sm">
              Request a New Reset Link
            </a>
            <a href="/login/" class="link-text text-sm font-semibold text-forest">
              Back to Sign In →
            </a>
          </div>
        </div>
      )}

      <!-- Post-submission result state -->
      <div id="reset-success-box" class="hidden mt-6 text-center">
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-5 text-sm font-medium text-emerald-900">
          <div class="text-2xl mb-1">✓</div>
          <strong class="block text-base font-semibold">Password Successfully Reset!</strong>
          <p class="mt-1 text-xs text-emerald-800">
            Your password has been updated and all previous sessions have been securely signed out.
          </p>
        </div>
        <div class="mt-6">
          <a href="/login/" class="btn w-full justify-center py-3 text-base font-semibold">
            Sign In with New Password
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('reset-pw-form') as HTMLFormElement | null;
  const newPwInput = document.getElementById('new-pw-input') as HTMLInputElement | null;
  const confirmPwInput = document.getElementById('confirm-pw-input') as HTMLInputElement | null;
  const toggleBtn = document.getElementById('toggle-new-pw') as HTMLButtonElement | null;
  const feedback = document.getElementById('reset-pw-feedback');
  const submitBtn = document.getElementById('reset-pw-submit') as HTMLButtonElement | null;
  const successBox = document.getElementById('reset-success-box');

  toggleBtn?.addEventListener('click', () => {
    if (!newPwInput) return;
    const isHidden = newPwInput.type === 'password';
    newPwInput.type = isHidden ? 'text' : 'password';
    toggleBtn.textContent = isHidden ? 'Hide' : 'Show';
  });

  function showMessage(msg: string, isError = true) {
    if (!feedback) return;
    feedback.textContent = msg;
    feedback.className = isError
      ? 'rounded-xl border border-red-300 bg-red-50 p-3.5 text-sm font-medium text-red-800'
      : 'rounded-xl border border-emerald-300 bg-emerald-50 p-3.5 text-sm font-medium text-emerald-900';
    feedback.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!newPwInput || !confirmPwInput || !submitBtn) return;

    const newPassword = newPwInput.value;
    const confirmPassword = confirmPwInput.value;
    const token = (form.querySelector('input[name="token"]') as HTMLInputElement)?.value || '';
    const csrfToken = (form.querySelector('input[name="csrfToken"]') as HTMLInputElement)?.value || '';

    if (newPassword.length < 8) {
      showMessage('Password must be at least 8 characters long.');
      newPwInput.focus();
      return;
    }

    if (newPassword !== confirmPassword) {
      showMessage('Passwords do not match. Please verify both fields.');
      confirmPwInput.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Updating password...';
    feedback?.classList.add('hidden');

    try {
      const res = await fetch('/api/auth/password-reset/', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify({
          action: 'confirm',
          token,
          newPassword,
          csrfToken,
        }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        form.classList.add('hidden');
        if (successBox) {
          successBox.classList.remove('hidden');
        }
      } else {
        showMessage(data.error || 'Password reset failed. This link may have expired or already been used.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Update Password & Sign In';
      }
    } catch {
      showMessage('A network error occurred while updating your password. Please try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Update Password & Sign In';
    }
  });
</script>

