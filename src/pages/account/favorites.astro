---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { getPublishedRecipesMap, resolveUserSession } from '../../lib/community-server';
import { listUserFavorites } from '../../lib/community';
import type { Recipe } from '../../utils/recipes';

const { db, user, csrfToken } = await resolveUserSession(
  Astro.cookies,
  Astro.locals,
  Astro.url.protocol,
);

if (!user || !db) {
  return Astro.redirect(`/login/?returnTo=${encodeURIComponent('/account/favorites/')}`);
}

const [{ bySlug }, favorites] = await Promise.all([
  getPublishedRecipesMap(),
  listUserFavorites(db, user.id),
]);

const savedItems = favorites
  .map((f) => ({
    recipe: bySlug.get(f.recipeSlug),
    recipeSlug: f.recipeSlug,
    createdAt: f.createdAt,
  }))
  .filter((item): item is { recipe: Recipe; recipeSlug: string; createdAt: string } => Boolean(item.recipe));
---

<BaseLayout
  title="My Saved Recipes"
  path="/account/favorites/"
  description="Your personal collection of bookmarked slow-cooker recipes on CrockBites."
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-4 py-10" data-csrf-token={csrfToken}>
    <AccountNav user={user} activeTab="favorites" csrfToken={csrfToken} />

    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">
          Saved Recipes ({savedItems.length})
        </h2>
        <p class="mt-1 text-sm text-stone-600">
          All the weeknight dinners and slow-cooker classics you have bookmarked for later.
        </p>
      </div>
      <a
        href="/recipes/"
        class="inline-flex items-center gap-1.5 rounded-xl bg-brand-800 px-4 py-2 text-xs font-semibold text-white transition hover:bg-brand-900"
      >
        + Find More Recipes
      </a>
    </div>

    {savedItems.length > 0 ? (
      <div id="favorites-grid" class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {savedItems.map(({ recipe, recipeSlug, createdAt }) => (
          <div class="flex flex-col gap-2" data-saved-item={recipeSlug}>
            <RecipeCard recipe={recipe} />
            <div class="flex items-center justify-between rounded-xl border border-stone-200/80 bg-white px-3.5 py-2 text-xs text-stone-500">
              <span>
                Saved {new Date(createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </span>
              <button
                type="button"
                data-remove-favorite={recipeSlug}
                class="font-semibold text-rose-700 hover:text-rose-900 hover:underline"
              >
                Remove
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white/70 p-10 text-center">
        <p class="font-serif text-xl font-semibold text-stone-800">Your saved recipes box is empty</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-stone-600">
          When you find a slow-cooker meal you want to make again, click the heart icon on any recipe card or detail page to save it here.
        </p>
        <a
          href="/recipes/"
          class="mt-5 inline-flex items-center rounded-xl bg-brand-800 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-900"
        >
          Browse All Recipes
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    (() => {
      const container = document.querySelector('[data-csrf-token]');
      const csrfToken = container ? container.getAttribute('data-csrf-token') || '' : '';

      document.querySelectorAll('[data-remove-favorite]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-remove-favorite');
          if (!slug) return;
          btn.disabled = true;

          try {
            const res = await fetch('/api/community/favorites/', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify({ recipeSlug: slug, action: 'remove', csrfToken }),
            });
            if (res.ok) {
              const cardWrap = document.querySelector(`[data-saved-item="${slug}"]`);
              if (cardWrap) cardWrap.remove();
              const remaining = document.querySelectorAll('[data-saved-item]');
              if (remaining.length === 0) {
                window.location.reload();
              }
            } else {
              btn.disabled = false;
            }
          } catch {
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>
