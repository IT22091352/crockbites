---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import AccountNav from '../../components/AccountNav.astro';
import { getPublishedRecipesMap, resolveUserSession } from '../../lib/community-server';
import { listUserReviews } from '../../lib/community';

function unescapeHtmlEntities(str: string): string {
  return String(str ?? '')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&gt;/g, '>')
    .replace(/&lt;/g, '<')
    .replace(/&amp;/g, '&');
}

const { db, user, csrfToken } = await resolveUserSession(
  Astro.cookies,
  Astro.locals,
  Astro.url.protocol,
);

if (!user || !db) {
  return Astro.redirect(`/login/?returnTo=${encodeURIComponent('/account/reviews/')}`);
}

const [{ bySlug }, reviews] = await Promise.all([
  getPublishedRecipesMap(),
  listUserReviews(db, user.id),
]);
---

<BaseLayout
  title="My Recipe Reviews"
  path="/account/reviews/"
  description="Manage your recipe ratings and community reviews on CrockBites."
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-4 py-10" data-csrf-token={csrfToken}>
    <AccountNav user={user} activeTab="reviews" csrfToken={csrfToken} />

    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-stone-900">
          My Recipe Reviews (<span id="account-reviews-count">{reviews.length}</span>)
        </h2>
        <p class="mt-1 text-sm text-stone-600">
          Your reviews are published immediately on recipe pages. You can edit or delete your reviews below at any time.
        </p>
      </div>
    </div>

    <div
      id="account-reviews-banner"
      hidden
      role="status"
      aria-live="polite"
      class="mt-4 rounded-xl border px-4 py-3 text-xs font-semibold"
    ></div>

    {reviews.length > 0 ? (
      <div class="mt-6 space-y-4">
        {reviews.map((rev) => {
          const recipe = bySlug.get(rev.recipeSlug);
          const recipeTitle = recipe ? recipe.data.title : rev.recipeSlug;
          const statusStyles = 'bg-emerald-50 text-emerald-800 border-emerald-200';
          const statusLabel = 'Published';

          return (
            <article
              class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-xs"
              data-user-review-id={rev.id}
            >
              <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
                <div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <a
                      href={`/recipe/${rev.recipeSlug}/#recipe-reviews`}
                      class="font-serif text-lg font-semibold text-stone-900 hover:text-brand-800 hover:underline"
                    >
                      {recipeTitle}
                    </a>
                    <span class={`rounded-full border px-2.5 py-0.5 text-xs font-semibold ${statusStyles}`}>
                      {statusLabel}
                    </span>
                  </div>

                  <div class="mt-1.5 flex items-center gap-2 text-amber-500" aria-label={`${rev.rating} out of 5 stars`}>
                    <span class="text-sm tracking-tight">
                      {'★'.repeat(rev.rating)}{'☆'.repeat(5 - rev.rating)}
                    </span>
                    <span class="text-xs font-semibold text-stone-700">{rev.rating}/5</span>
                    <span class="text-xs text-stone-400">•</span>
                    <span class="text-xs text-stone-500">
                      {new Date(rev.createdAt).toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-3 text-xs">
                  <button
                    type="button"
                    data-edit-review-toggle={rev.id}
                    class="rounded-lg border border-stone-200 bg-stone-50 px-3 py-1.5 font-semibold text-stone-700 hover:bg-stone-100"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    data-delete-review={rev.id}
                    class="rounded-lg border border-rose-200 bg-rose-50/70 px-3 py-1.5 font-semibold text-rose-700 hover:bg-rose-100"
                  >
                    Delete
                  </button>
                </div>
              </div>

              <h3 class="mt-3 text-sm font-semibold text-stone-900" set:html={rev.title} />
              <p class="mt-1 whitespace-pre-line text-sm text-stone-700" set:html={rev.comment} />

              <!-- Inline Edit Form -->
              <form
                data-edit-review-form={rev.id}
                class="mt-5 hidden space-y-4 border-t border-stone-100 pt-4"
              >
                <div class="grid gap-4 sm:grid-cols-3">
                  <div>
                    <label class="block text-xs font-semibold text-stone-800">Star Rating</label>
                    <select
                      name="rating"
                      class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3 py-2 text-sm text-stone-900"
                    >
                      {[5, 4, 3, 2, 1].map((star) => (
                        <option value={star} selected={rev.rating === star}>
                          {star} {star === 1 ? 'Star' : 'Stars'}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div class="sm:col-span-2">
                    <label class="block text-xs font-semibold text-stone-800">Review Title</label>
                    <input
                      type="text"
                      name="title"
                      required
                      minlength="3"
                      maxlength="120"
                      value={unescapeHtmlEntities(rev.title)}
                      data-orig-title={unescapeHtmlEntities(rev.title)}
                      class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-stone-800">Review Comment</label>
                  <textarea
                    name="comment"
                    rows="3"
                    required
                    minlength="10"
                    maxlength="2000"
                    data-orig-comment={unescapeHtmlEntities(rev.comment)}
                    class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900"
                  >{unescapeHtmlEntities(rev.comment)}</textarea>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3">
                  <p class="text-xs text-stone-500">
                    Changes update your public review immediately.
                  </p>
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      data-cancel-edit-review={rev.id}
                      data-orig-rating={rev.rating}
                      class="rounded-xl border border-stone-300 bg-white px-4 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-50"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      class="rounded-xl bg-brand-800 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-900"
                    >
                      Save Changes
                    </button>
                  </div>
                </div>
              </form>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white/70 p-10 text-center">
        <p class="font-serif text-lg font-semibold text-stone-800">You haven't reviewed any recipes yet</p>
        <p class="mt-1 text-sm text-stone-600">
          Cooked a CrockBites recipe recently? Visit any recipe page and leave a star rating and review to help fellow home cooks.
        </p>
        <a
          href="/recipes/"
          class="mt-4 inline-flex items-center rounded-xl bg-brand-800 px-4 py-2 text-xs font-semibold text-white transition hover:bg-brand-900"
        >
          Find a Recipe to Review
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    (() => {
      const container = document.querySelector('[data-csrf-token]');
      const csrfToken = container ? container.getAttribute('data-csrf-token') || '' : '';
      const bannerEl = document.getElementById('account-reviews-banner');
      const countEl = document.getElementById('account-reviews-count');

      function showBanner(msg, ok) {
        if (!bannerEl) return;
        bannerEl.hidden = false;
        bannerEl.textContent = msg;
        bannerEl.className = ok
          ? 'mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-semibold text-emerald-800'
          : 'mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-xs font-semibold text-rose-800';
      }

      document.querySelectorAll('[data-edit-review-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-edit-review-toggle');
          const form = document.querySelector(`[data-edit-review-form="${id}"]`);
          if (form) form.classList.toggle('hidden');
        });
      });

      document.querySelectorAll('[data-cancel-edit-review]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-cancel-edit-review');
          const origRating = btn.getAttribute('data-orig-rating');
          const form = document.querySelector(`[data-edit-review-form="${id}"]`);
          if (!form) return;
          const ratingSelect = form.querySelector('select[name="rating"]');
          const titleInput = form.querySelector('input[name="title"]');
          const commentInput = form.querySelector('textarea[name="comment"]');
          if (ratingSelect && origRating) ratingSelect.value = origRating;
          if (titleInput) titleInput.value = titleInput.getAttribute('data-orig-title') || '';
          if (commentInput) commentInput.value = commentInput.getAttribute('data-orig-comment') || '';
          form.classList.add('hidden');
        });
      });

      document.querySelectorAll('[data-edit-review-form]').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const id = form.getAttribute('data-edit-review-form');
          if (!id) return;
          const formData = new FormData(form);
          const payload = {
            rating: Number(formData.get('rating')),
            title: formData.get('title'),
            comment: formData.get('comment'),
            csrfToken,
          };

          const res = await fetch(`/api/community/reviews/${encodeURIComponent(id)}/`, {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              'x-csrf-token': csrfToken,
            },
            body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            window.location.reload();
          } else {
            showBanner(data.error || 'Failed to update review.', false);
          }
        });
      });

      document.querySelectorAll('[data-delete-review]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-delete-review');
          if (!id) return;
          if (!window.confirm('Are you sure you want to delete your review? This action cannot be undone.')) return;
          btn.disabled = true;

          try {
            const res = await fetch(`/api/community/reviews/${encodeURIComponent(id)}/`, {
              method: 'DELETE',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify({ csrfToken }),
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok) {
              const card = document.querySelector(`[data-user-review-id="${id}"]`);
              if (card) card.remove();
              const remaining = document.querySelectorAll('[data-user-review-id]').length;
              if (countEl) countEl.textContent = String(remaining);
              showBanner(data.message || 'Your review has been deleted.', true);
              if (remaining === 0) {
                window.location.reload();
              }
            } else {
              showBanner(data.error || 'Could not delete review.', false);
              btn.disabled = false;
            }
          } catch {
            showBanner('Network error while deleting review.', false);
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>
