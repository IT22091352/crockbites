---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccountNav from '../../../components/AccountNav.astro';
import { resolveUserSession } from '../../../lib/community-server';
import { listUserCollections } from '../../../lib/community';

const { db, user, csrfToken } = await resolveUserSession(
  Astro.cookies,
  Astro.locals,
  Astro.url.protocol,
);

if (!user || !db) {
  return Astro.redirect(`/login/?returnTo=${encodeURIComponent('/account/collections/')}`);
}

const collections = await listUserCollections(db, user.id);
---

<BaseLayout
  title="My Recipe Collections"
  path="/account/collections/"
  description="Organize your favorite CrockBites slow-cooker recipes into custom folders and meal-prep collections."
  noindex={true}
>
  <div class="mx-auto max-w-6xl px-4 py-10" data-csrf-token={csrfToken}>
    <AccountNav user={user} activeTab="collections" csrfToken={csrfToken} />

    <div class="grid gap-8 lg:grid-cols-3">
      <!-- Create Collection Panel -->
      <div class="lg:col-span-1">
        <section class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-xs">
          <h2 class="font-serif text-xl font-semibold text-stone-900">Create Collection</h2>
          <p class="mt-1 text-xs text-stone-600">
            Group recipes by weeknight meal prep, holiday menus, high-protein favorites, or family staples.
          </p>

          <div
            id="collection-create-banner"
            role="status"
            class="mt-3 hidden rounded-xl border px-3.5 py-2.5 text-xs font-medium"
          ></div>

          <form id="create-collection-form" class="mt-4 space-y-4">
            <div>
              <label for="collection-name" class="block text-xs font-semibold text-stone-800">
                Collection Name
              </label>
              <input
                id="collection-name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="80"
                placeholder="e.g., Sunday Meal Prep"
                class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900 focus:border-brand-600 focus:outline-hidden"
              />
            </div>

            <div>
              <label for="collection-description" class="block text-xs font-semibold text-stone-800">
                Description <span class="font-normal text-stone-500">(optional)</span>
              </label>
              <textarea
                id="collection-description"
                name="description"
                rows="3"
                maxlength="300"
                placeholder="Notes about this collection..."
                class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900 focus:border-brand-600 focus:outline-hidden"
              ></textarea>
            </div>

            <label class="flex items-start gap-2.5 text-xs text-stone-700 cursor-pointer">
              <input
                type="checkbox"
                name="isPublic"
                class="mt-0.5 h-4 w-4 rounded border-stone-300 text-brand-700 focus:ring-brand-500"
              />
              <span>
                <strong class="font-semibold text-stone-800">Public Collection</strong>
                <span class="block text-stone-500">Allow others with the link to view this collection. Leave unchecked to keep it private.</span>
              </span>
            </label>

            <button
              type="submit"
              id="create-collection-btn"
              class="w-full rounded-xl bg-brand-800 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-900 disabled:opacity-60"
            >
              + Create Collection
            </button>
          </form>
        </section>
      </div>

      <!-- Existing Collections List -->
      <div class="lg:col-span-2">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-2xl font-semibold text-stone-900">
            Your Collections ({collections.length})
          </h2>
        </div>

        {collections.length > 0 ? (
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {collections.map((col) => (
              <article
                class="flex flex-col justify-between rounded-2xl border border-stone-200/80 bg-white p-5 shadow-xs transition hover:border-brand-300"
                data-collection-card={col.id}
              >
                <div>
                  <div class="flex items-start justify-between gap-2">
                    <a
                      href={`/account/collections/${col.id}/`}
                      class="font-serif text-lg font-semibold text-stone-900 hover:text-brand-800 hover:underline"
                      set:html={col.name}
                    />
                    <span
                      class={`shrink-0 rounded-full px-2.5 py-0.5 text-[11px] font-semibold ${
                        col.isPublic
                          ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                          : 'bg-stone-100 text-stone-600 border border-stone-200'
                      }`}
                    >
                      {col.isPublic ? 'Public' : 'Private'}
                    </span>
                  </div>

                  {col.description ? (
                    <p class="mt-2 text-xs text-stone-600 line-clamp-2" set:html={col.description} />
                  ) : (
                    <p class="mt-2 text-xs italic text-stone-400">No description</p>
                  )}
                </div>

                <div class="mt-5 flex items-center justify-between border-t border-stone-100 pt-3 text-xs">
                  <a
                    href={`/account/collections/${col.id}/`}
                    class="font-semibold text-brand-800 hover:underline"
                  >
                    {col.recipeCount} {col.recipeCount === 1 ? 'recipe' : 'recipes'} →
                  </a>
                  <button
                    type="button"
                    data-delete-collection={col.id}
                    class="font-semibold text-rose-700 hover:text-rose-900 hover:underline"
                  >
                    Delete
                  </button>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mt-5 rounded-2xl border border-dashed border-stone-300 bg-white/70 p-10 text-center">
            <p class="font-serif text-lg font-semibold text-stone-800">No collections yet</p>
            <p class="mt-1 text-sm text-stone-600">
              Create your first collection on the left, then add any published recipe from its detail page.
            </p>
          </div>
        )}
      </div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const container = document.querySelector('[data-csrf-token]');
      const csrfToken = container ? container.getAttribute('data-csrf-token') || '' : '';

      const createForm = document.getElementById('create-collection-form');
      const createBanner = document.getElementById('collection-create-banner');
      const createBtn = document.getElementById('create-collection-btn');

      if (createForm) {
        createForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(createForm);
          const payload = {
            name: formData.get('name'),
            description: formData.get('description'),
            isPublic: formData.get('isPublic') === 'on',
            csrfToken,
          };

          if (createBtn) createBtn.disabled = true;
          try {
            const res = await fetch('/api/community/collections/', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify(payload),
            });
            const data = await res.json();
            if (!res.ok) {
              if (createBanner) {
                createBanner.textContent = data.error || 'Could not create collection.';
                createBanner.className = 'mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-xs font-medium text-rose-900';
              }
            } else {
              window.location.reload();
            }
          } catch {
            if (createBanner) {
              createBanner.textContent = 'Network error creating collection.';
              createBanner.className = 'mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3.5 py-2.5 text-xs font-medium text-rose-900';
            }
          } finally {
            if (createBtn) createBtn.disabled = false;
          }
        });
      }

      document.querySelectorAll('[data-delete-collection]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-delete-collection');
          if (!id) return;
          if (!window.confirm('Delete this collection? The recipes themselves will remain on CrockBites.')) return;

          btn.disabled = true;
          try {
            const res = await fetch(`/api/community/collections/${encodeURIComponent(id)}/`, {
              method: 'DELETE',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify({ csrfToken }),
            });
            if (res.ok) {
              window.location.reload();
            } else {
              btn.disabled = false;
            }
          } catch {
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>
