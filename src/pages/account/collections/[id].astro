---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import AccountNav from '../../../components/AccountNav.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import { getPublishedRecipesMap, resolveUserSession } from '../../../lib/community-server';
import { getCollectionDetails } from '../../../lib/community';
import type { Recipe } from '../../../utils/recipes';

const collectionId = Astro.params.id ?? '';
const { db, user, csrfToken } = await resolveUserSession(
  Astro.cookies,
  Astro.locals,
  Astro.url.protocol,
);

if (!db) {
  return Astro.redirect('/login/');
}

const collection = await getCollectionDetails(db, collectionId, user?.id ?? null);

if (!collection) {
  if (!user) {
    return Astro.redirect(`/login/?returnTo=${encodeURIComponent(Astro.url.pathname)}`);
  }
  return new Response('Collection not found or private.', { status: 404 });
}

const isOwner = Boolean(user && collection.userId === user.id);
const { bySlug } = await getPublishedRecipesMap();

const collectionRecipes = collection.recipeSlugs
  .map((slug) => ({
    slug,
    recipe: bySlug.get(slug),
  }))
  .filter((item): item is { slug: string; recipe: Recipe } => Boolean(item.recipe));
---

<BaseLayout
  title={`${collection.name} — Recipe Collection`}
  path={`/account/collections/${collection.id}/`}
  description={collection.description || `A curated CrockBites slow-cooker recipe collection by ${collection.ownerDisplayName}.`}
  noindex={!collection.isPublic}
>
  <div
    class="mx-auto max-w-6xl px-4 py-10"
    data-csrf-token={csrfToken}
    data-collection-id={collection.id}
  >
    {user && <AccountNav user={user} activeTab="collections" csrfToken={csrfToken} />}

    <div class="mb-6">
      <a
        href={user ? '/account/collections/' : '/recipes/'}
        class="inline-flex items-center gap-1 text-xs font-semibold text-brand-800 hover:underline"
      >
        ← {user ? 'Back to My Collections' : 'Browse All Recipes'}
      </a>
    </div>

    <div class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-xs sm:p-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div>
          <div class="flex flex-wrap items-center gap-2.5">
            <h1 class="font-serif text-2xl font-bold text-stone-900 sm:text-3xl" set:html={collection.name} />
            <span
              class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${
                collection.isPublic
                  ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                  : 'bg-stone-100 text-stone-600 border border-stone-200'
              }`}
            >
              {collection.isPublic ? 'Public Collection' : 'Private Collection'}
            </span>
          </div>

          {collection.description && (
            <p class="mt-2 max-w-2xl text-sm text-stone-600" set:html={collection.description} />
          )}

          <p class="mt-2 text-xs text-stone-500">
            Curated by <strong>{collection.ownerDisplayName}</strong> • {collectionRecipes.length}{' '}
            {collectionRecipes.length === 1 ? 'recipe' : 'recipes'}
          </p>
        </div>

        {isOwner && (
          <button
            type="button"
            id="toggle-edit-collection-btn"
            class="inline-flex items-center rounded-xl border border-stone-300 bg-stone-50 px-3.5 py-2 text-xs font-semibold text-stone-800 transition hover:bg-stone-100"
          >
            Edit Collection Details
          </button>
        )}
      </div>

      {isOwner && (
        <form
          id="edit-collection-form"
          class="mt-6 hidden space-y-4 border-t border-stone-100 pt-6"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="edit-col-name" class="block text-xs font-semibold text-stone-800">
                Collection Name
              </label>
              <input
                id="edit-col-name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="80"
                value={collection.name}
                class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900"
              />
            </div>

            <div class="flex items-end pb-1">
              <label class="flex items-center gap-2 text-xs font-semibold text-stone-800 cursor-pointer">
                <input
                  type="checkbox"
                  name="isPublic"
                  checked={collection.isPublic}
                  class="h-4 w-4 rounded border-stone-300 text-brand-700"
                />
                Make this collection public
              </label>
            </div>
          </div>

          <div>
            <label for="edit-col-desc" class="block text-xs font-semibold text-stone-800">
              Description
            </label>
            <textarea
              id="edit-col-desc"
              name="description"
              rows="2"
              maxlength="300"
              class="mt-1 w-full rounded-xl border border-stone-300 bg-white px-3.5 py-2 text-sm text-stone-900"
            >{collection.description}</textarea>
          </div>

          <div class="flex justify-end gap-2">
            <button
              type="submit"
              class="rounded-xl bg-brand-800 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-900"
            >
              Save Changes
            </button>
          </div>
        </form>
      )}
    </div>

    {collectionRecipes.length > 0 ? (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {collectionRecipes.map(({ slug, recipe }) => (
          <div class="flex flex-col gap-2" data-collection-recipe={slug}>
            <RecipeCard recipe={recipe} />
            {isOwner && (
              <div class="flex items-center justify-end rounded-xl border border-stone-200/80 bg-white px-3.5 py-2 text-xs">
                <button
                  type="button"
                  data-remove-from-collection={slug}
                  class="font-semibold text-rose-700 hover:text-rose-900 hover:underline"
                >
                  Remove from collection
                </button>
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white/70 p-10 text-center">
        <p class="font-serif text-lg font-semibold text-stone-800">This collection has no recipes yet</p>
        <p class="mt-1 text-sm text-stone-600">
          Open any published recipe page and click "Add to Collection" to save it here.
        </p>
        <a
          href="/recipes/"
          class="mt-4 inline-flex items-center rounded-xl bg-brand-800 px-4 py-2 text-xs font-semibold text-white transition hover:bg-brand-900"
        >
          Browse Recipes
        </a>
      </div>
    )}
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-collection-id]');
      if (!root) return;
      const csrfToken = root.getAttribute('data-csrf-token') || '';
      const collectionId = root.getAttribute('data-collection-id') || '';

      const toggleBtn = document.getElementById('toggle-edit-collection-btn');
      const editForm = document.getElementById('edit-collection-form');
      if (toggleBtn && editForm) {
        toggleBtn.addEventListener('click', () => {
          editForm.classList.toggle('hidden');
        });

        editForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const formData = new FormData(editForm);
          const payload = {
            action: 'update',
            name: formData.get('name'),
            description: formData.get('description'),
            isPublic: formData.get('isPublic') === 'on',
            csrfToken,
          };

          const res = await fetch(`/api/community/collections/${encodeURIComponent(collectionId)}/`, {
            method: 'PATCH',
            headers: {
              'content-type': 'application/json',
              'x-csrf-token': csrfToken,
            },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            window.location.reload();
          }
        });
      }

      document.querySelectorAll('[data-remove-from-collection]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-remove-from-collection');
          if (!slug) return;
          btn.disabled = true;

          try {
            const res = await fetch(`/api/community/collections/${encodeURIComponent(collectionId)}/`, {
              method: 'PATCH',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': csrfToken,
              },
              body: JSON.stringify({
                action: 'removeRecipe',
                recipeSlug: slug,
                csrfToken,
              }),
            });
            if (res.ok) {
              const wrap = document.querySelector(`[data-collection-recipe="${slug}"]`);
              if (wrap) wrap.remove();
            } else {
              btn.disabled = false;
            }
          } catch {
            btn.disabled = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>
