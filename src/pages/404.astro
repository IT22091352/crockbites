---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
---
<BaseLayout title="Page not found" path="/404/" description="That page could not be found." noindex>
  <div class="container-narrow py-20 text-center">
    <p class="font-display text-6xl font-semibold text-terracotta-deep">404</p>
    <h1 class="mt-4">We couldn’t find that page</h1>
    <p class="mt-4 text-lg text-ink-soft">The link may be old or mistyped. Try searching, or head to one of these.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn" href="/search/">Search recipes</a>
      <a class="btn btn-outline" href="/recipes/">All recipes</a>
      <a class="btn btn-outline" href="/">Home</a>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-2">
      {categories.map((c) => <li><a class="chip" href={`/category/${c.id}/`}>{c.name}</a></li>)}
    </ul>
  </div>
</BaseLayout>
