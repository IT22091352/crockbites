---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeDetail from '../../components/RecipeDetail.astro';
import { getAllRecipes, relatedRecipes, categoryById, isIndexable, recipeSlug, recipeUrl } from '../../utils/recipes';
import { recipeSchema, breadcrumbSchema } from '../../utils/jsonld';

export const getStaticPaths = (async () => {
  const all = await getAllRecipes();
  return all.map((recipe) => ({ params: { slug: recipeSlug(recipe) }, props: { recipe, related: relatedRecipes(all, recipe, 3) } }));
}) satisfies GetStaticPaths;

const { recipe, related } = Astro.props;
const { Content } = await render(recipe);
const d = recipe.data;
const cat = categoryById(d.category)!;

const rawBody = (recipe.body ?? '').trim();
const hasCustomIntro = Boolean(rawBody && rawBody !== (d.description ?? '').trim());

// Social/structured-data image: a 1200px-wide, absolute URL.
let ogSrc: string;
if (typeof d.image === 'string' && (d.image.startsWith('http://') || d.image.startsWith('https://'))) {
  ogSrc = d.image;
} else {
  const og = await getImage({ src: d.image as any, width: 1200 });
  ogSrc = og.src;
}

const path = recipeUrl(recipe);
const jsonLd = [
  recipeSchema(recipe, new URL(ogSrc, Astro.site).href, cat.name),
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Recipes', url: '/recipes/' }, { name: cat.name, url: `/category/${cat.id}/` }, { name: d.title, url: path }]),
];
---
<BaseLayout title={d.title} description={d.description} path={path} image={ogSrc} imageAlt={d.imageAlt} type="article"
  noindex={!isIndexable(recipe)} publishedTime={d.pubDate.toISOString()} modifiedTime={(d.updatedDate ?? d.pubDate).toISOString()} jsonLd={jsonLd}>
  <RecipeDetail recipe={recipe} related={related}>
    {hasCustomIntro && <Content slot="intro" />}
  </RecipeDetail>
</BaseLayout>
