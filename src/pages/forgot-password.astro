---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveUserSession } from '../lib/community-server';

const { user, csrfToken } = await resolveUserSession(Astro.cookies, Astro.locals, Astro.url.protocol);

if (user) {
  return Astro.redirect('/account/profile/');
}
---

<BaseLayout
  title="Forgot Password"
  path="/forgot-password/"
  description="Request a password reset link for your CrockBites kitchen account."
  noindex
>
  <div class="container-page py-12">
    <div class="mx-auto max-w-md rounded-3xl border border-line bg-paper p-6 shadow-[var(--shadow-card)] sm:p-10">
      <p class="text-xs font-bold uppercase tracking-widest text-terracotta-deep">Account Recovery</p>
      <h1 class="mt-2 text-3xl text-forest">Forgot Password?</h1>
      <p class="mt-2 text-sm text-ink-soft">
        Enter the email address for your CrockBites account and we'll send you a secure link to reset your password.
      </p>

      <form id="forgot-pw-form" class="mt-6 space-y-4" novalidate>
        <input type="hidden" name="csrfToken" value={csrfToken} />

        <div>
          <label for="reset-email" class="mb-1 block text-sm font-semibold text-forest">Account Email</label>
          <input
            id="reset-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="field w-full"
          />
        </div>

        <div id="forgot-pw-feedback" class="hidden rounded-xl border p-3.5 text-sm font-medium" role="alert" aria-live="polite"></div>

        <button type="submit" id="forgot-pw-submit" class="btn w-full justify-center py-3 text-base font-semibold">
          Send Password Reset Link
        </button>
      </form>

      <p class="mt-6 border-t border-line pt-5 text-center text-sm text-ink-soft">
        Remembered your password?{' '}
        <a href="/login/" class="link-text font-semibold text-forest">
          Back to Sign In
        </a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('forgot-pw-form') as HTMLFormElement;
  const emailInput = document.getElementById('reset-email') as HTMLInputElement;
  const feedback = document.getElementById('forgot-pw-feedback')!;
  const submitBtn = document.getElementById('forgot-pw-submit') as HTMLButtonElement;

  function showMessage(msg: string, isError = true) {
    feedback.textContent = msg;
    feedback.className = isError
      ? 'rounded-xl border border-red-300 bg-red-50 p-3.5 text-sm font-medium text-red-800'
      : 'rounded-xl border border-emerald-300 bg-emerald-50 p-3.5 text-sm font-medium text-emerald-900';
    feedback.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    if (!email || !email.includes('@')) {
      showMessage('Please enter a valid email address.');
      emailInput.focus();
      return;
    }

    const csrfToken = (form.querySelector('input[name="csrfToken"]') as HTMLInputElement)?.value || '';

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending link...';
    feedback.classList.add('hidden');

    try {
      const res = await fetch('/api/auth/password-reset/', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify({
          action: 'request',
          email,
          csrfToken,
        }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        showMessage(
          'If an account matches that email address, password reset instructions have been sent to your inbox. Please check your spam folder if it doesn’t appear in a few moments.',
          false,
        );
        form.reset();
        submitBtn.textContent = 'Link Sent';
      } else {
        showMessage(data.error || 'Unable to request password reset. Please try again later.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Password Reset Link';
      }
    } catch {
      showMessage('A network error occurred. Please check your connection and try again.');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Password Reset Link';
    }
  });
</script>

