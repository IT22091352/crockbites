---
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb, getD1BindingStatus } from '../../../lib/db';
import { listAdminReviews } from '../../../lib/community';
import { decodeHtmlEntities } from '../../../lib/user-auth';
import {
  MessageSquare,
  Star,
  Search,
  ListFilter,
  RotateCcw,
  ExternalLink,
  Trash,
  Database,
  Calendar,
  User,
  CircleCheck,
} from '@lucide/astro';

const recipeFilter = Astro.url.searchParams.get('recipe') ?? '';
const ratingFilter = Astro.url.searchParams.get('rating') ?? '';
const queryFilter = Astro.url.searchParams.get('q') ?? '';
const pageParam = Math.max(1, Number(Astro.url.searchParams.get('page') ?? '1') || 1);

const recipes = await getCollection('recipes');
const recipeTitleBySlug = new Map<string, string>();
for (const r of recipes) {
  const slug = r.id.replace(/\.md$/, '');
  recipeTitleBySlug.set(slug.toLowerCase(), r.data.title);
}

const db = await getDb(Astro.locals);
const d1Status = getD1BindingStatus(Astro.locals);

const reviewData = db
  ? await listAdminReviews(db, {
      recipeSlug: recipeFilter,
      rating: ratingFilter ? Number(ratingFilter) : undefined,
      q: queryFilter,
      page: pageParam,
      pageSize: 30,
    })
  : {
      reviews: [],
      counts: { approved: 0, total: 0 },
      page: 1,
      totalPages: 1,
    };

const totalReviews = reviewData.counts.total;
const reviews = reviewData.reviews;
const avgRating =
  reviews.length > 0
    ? (reviews.reduce((acc, r) => acc + r.rating, 0) / reviews.length).toFixed(1)
    : totalReviews > 0
      ? '5.0'
      : '—';
---

<AdminLayout
  title="Recipe Reviews & Ratings"
  subtitle="Monitor community feedback, verify recipe ratings, and moderate editorial user reviews."
  activeNav="reviews"
  breadcrumbs={[{ label: 'Reviews & Ratings' }]}
>
  <div class="space-y-6">
    <!-- D1 Unbound Warning if DB is completely missing -->
    {!db && (
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-start gap-3 text-amber-900 text-sm">
        <div class="text-amber-600 mt-0.5">⚠️</div>
        <div>
          <strong class="font-bold">Cloudflare D1 Binding ("DB") Notice:</strong>
          <p class="text-xs text-amber-800 mt-0.5">
            {d1Status.details}
          </p>
        </div>
      </div>
    )}

    <!-- Metric Overview Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="bg-paper rounded-2xl p-5 border border-line/70 shadow-xs">
        <div class="flex items-center justify-between text-xs text-ink-soft mb-1">
          <span class="font-semibold uppercase tracking-wider">Total Reviews</span>
          <MessageSquare size={16} class="text-forest" aria-hidden="true" />
        </div>
        <p class="text-2xl sm:text-3xl font-display font-bold text-forest">{totalReviews}</p>
        <p class="text-xs text-ink-soft mt-1">Verified user submissions</p>
      </div>

      <div class="bg-paper rounded-2xl p-5 border border-line/70 shadow-xs">
        <div class="flex items-center justify-between text-xs text-ink-soft mb-1">
          <span class="font-semibold uppercase tracking-wider">Average Rating</span>
          <Star size={16} class="text-amber-500 fill-amber-500" aria-hidden="true" />
        </div>
        <div class="flex items-baseline gap-1.5">
          <p class="text-2xl sm:text-3xl font-display font-bold text-forest">{avgRating}</p>
          {avgRating !== '—' && <span class="text-xs text-ink-soft font-semibold">/ 5.0</span>}
        </div>
        <p class="text-xs text-ink-soft mt-1">Across approved reviews</p>
      </div>

      <div class="bg-paper rounded-2xl p-5 border border-line/70 shadow-xs">
        <div class="flex items-center justify-between text-xs text-ink-soft mb-1">
          <span class="font-semibold uppercase tracking-wider">Showing on Page</span>
          <CircleCheck size={16} class="text-emerald-700" aria-hidden="true" />
        </div>
        <p class="text-2xl sm:text-3xl font-display font-bold text-forest">{reviews.length}</p>
        <p class="text-xs text-ink-soft mt-1">Page {reviewData.page} of {reviewData.totalPages}</p>
      </div>

      <div class="bg-paper rounded-2xl p-5 border border-line/70 shadow-xs">
        <div class="flex items-center justify-between text-xs text-ink-soft mb-1">
          <span class="font-semibold uppercase tracking-wider">Database Mode</span>
          <Database size={16} class="text-forest" aria-hidden="true" />
        </div>
        <p class="text-lg sm:text-xl font-display font-bold text-forest truncate">
          {d1Status.mode === 'cloudflare-d1' ? 'Cloudflare D1' : 'Local SQLite'}
        </p>
        <p class="text-xs text-ink-soft mt-1 truncate">Binding: {d1Status.bindingName}</p>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-4">
      <form method="GET" action="/admin/reviews/" class="space-y-4">
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          <!-- Search Input -->
          <div class="relative flex-1 max-w-md">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-ink-soft">
              <Search size={18} aria-hidden="true" />
            </div>
            <input
              type="search"
              name="q"
              value={queryFilter}
              placeholder="Search by review title, comment, author..."
              aria-label="Search reviews"
              class="w-full pl-10 pr-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest focus:border-forest transition"
            />
          </div>

          <!-- Controls -->
          <div class="flex flex-wrap items-center gap-3">
            <!-- Star Rating Filter -->
            <div class="relative flex items-center">
              <label for="ratingFilter" class="sr-only">Filter by star rating</label>
              <select
                id="ratingFilter"
                name="rating"
                aria-label="Filter by star rating"
                class="px-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition"
              >
                <option value="" selected={ratingFilter === ''}>All Star Ratings</option>
                {[5, 4, 3, 2, 1].map((star) => (
                  <option value={String(star)} selected={ratingFilter === String(star)}>
                    {star} {star === 1 ? 'Star' : 'Stars'}
                  </option>
                ))}
              </select>
            </div>

            <!-- Recipe Filter -->
            <div class="relative flex items-center">
              <label for="recipeFilter" class="sr-only">Filter by recipe</label>
              <div class="absolute left-3 pointer-events-none text-ink-soft">
                <ListFilter size={16} aria-hidden="true" />
              </div>
              <select
                id="recipeFilter"
                name="recipe"
                aria-label="Filter by recipe"
                class="pl-9 pr-8 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition appearance-none max-w-xs truncate"
              >
                <option value="">All Recipes</option>
                {[...recipeTitleBySlug.entries()].map(([slug, title]) => (
                  <option value={slug} selected={recipeFilter.toLowerCase() === slug}>
                    {title}
                  </option>
                ))}
              </select>
            </div>

            <button
              type="submit"
              class="px-4 py-2.5 rounded-xl bg-forest text-cream font-bold text-xs hover:bg-forest-deep shadow-xs transition cursor-pointer"
            >
              Apply Filters
            </button>

            {(ratingFilter || recipeFilter || queryFilter) && (
              <a
                href="/admin/reviews/"
                class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold text-ink-soft hover:text-forest bg-cream/80 hover:bg-cream rounded-xl border border-line/70 transition cursor-pointer"
                title="Reset filters"
              >
                <RotateCcw size={14} aria-hidden="true" />
                <span>Reset</span>
              </a>
            )}
          </div>
        </div>

        <div class="flex items-center justify-between text-xs text-ink-soft pt-2 border-t border-line/40">
          <span>Showing {reviews.length} of {totalReviews} reviews</span>
          <span>Instant publishing enabled for verified community members</span>
        </div>
      </form>
    </div>

    <!-- Review Cards Feed -->
    {reviews.length > 0 ? (
      <div class="space-y-4">
        {reviews.map((rev) => {
          const recipeTitle = recipeTitleBySlug.get(rev.recipeSlug.toLowerCase()) ?? rev.recipeSlug;
          const formattedDate = new Date(rev.createdAt).toLocaleString('en-US', {
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: 'numeric',
            minute: '2-digit',
          });

          return (
            <article
              data-admin-review-id={rev.id}
              class="bg-paper rounded-2xl border border-line/70 p-6 shadow-xs space-y-4 hover:border-forest/40 transition"
            >
              {/* Card Header */}
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="space-y-1.5">
                  <div class="flex flex-wrap items-center gap-3">
                    <a
                      href={`/recipe/${rev.recipeSlug}/#recipe-reviews`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display font-bold text-base sm:text-lg text-forest hover:text-terracotta transition underline flex items-center gap-1.5"
                    >
                      <span>{recipeTitle}</span>
                      <ExternalLink size={14} class="text-ink-soft" aria-hidden="true" />
                    </a>

                    {/* Star Rating Badge */}
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200">
                      <span class="text-amber-500 font-serif">{'★'.repeat(rev.rating)}{'☆'.repeat(5 - rev.rating)}</span>
                      <span>({rev.rating}/5)</span>
                    </span>
                  </div>

                  {/* Author & Date Metadata */}
                  <div class="flex flex-wrap items-center gap-3 text-xs text-ink-soft">
                    <span class="inline-flex items-center gap-1">
                      <User size={13} aria-hidden="true" />
                      <strong class="text-ink font-semibold">{rev.authorDisplayName}</strong>
                      <span>(@{rev.authorUsername})</span>
                    </span>
                    <span class="text-line">&middot;</span>
                    <span class="inline-flex items-center gap-1">
                      <Calendar size={13} aria-hidden="true" />
                      <span>{formattedDate}</span>
                    </span>
                  </div>
                </div>

                {/* Moderate Actions */}
                <div class="flex items-center gap-2 self-start">
                  <a
                    href={`/recipe/${rev.recipeSlug}/#recipe-reviews`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-forest bg-cream hover:bg-white border border-line/70 transition"
                    title="View review on recipe page"
                  >
                    <span>View Live</span>
                    <ExternalLink size={12} aria-hidden="true" />
                  </a>

                  <button
                    type="button"
                    data-delete-review-id={rev.id}
                    class="delete-review-btn inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-terracotta bg-cream hover:bg-terracotta/10 border border-line/70 transition cursor-pointer"
                    title="Delete review"
                    aria-label={`Delete review by ${rev.authorDisplayName}`}
                  >
                    <Trash size={13} aria-hidden="true" />
                    <span>Delete</span>
                  </button>
                </div>
              </div>

              {/* Review Body */}
              <div class="bg-cream/40 rounded-xl p-4 border border-line/40 space-y-1.5">
                <h3 class="font-display font-bold text-sm text-forest">
                  {decodeHtmlEntities(rev.title)}
                </h3>
                <p class="text-xs sm:text-sm text-ink leading-relaxed whitespace-pre-line font-sans">
                  {decodeHtmlEntities(rev.comment)}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="bg-paper rounded-2xl border border-line/70 p-12 text-center max-w-lg mx-auto">
        <div class="flex size-14 items-center justify-center rounded-2xl bg-cream text-forest mx-auto mb-4 border border-line/60">
          <MessageSquare size={26} aria-hidden="true" />
        </div>
        <h2 class="font-display font-bold text-lg text-forest">No matching reviews found</h2>
        <p class="text-sm text-ink-soft mt-1.5 max-w-sm mx-auto">
          {ratingFilter || recipeFilter || queryFilter
            ? 'No community reviews match the current filters. Try resetting the filters to view all feedback.'
            : 'Community reviews are published immediately when signed-in members submit feedback on recipe pages.'}
        </p>
        {(ratingFilter || recipeFilter || queryFilter) && (
          <a
            href="/admin/reviews/"
            class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-forest bg-cream hover:bg-white border border-line shadow-xs transition cursor-pointer"
          >
            <RotateCcw size={14} aria-hidden="true" />
            <span>Clear all filters</span>
          </a>
        )}
      </div>
    )}
  </div>
</AdminLayout>

<script>
  declare global {
    function showAdminToast(message: string, type?: 'info' | 'success' | 'error'): void;
  }

  const csrfToken = document.cookie
    .split('; ')
    .find((entry) => entry.startsWith('crockbites_admin_csrf='))
    ?.split('=')[1] ?? '';

  document.querySelectorAll<HTMLButtonElement>('.delete-review-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const reviewId = btn.dataset.deleteReviewId;
      if (!reviewId) return;

      const confirmed = window.confirm('Permanently delete this community review? This action cannot be undone.');
      if (!confirmed) return;

      btn.disabled = true;

      try {
        const response = await fetch('/api/admin/reviews/', {
          method: 'DELETE',
          headers: {
            'content-type': 'application/json',
            'x-csrf-token': csrfToken,
          },
          body: JSON.stringify({
            reviewId,
            csrfToken,
          }),
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(data.error || 'Failed to delete review.');
        }

        const card = btn.closest<HTMLElement>('article[data-admin-review-id]');
        if (card) {
          card.remove();
        } else {
          window.location.reload();
        }

        if (typeof showAdminToast === 'function') {
          showAdminToast('Review successfully deleted.', 'success');
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Failed to delete review.';
        window.alert(msg);
        btn.disabled = false;
      }
    });
  });
</script>
