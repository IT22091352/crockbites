---
export const prerender = false;

import { getAllRecipes } from '../../../utils/recipes';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  extractCloudinaryPublicId,
  getOptimizedCloudinaryUrl,
  isCloudinaryConfigured,
  listCloudinaryAssets,
} from '../../../lib/cloudinary';
import {
  Upload,
  Search,
  Copy,
  ExternalLink,
  Trash,
  Lock,
} from '@lucide/astro';

interface MediaUsage {
  title: string;
  slug: string;
  type: 'hero' | 'gallery';
}

interface MediaAsset {
  id: string;
  url: string;
  publicId?: string;
  alt: string;
  isCloudinary: boolean;
  thumbUrl: string;
  usages: MediaUsage[];
}

const recipes = await getAllRecipes(true);
const mediaMap = new Map<string, MediaAsset>();

for (const recipe of recipes) {
  const slug = recipe.id.replace(/\.md$/, '');
  const title = recipe.data.title;

  // Primary Hero Image
  const rawImage = recipe.data.image;
  const primaryUrl = typeof rawImage === 'string' ? rawImage : (rawImage as any)?.src;
  if (primaryUrl) {
    const isCloudinary = primaryUrl.includes('res.cloudinary.com');
    const publicId = extractCloudinaryPublicId(primaryUrl) ?? undefined;
    const key = publicId || primaryUrl;
    const thumbUrl = isCloudinary ? getOptimizedCloudinaryUrl(primaryUrl, 360) : primaryUrl;

    if (!mediaMap.has(key)) {
      mediaMap.set(key, {
        id: key,
        url: primaryUrl,
        publicId,
        alt: recipe.data.imageAlt || `${title} photo`,
        isCloudinary,
        thumbUrl,
        usages: [{ title, slug, type: 'hero' }],
      });
    } else {
      const existing = mediaMap.get(key)!;
      if (!existing.usages.some((u) => u.slug === slug && u.type === 'hero')) {
        existing.usages.push({ title, slug, type: 'hero' });
      }
    }
  }

  // Gallery Images
  if (Array.isArray(recipe.data.gallery)) {
    for (const item of recipe.data.gallery) {
      if (!item || !item.url) continue;
      const isCloudinary = item.url.includes('res.cloudinary.com');
      const publicId = item.publicId || extractCloudinaryPublicId(item.url) || undefined;
      const key = publicId || item.url;
      const thumbUrl = isCloudinary ? getOptimizedCloudinaryUrl(item.url, 360) : item.url;

      if (!mediaMap.has(key)) {
        mediaMap.set(key, {
          id: key,
          url: item.url,
          publicId,
          alt: item.alt || `${title} photo`,
          isCloudinary,
          thumbUrl,
          usages: [{ title, slug, type: 'gallery' }],
        });
      } else {
        const existing = mediaMap.get(key)!;
        if (!existing.usages.some((u) => u.slug === slug && u.type === 'gallery')) {
          existing.usages.push({ title, slug, type: 'gallery' });
        }
      }
    }
  }
}

const isConfigured = isCloudinaryConfigured();

if (isConfigured) {
  try {
    const cldResources = await listCloudinaryAssets('crockbites/recipes', 500);
    for (const res of cldResources) {
      const key = res.public_id;
      if (!mediaMap.has(key)) {
        const rawName = (res.public_id.split('/').pop() || '').replace(/[_-]+/g, ' ');
        mediaMap.set(key, {
          id: key,
          url: res.secure_url,
          publicId: res.public_id,
          alt: rawName || 'Recipe photo',
          isCloudinary: true,
          thumbUrl: getOptimizedCloudinaryUrl(res.secure_url, 360),
          usages: [],
        });
      }
    }
  } catch (cldErr) {
    console.warn('[Media Page] Cloudinary listing skipped:', cldErr);
  }
}

const mediaItems = Array.from(mediaMap.values());
---

<AdminLayout
  title="Media Library"
  subtitle="Upload food photography, browse existing images, and copy CDN URLs."
  activeNav="media"
  breadcrumbs={[{ label: 'Media Library' }]}
>
  <div class="space-y-6">
    <!-- Cloudinary Warning if unconfigured -->
    {!isConfigured && (
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex items-start gap-3 text-amber-900 text-sm">
        <div class="text-amber-600 mt-0.5">⚠️</div>
        <div>
          <strong class="font-bold">Cloudinary Configuration Notice:</strong>
          <p class="text-xs text-amber-800 mt-0.5">
            CLOUDINARY_CLOUD_NAME or API keys are missing in this environment. Existing image assets remain visible, but new uploads require configuration in Settings.
          </p>
        </div>
      </div>
    )}

    <!-- Upload Dropzone Card -->
    <div class="bg-paper rounded-2xl border border-line/70 p-6 shadow-xs">
      <h2 class="font-display font-bold text-base text-forest mb-3">Upload Image</h2>
      <form id="uploadForm">
        <div
          id="dropzone"
          class="block border-2 border-dashed border-line/80 hover:border-forest rounded-2xl p-6 text-center bg-cream/30 hover:bg-cream/60 transition-all cursor-pointer flex flex-col items-center justify-center gap-2 group"
        >
          <div class="flex size-12 items-center justify-center rounded-xl bg-cream text-forest group-hover:scale-105 group-hover:bg-forest group-hover:text-cream transition shadow-xs">
            <Upload size={20} aria-hidden="true" />
          </div>
          <div>
            <p class="text-sm font-bold text-forest">
              <span class="text-terracotta underline cursor-pointer">Choose image</span> or drag and drop here
            </p>
            <p class="text-xs text-ink-soft mt-0.5">JPEG, PNG, WebP, AVIF, SVG, GIF up to 8 MB</p>
          </div>
        </div>
        <input
          type="file"
          id="fileInput"
          name="images"
          multiple
          accept="image/jpeg,image/png,image/webp,image/avif,image/svg+xml,image/gif,.jpg,.jpeg,.png,.webp,.avif,.svg,.gif"
          class="sr-only"
        />

        <div id="uploadStatus" class="hidden items-center justify-between p-3 bg-cream/70 rounded-xl border border-line text-xs text-forest mt-3">
          <div class="flex items-center gap-2">
            <div class="size-3.5 rounded-full border-2 border-forest border-t-transparent animate-spin"></div>
            <span id="uploadStatusText" class="font-semibold">Uploading to Cloudinary...</span>
          </div>
          <span class="text-ink-soft">Please wait</span>
        </div>
      </form>
    </div>

    <!-- Search Toolbar -->
    <div class="bg-paper rounded-2xl border border-line/70 p-4 shadow-xs flex items-center justify-between gap-4">
      <div class="relative flex-1 max-w-md">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-ink-soft">
          <Search size={16} aria-hidden="true" />
        </div>
        <input
          id="mediaSearchInput"
          type="search"
          placeholder="Search images by name or recipe..."
          aria-label="Search images"
          class="w-full pl-9 pr-4 py-2 text-xs sm:text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest focus:border-forest transition"
        />
      </div>

      <span id="mediaCountText" class="text-xs text-ink-soft font-medium">
        {mediaItems.length} images
      </span>
    </div>

    <!-- Media Grid -->
    <div id="mediaGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {mediaItems.map((item) => (
        <article
          data-title={item.alt.toLowerCase()}
          data-url={item.url.toLowerCase()}
          class="media-card bg-paper rounded-2xl border border-line/70 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col group"
        >
          <!-- Thumbnail Preview -->
          <div class="relative aspect-4/3 bg-cream/60 overflow-hidden border-b border-line/60">
            <img
              src={item.thumbUrl}
              alt={item.alt}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>

          <!-- Content Details -->
          <div class="p-3 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <p class="font-display font-bold text-xs text-forest line-clamp-1" title={item.alt}>
                {item.alt}
              </p>
              <div class="mt-1">
                {item.usages.length > 0 ? (
                  <span class="text-[10px] text-ink-soft line-clamp-1">
                    Used in: {item.usages.map((u) => u.title).join(', ')}
                  </span>
                ) : (
                  <span class="text-[10px] text-emerald-800 font-medium">
                    Unused asset
                  </span>
                )}
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-2 border-t border-line/40 flex items-center justify-between gap-1.5">
              <!-- Copy URL Button -->
              <button
                type="button"
                data-copy-url={item.url}
                class="copy-url-btn flex-1 inline-flex items-center justify-center gap-1 px-2 py-1.5 rounded-lg text-xs font-bold text-forest bg-cream hover:bg-white border border-line shadow-xs transition cursor-pointer"
                title="Copy image URL"
              >
                <Copy size={12} aria-hidden="true" />
                <span class="copy-label">Copy</span>
              </button>

              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg text-ink-soft hover:text-forest hover:bg-cream border border-line/60 transition"
                title="View image"
                aria-label="View original image"
              >
                <ExternalLink size={13} aria-hidden="true" />
              </a>

              <!-- Delete Protection -->
              {item.isCloudinary && item.publicId && (
                item.usages.length > 0 ? (
                  <button
                    type="button"
                    disabled
                    class="p-1.5 rounded-lg text-ink-soft/40 cursor-not-allowed"
                    title="Cannot delete: used in recipes"
                    aria-label="Locked"
                  >
                    <Lock size={13} aria-hidden="true" />
                  </button>
                ) : (
                  <button
                    type="button"
                    data-delete-public-id={item.publicId}
                    class="delete-asset-btn p-1.5 rounded-lg text-terracotta hover:bg-terracotta/10 border border-line/60 transition cursor-pointer"
                    title="Delete unused image"
                    aria-label="Delete image"
                  >
                    <Trash size={13} aria-hidden="true" />
                  </button>
                )
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="mediaEmptyState"
      class="hidden bg-paper rounded-2xl border border-line/70 p-12 text-center max-w-lg mx-auto"
    >
      <div class="flex size-14 items-center justify-center rounded-2xl bg-cream text-forest mx-auto mb-4 border border-line/60">
        <Search size={26} aria-hidden="true" />
      </div>
      <h2 class="font-display font-bold text-lg text-forest">No images found</h2>
      <p class="text-sm text-ink-soft mt-1.5 max-w-sm mx-auto">
        No images match your search term.
      </p>
    </div>
  </div>
</AdminLayout>

<script>
  const dropzone = document.getElementById('dropzone') as HTMLDivElement | null;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement | null;
  const uploadStatus = document.getElementById('uploadStatus') as HTMLDivElement | null;
  const uploadStatusText = document.getElementById('uploadStatusText') as HTMLSpanElement | null;
  const searchInput = document.getElementById('mediaSearchInput') as HTMLInputElement | null;
  const mediaCountText = document.getElementById('mediaCountText') as HTMLSpanElement | null;
  const mediaGrid = document.getElementById('mediaGrid') as HTMLDivElement | null;
  const emptyState = document.getElementById('mediaEmptyState') as HTMLDivElement | null;

  const csrfToken = document.body.dataset.adminCsrf ||
    (document.cookie
      .split('; ')
      .find((entry) => entry.startsWith('crockbites_admin_csrf='))
      ?.split('=')[1] ?? '');

  // Copy URL to clipboard
  document.querySelectorAll<HTMLButtonElement>('.copy-url-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copyUrl;
      if (!url) return;

      try {
        await navigator.clipboard.writeText(url);
        const label = btn.querySelector('.copy-label');
        if (label) {
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = original;
          }, 1500);
        }
      } catch {
        window.prompt('Copy image URL:', url);
      }
    });
  });

  // Safe delete unused image
  document.querySelectorAll<HTMLButtonElement>('.delete-asset-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const publicId = btn.dataset.deletePublicId;
      if (!publicId) return;

      const confirmed = window.confirm(`Permanently delete this unused image from Cloudinary?`);
      if (!confirmed) return;

      btn.disabled = true;

      try {
        const response = await fetch('/api/admin/images/delete/', {
          method: 'DELETE',
          headers: {
            'content-type': 'application/json',
            'x-csrf-token': csrfToken,
          },
          body: JSON.stringify({ publicId, csrfToken }),
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data.error || 'Failed to delete image.');
        }

        const card = btn.closest<HTMLElement>('.media-card');
        if (card) {
          card.remove();
        } else {
          window.location.reload();
        }
      } catch (err) {
        window.alert(err instanceof Error ? err.message : 'Delete failed.');
        btn.disabled = false;
      }
    });
  });

  // Search filter
  function filterMedia() {
    if (!searchInput || !mediaGrid) return;
    const q = searchInput.value.trim().toLowerCase();
    const cards = Array.from(mediaGrid.querySelectorAll<HTMLElement>('.media-card'));
    let visible = 0;

    cards.forEach((card) => {
      const title = card.dataset.title || '';
      const url = card.dataset.url || '';
      const match = !q || title.includes(q) || url.includes(q);
      card.hidden = !match;
      if (match) visible += 1;
    });

    if (emptyState) emptyState.classList.toggle('hidden', visible > 0);
    if (mediaCountText) mediaCountText.textContent = `${visible} image${visible === 1 ? '' : 's'}`;
  }

  searchInput?.addEventListener('input', filterMedia);

  // Upload handling
  dropzone?.addEventListener('click', () => {
    fileInput?.click();
  });
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-forest', 'bg-cream/70');
  });
  dropzone?.addEventListener('dragleave', () => {
    dropzone?.classList.remove('border-forest', 'bg-cream/70');
  });
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone?.classList.remove('border-forest', 'bg-cream/70');
    if (e.dataTransfer?.files) {
      handleFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files) {
      handleFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  async function handleFiles(files: File[]) {
    if (files.length === 0) return;
    if (uploadStatusText) {
      uploadStatusText.textContent = `Uploading ${files.length} image${files.length > 1 ? 's' : ''} to Cloudinary...`;
    }
    if (uploadStatus) uploadStatus.classList.remove('hidden');
    if (uploadStatus) uploadStatus.classList.add('flex');

    const formData = new FormData();
    files.forEach((f) => formData.append('images', f));
    formData.append('csrfToken', csrfToken);

    try {
      const response = await fetch('/api/admin/images/upload/', {
        method: 'POST',
        headers: { 'x-csrf-token': csrfToken },
        body: formData,
      });

      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.error || 'Upload failed.');
      }

      if (data.errors && data.errors.length > 0) {
        window.alert(`Uploaded ${data.images.length} images. ${data.errors.length} file(s) failed: ${data.errors.map((e: any) => e.name + ': ' + e.error).join(', ')}`);
      }

      window.location.reload();
    } catch (err) {
      window.alert(err instanceof Error ? err.message : 'Upload failed.');
    } finally {
      if (uploadStatus) uploadStatus.classList.add('hidden');
      if (uploadStatus) uploadStatus.classList.remove('flex');
    }
  }
</script>
