---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getGithubConfig } from '../../lib/github';
import { getCloudinaryConfig } from '../../lib/cloudinary';
import { getD1BindingStatus } from '../../lib/db';
import { isTransactionalEmailConfigured } from '../../lib/user-auth';
import { isBrevoCampaignConfigured } from '../../lib/brevo-campaign';
import {
  GitBranch,
  Image as ImageIcon,
  Database,
  Mail,
  CircleCheck,
  CircleAlert,
} from '@lucide/astro';

// Inspect Configurations
const gh = getGithubConfig();
const ghConfigured = Boolean(gh.token && gh.owner && gh.repo);
const cl = getCloudinaryConfig();
const clConfigured = cl.isConfigured;
const d1Status = getD1BindingStatus(Astro.locals);
const emailStatus = isTransactionalEmailConfigured();
const brevoStatus = isBrevoCampaignConfigured();
---

<AdminLayout
  title="Settings"
  subtitle="Connected service integrations and publishing infrastructure."
  activeNav="settings"
  breadcrumbs={[{ label: 'Settings' }]}
>
  <div class="space-y-6 max-w-4xl">
    <!-- Integration Status Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- 1. GitHub Integration -->
      <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-3 flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex size-9 items-center justify-center rounded-xl bg-forest text-cream">
                <GitBranch size={18} aria-hidden="true" />
              </div>
              <h2 class="font-display font-bold text-base text-forest">GitHub Repository</h2>
            </div>
            {ghConfigured ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                <span>Connected</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200">
                <CircleAlert size={12} class="text-rose-600" aria-hidden="true" />
                <span>Not Set</span>
              </span>
            )}
          </div>
          <p class="text-xs text-ink-soft">
            Application source code repository and deployment tracking.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-cream/40 text-xs text-ink-soft space-y-1 border border-line/40">
          <div><span class="font-semibold text-forest">Repository:</span> {gh.owner && gh.repo ? `${gh.owner}/${gh.repo}` : 'Not set'}</div>
          <div><span class="font-semibold text-forest">Branch:</span> {gh.branch || 'main'}</div>
        </div>
      </div>

      <!-- 2. Cloudinary Integration -->
      <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-3 flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex size-9 items-center justify-center rounded-xl bg-terracotta text-white">
                <ImageIcon size={18} aria-hidden="true" />
              </div>
              <h2 class="font-display font-bold text-base text-forest">Cloudinary Media</h2>
            </div>
            {clConfigured ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                <span>Connected</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200">
                <CircleAlert size={12} class="text-rose-600" aria-hidden="true" />
                <span>Not Set</span>
              </span>
            )}
          </div>
          <p class="text-xs text-ink-soft">
            Hosts and optimizes high-resolution food photography.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-cream/40 text-xs text-ink-soft space-y-1 border border-line/40">
          <div><span class="font-semibold text-forest">Cloud Name:</span> {cl.cloudName || 'Not set'}</div>
          <div><span class="font-semibold text-forest">Folder:</span> crockbites/recipes</div>
        </div>
      </div>

      <!-- 3. Cloudflare D1 Database -->
      <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-3 flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex size-9 items-center justify-center rounded-xl bg-forest-soft text-white">
                <Database size={18} aria-hidden="true" />
              </div>
              <h2 class="font-display font-bold text-base text-forest">Cloudflare D1 Database</h2>
            </div>
            {d1Status.isD1Bound || d1Status.mode === 'local-sqlite' ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                <span>Active</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200">
                <CircleAlert size={12} class="text-rose-600" aria-hidden="true" />
                <span>Not Bound</span>
              </span>
            )}
          </div>
          <p class="text-xs text-ink-soft">
            Authoritative single source of truth for recipes, drafts, user accounts, and reviews.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-cream/40 text-xs text-ink-soft space-y-1 border border-line/40">
          <div><span class="font-semibold text-forest">Binding:</span> DB</div>
          <div><span class="font-semibold text-forest">Runtime Mode:</span> {d1Status.mode === 'cloudflare-d1' ? 'Cloudflare D1 (Production)' : 'Local SQLite (Dev)'}</div>
        </div>
      </div>

      <!-- 4. Resend Transactional Email -->
      <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-3 flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex size-9 items-center justify-center rounded-xl bg-forest text-cream">
                <Mail size={18} aria-hidden="true" />
              </div>
              <h2 class="font-display font-bold text-base text-forest">Resend Email Delivery</h2>
            </div>
            {emailStatus.configured ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                <span>Ready</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                <CircleAlert size={12} class="text-amber-600" aria-hidden="true" />
                <span>Secret Needed</span>
              </span>
            )}
          </div>
          <p class="text-xs text-ink-soft">
            Delivers email verification and password reset transactional messages.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-cream/40 text-xs text-ink-soft space-y-1 border border-line/40">
          <div><span class="font-semibold text-forest">Sending Domain:</span> mail.crockbites.site</div>
          <div><span class="font-semibold text-forest">Sender Address:</span> no-reply@mail.crockbites.site</div>
        </div>
      </div>

      <!-- 5. Brevo Newsletter Campaigns -->
      <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-3 flex flex-col justify-between">
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <div class="flex size-9 items-center justify-center rounded-xl bg-forest text-cream">
                <Mail size={18} aria-hidden="true" />
              </div>
              <h2 class="font-display font-bold text-base text-forest">Brevo Newsletter Campaigns</h2>
            </div>
            {brevoStatus.configured ? (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                <span>Ready</span>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                <CircleAlert size={12} class="text-amber-600" aria-hidden="true" />
                <span>Secret Needed</span>
              </span>
            )}
          </div>
          <p class="text-xs text-ink-soft">
            Dispatches new recipe announcement campaigns to newsletter subscribers upon publishing.
          </p>
        </div>

        <div class="p-3 rounded-xl bg-cream/40 text-xs text-ink-soft space-y-1 border border-line/40">
          <div><span class="font-semibold text-forest">Audience List:</span> ID #{brevoStatus.listId} (CrockBites Newsletter Subscribers)</div>
          <div><span class="font-semibold text-forest">Sender Identity:</span> {brevoStatus.sender}</div>
          <div><span class="font-semibold text-forest">Secret Binding:</span> BREVO_API_KEY</div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
