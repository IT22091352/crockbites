---
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { listAdminReviews } from '../../lib/community';
import { getOptimizedCloudinaryUrl } from '../../lib/cloudinary';
import {
  BookOpen,
  CircleCheck,
  Clock,
  MessageSquare,
  CirclePlus,
  ArrowRight,
  ExternalLink,
  SlidersHorizontal,
  FilePenLine,
  Eye,
  TrendingUp,
} from '@lucide/astro';

const recipes = await getCollection('recipes');
const totalRecipes = recipes.length;
const published = recipes.filter((recipe) => recipe.data.reviewStatus === 'tested').length;
const drafts = recipes.filter((recipe) => recipe.data.reviewStatus === 'draft').length;
const publishedPercentage = totalRecipes > 0 ? Math.round((published / totalRecipes) * 100) : 0;

// Get real reviews count from D1
const db = await getDb(Astro.locals);
let totalReviews = 0;
let avgRating = '—';
if (db) {
  try {
    const reviewData = await listAdminReviews(db, { page: 1, pageSize: 1 });
    totalReviews = reviewData.counts.total;
    // Calculate average rating across all reviews if present
    const ratingRow = await db
      .prepare(`SELECT AVG(rating) as avgRating FROM reviews WHERE status = 'approved'`)
      .first<{ avgRating: number | null }>();
    if (ratingRow?.avgRating) {
      avgRating = ratingRow.avgRating.toFixed(1);
    }
  } catch {
    // Graceful fallback if database read fails
  }
}

// Sort recently updated or published recipes
const recent = [...recipes]
  .sort((a, b) => {
    const aDate = a.data.updatedDate ?? a.data.pubDate;
    const bDate = b.data.updatedDate ?? b.data.pubDate;
    return Number(bDate) - Number(aDate);
  })
  .slice(0, 6);

const recentWithMeta = recent.map((recipe) => {
  const slug = recipe.id.replace(/\.md$/, '');
  const rawImage = recipe.data.image;
  const imageUrl = typeof rawImage === 'string' ? rawImage : (rawImage as any)?.src || '/placeholder.svg';
  const isCloudinary = imageUrl.startsWith('http://') || imageUrl.startsWith('https://');
  const thumbUrl = isCloudinary ? getOptimizedCloudinaryUrl(imageUrl, 180) : imageUrl;
  return {
    ...recipe,
    slug,
    thumbUrl,
    displayDate: (recipe.data.updatedDate ?? recipe.data.pubDate).toISOString().slice(0, 10),
  };
});
---

<AdminLayout
  title="Editorial Overview"
  subtitle="Monitor recipe inventory, publication workflow status, and live community feedback."
  activeNav="overview"
>
  <!-- Topbar Action Button Slot -->
  <div slot="actions">
    <a
      href="/admin/recipes/new/"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-forest text-cream font-bold text-sm hover:bg-forest-deep shadow-xs transition hover:scale-[1.02] cursor-pointer"
    >
      <CirclePlus size={16} aria-hidden="true" />
      <span>Create Recipe</span>
    </a>
  </div>

  <div class="space-y-8">
    <!-- Stat Metric Cards -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" aria-label="Key Publication Metrics">
      <!-- Total Recipes -->
      <div class="card p-5 sm:p-6 bg-paper border border-line rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-ink-soft">Total Inventory</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-forest/5 text-forest">
            <BookOpen size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-forest">{totalRecipes}</p>
          <p class="text-xs text-ink-soft mt-1">Recipes across 7 categories</p>
        </div>
      </div>

      <!-- Published Recipes -->
      <div class="card p-5 sm:p-6 bg-paper border border-line rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Kitchen-Tested</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
            <CircleCheck size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-emerald-900">{published}</p>
          <p class="text-xs text-ink-soft mt-1">Indexed &amp; live on website</p>
        </div>
      </div>

      <!-- Draft Recipes -->
      <div class="card p-5 sm:p-6 bg-paper border border-line rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Drafts / In-Prep</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-amber-50 text-amber-700">
            <Clock size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-amber-900">{drafts}</p>
          <p class="text-xs text-ink-soft mt-1">Hidden from search engines</p>
        </div>
      </div>

      <!-- Community Reviews -->
      <div class="card p-5 sm:p-6 bg-paper border border-line rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta-deep">User Reviews</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-terracotta/10 text-terracotta-deep">
            <MessageSquare size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <div class="flex items-baseline gap-2">
            <p class="font-display text-3xl sm:text-4xl font-bold text-forest">{totalReviews}</p>
            {avgRating !== '—' && (
              <span class="text-xs font-bold text-terracotta-deep">★ {avgRating} avg</span>
            )}
          </div>
          <p class="text-xs text-ink-soft mt-1">Real ratings in Cloudflare D1</p>
        </div>
      </div>
    </section>

    <!-- Publishing Status Ratio & Workflow Progress -->
    <section class="card p-6 bg-paper border border-line rounded-2xl shadow-xs">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <TrendingUp size={18} class="text-forest" aria-hidden="true" />
            <h2 class="font-display text-lg font-bold text-forest">Publication Health &amp; Readiness</h2>
          </div>
          <p class="text-xs text-ink-soft mt-1">
            {published} of {totalRecipes} recipes tested and ready for search engine indexing.
          </p>
        </div>
        <div class="flex items-center gap-4 text-xs font-semibold">
          <span class="flex items-center gap-1.5 text-emerald-800">
            <span class="size-2 rounded-full bg-emerald-600"></span>
            <span>Published ({publishedPercentage}%)</span>
          </span>
          <span class="flex items-center gap-1.5 text-amber-800">
            <span class="size-2 rounded-full bg-amber-500"></span>
            <span>Drafts ({100 - publishedPercentage}%)</span>
          </span>
        </div>
      </div>

      <!-- Progress Track -->
      <div class="w-full h-3 bg-cream-deep/60 rounded-full overflow-hidden mt-4 border border-line/40">
        <div
          class="h-full bg-forest rounded-full transition-all duration-500"
          style={`width: ${publishedPercentage}%`}
        ></div>
      </div>
    </section>

    <!-- Two-Column Grid: Recent Recipes & Quick Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Recently Edited Recipes Table (2 cols) -->
      <section class="lg:col-span-2 card bg-paper border border-line rounded-2xl shadow-xs overflow-hidden">
        <div class="px-6 py-5 border-b border-line/60 flex items-center justify-between">
          <div>
            <h2 class="font-display text-lg font-bold text-forest">Recent Recipe Activity</h2>
            <p class="text-xs text-ink-soft">Latest edits and publishing changes</p>
          </div>
          <a
            href="/admin/recipes/"
            class="text-xs font-bold text-terracotta-deep hover:underline flex items-center gap-1"
          >
            <span>View all {totalRecipes}</span>
            <ArrowRight size={14} aria-hidden="true" />
          </a>
        </div>

        <div class="divide-y divide-line/40 overflow-x-auto">
          {recentWithMeta.map((recipe) => (
            <div class="px-6 py-4 flex items-center justify-between gap-4 hover:bg-cream/20 transition">
              <div class="flex items-center gap-3.5 min-w-0">
                <img
                  src={recipe.thumbUrl}
                  alt=""
                  width="48"
                  height="48"
                  class="size-12 rounded-xl object-cover border border-line/60 shrink-0 bg-cream-deep/40"
                  loading="lazy"
                />
                <div class="min-w-0">
                  <p class="text-sm font-bold text-forest truncate">{recipe.data.title}</p>
                  <div class="flex items-center gap-2 mt-0.5 text-xs text-ink-soft">
                    <span class="capitalize">{recipe.data.category.replace(/-/g, ' ')}</span>
                    <span class="text-line">&middot;</span>
                    <time datetime={recipe.displayDate}>{recipe.displayDate}</time>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                {recipe.data.reviewStatus === 'tested' ? (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                    <CircleCheck size={12} class="text-emerald-700" aria-hidden="true" />
                    <span>Published</span>
                  </span>
                ) : (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                    <Clock size={12} class="text-amber-700" aria-hidden="true" />
                    <span>Draft</span>
                  </span>
                )}

                <div class="flex items-center gap-1.5">
                  <a
                    href={`/admin/recipes/preview/${recipe.slug}/`}
                    class="p-1.5 rounded-lg text-ink-soft hover:text-forest hover:bg-cream-deep/50 transition cursor-pointer"
                    title="Preview Recipe"
                    aria-label={`Preview ${recipe.data.title}`}
                  >
                    <Eye size={16} aria-hidden="true" />
                  </a>
                  <a
                    href={`/admin/recipes/${recipe.slug}/`}
                    class="p-1.5 rounded-lg text-ink-soft hover:text-forest hover:bg-cream-deep/50 transition cursor-pointer"
                    title="Edit Recipe"
                    aria-label={`Edit ${recipe.data.title}`}
                  >
                    <FilePenLine size={16} aria-hidden="true" />
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Editorial Quick Actions (1 col) -->
      <section class="card bg-paper border border-line rounded-2xl shadow-xs p-6 flex flex-col justify-between">
        <div>
          <h2 class="font-display text-lg font-bold text-forest">Editorial Shortcuts</h2>
          <p class="text-xs text-ink-soft mt-0.5">Quick actions to manage your publishing operations</p>

          <div class="mt-5 space-y-2.5">
            <a
              href="/admin/recipes/new/"
              class="flex items-center justify-between p-3.5 rounded-xl border border-line/60 bg-cream/30 hover:bg-cream hover:border-forest/40 transition group"
            >
              <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-forest text-cream">
                  <CirclePlus size={18} aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs font-bold text-forest">Write New Recipe</p>
                  <p class="text-[11px] text-ink-soft">Add ingredients, steps &amp; photos</p>
                </div>
              </div>
              <ArrowRight size={16} class="text-ink-soft/60 group-hover:text-forest group-hover:translate-x-0.5 transition" aria-hidden="true" />
            </a>

            <a
              href="/admin/recipes/"
              class="flex items-center justify-between p-3.5 rounded-xl border border-line/60 bg-cream/30 hover:bg-cream hover:border-forest/40 transition group"
            >
              <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-forest text-cream">
                  <BookOpen size={18} aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs font-bold text-forest">Manage Catalog</p>
                  <p class="text-[11px] text-ink-soft">Search, filter &amp; edit recipes</p>
                </div>
              </div>
              <ArrowRight size={16} class="text-ink-soft/60 group-hover:text-forest group-hover:translate-x-0.5 transition" aria-hidden="true" />
            </a>

            <a
              href="/admin/reviews/"
              class="flex items-center justify-between p-3.5 rounded-xl border border-line/60 bg-cream/30 hover:bg-cream hover:border-forest/40 transition group"
            >
              <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-forest text-cream">
                  <MessageSquare size={18} aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs font-bold text-forest">Community Reviews</p>
                  <p class="text-[11px] text-ink-soft">Moderate ratings and feedback</p>
                </div>
              </div>
              <ArrowRight size={16} class="text-ink-soft/60 group-hover:text-forest group-hover:translate-x-0.5 transition" aria-hidden="true" />
            </a>

            <a
              href="/admin/settings/"
              class="flex items-center justify-between p-3.5 rounded-xl border border-line/60 bg-cream/30 hover:bg-cream hover:border-forest/40 transition group"
            >
              <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-forest text-cream">
                  <SlidersHorizontal size={18} aria-hidden="true" />
                </div>
                <div>
                  <p class="text-xs font-bold text-forest">System Settings</p>
                  <p class="text-[11px] text-ink-soft">Verify GitHub &amp; Cloudinary</p>
                </div>
              </div>
              <ArrowRight size={16} class="text-ink-soft/60 group-hover:text-forest group-hover:translate-x-0.5 transition" aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="mt-6 pt-5 border-t border-line/60 text-xs text-ink-soft">
          <p class="font-semibold text-forest">Production Domain</p>
          <a
            href="https://crockbites.site"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-flex items-center gap-1 text-terracotta-deep font-bold hover:underline"
          >
            <span>https://crockbites.site</span>
            <ExternalLink size={12} aria-hidden="true" />
          </a>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>
