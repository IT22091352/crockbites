---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { listAdminReviews } from '../../lib/community';
import { getAdminRecipeList } from '../../lib/admin-recipes';
import {
  BookOpen,
  CircleCheck,
  Clock,
  MessageSquare,
  CirclePlus,
  ArrowRight,
  FilePenLine,
  Eye,
} from '@lucide/astro';

const recipes = await getAdminRecipeList();
const totalRecipes = recipes.length;
const published = recipes.filter((recipe) => recipe.reviewStatus === 'tested').length;
const drafts = recipes.filter((recipe) => recipe.reviewStatus === 'draft').length;

// Get real reviews count from D1
const db = await getDb(Astro.locals);
let totalReviews = 0;
if (db) {
  try {
    const reviewData = await listAdminReviews(db, { page: 1, pageSize: 1 });
    totalReviews = reviewData.counts.total;
  } catch {
    // Graceful fallback if database read fails
  }
}

// Recipes are already sorted newest first by getAdminRecipeList
const recentWithMeta = recipes.slice(0, 5).map((recipe) => ({
  ...recipe,
  data: {
    title: recipe.title,
    category: recipe.category,
    reviewStatus: recipe.reviewStatus,
  },
  displayDate: (recipe.updatedDate || recipe.pubDate).slice(0, 10),
}));
---

<AdminLayout
  title="Dashboard"
  subtitle="Overview of your recipe catalog and publication status."
  activeNav="overview"
>
  <!-- Topbar Quick Access -->
  <div slot="actions" class="flex items-center gap-2.5">
    <a
      href="/admin/recipes/"
      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-line bg-white text-ink text-sm font-semibold hover:bg-cream/60 transition cursor-pointer shadow-xs"
    >
      <BookOpen size={16} aria-hidden="true" />
      <span>All Recipes</span>
    </a>
    <a
      href="/admin/recipes/new/"
      class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-forest text-cream font-bold text-sm hover:bg-forest-deep shadow-xs transition hover:scale-[1.02] cursor-pointer"
    >
      <CirclePlus size={16} aria-hidden="true" />
      <span>New Recipe</span>
    </a>
  </div>

  <div class="space-y-8">
    <!-- Stat Metric Cards -->
    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6" aria-label="Recipe Statistics">
      <!-- Total Recipes -->
      <div class="p-5 sm:p-6 bg-paper border border-line/80 rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-ink-soft">Total Recipes</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-forest/5 text-forest">
            <BookOpen size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-forest">{totalRecipes}</p>
          <p class="text-xs text-ink-soft mt-1">Total slow cooker recipes</p>
        </div>
      </div>

      <!-- Published Recipes -->
      <div class="p-5 sm:p-6 bg-paper border border-line/80 rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Published</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
            <CircleCheck size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-emerald-900">{published}</p>
          <p class="text-xs text-ink-soft mt-1">Live on website</p>
        </div>
      </div>

      <!-- Draft Recipes -->
      <div class="p-5 sm:p-6 bg-paper border border-line/80 rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-800">Drafts</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-amber-50 text-amber-700">
            <Clock size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-amber-900">{drafts}</p>
          <p class="text-xs text-ink-soft mt-1">Unpublished recipes</p>
        </div>
      </div>

      <!-- User Reviews -->
      <div class="p-5 sm:p-6 bg-paper border border-line/80 rounded-2xl shadow-xs flex flex-col justify-between">
        <div class="flex items-center justify-between text-ink-soft">
          <span class="text-xs font-bold uppercase tracking-wider text-terracotta-deep">User Reviews</span>
          <div class="flex size-8 items-center justify-center rounded-lg bg-terracotta/10 text-terracotta-deep">
            <MessageSquare size={18} aria-hidden="true" />
          </div>
        </div>
        <div class="mt-4">
          <p class="font-display text-3xl sm:text-4xl font-bold text-forest">{totalReviews}</p>
          <p class="text-xs text-ink-soft mt-1">Community submissions</p>
        </div>
      </div>
    </section>

    <!-- Recent Recipe Activity (latest 5) -->
    <section class="bg-paper border border-line/80 rounded-2xl shadow-xs overflow-hidden">
      <div class="px-6 py-5 border-b border-line/60 flex items-center justify-between">
        <div>
          <h2 class="font-display text-lg font-bold text-forest">Recent Recipe Activity</h2>
          <p class="text-xs text-ink-soft">Latest 5 recipe edits and updates</p>
        </div>
        <a
          href="/admin/recipes/"
          class="text-xs font-bold text-terracotta-deep hover:underline flex items-center gap-1"
        >
          <span>View all {totalRecipes}</span>
          <ArrowRight size={14} aria-hidden="true" />
        </a>
      </div>

      <div class="divide-y divide-line/40 overflow-x-auto">
        {recentWithMeta.map((recipe) => (
          <div class="px-6 py-4 flex items-center justify-between gap-4 hover:bg-cream/20 transition">
            <div class="flex items-center gap-3.5 min-w-0">
              <img
                src={recipe.thumbUrl}
                alt=""
                width="48"
                height="48"
                class="size-12 rounded-xl object-cover border border-line/60 shrink-0 bg-cream-deep/40"
                loading="lazy"
              />
              <div class="min-w-0">
                <p class="text-sm font-bold text-forest truncate">{recipe.data.title}</p>
                <div class="flex items-center gap-2 mt-0.5 text-xs text-ink-soft">
                  <span class="capitalize">{recipe.data.category.replace(/-/g, ' ')}</span>
                  <span class="text-line">&middot;</span>
                  <time datetime={recipe.displayDate}>{recipe.displayDate}</time>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              {recipe.data.reviewStatus === 'tested' ? (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                  <CircleCheck size={12} class="text-emerald-700" aria-hidden="true" />
                  <span>Published</span>
                </span>
              ) : (
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                  <Clock size={12} class="text-amber-700" aria-hidden="true" />
                  <span>Draft</span>
                </span>
              )}

              <div class="flex items-center gap-1.5">
                <a
                  href={`/admin/recipes/preview/${recipe.slug}/`}
                  class="p-1.5 rounded-lg text-ink-soft hover:text-forest hover:bg-cream-deep/50 transition cursor-pointer"
                  title="Preview Recipe"
                  aria-label={`Preview ${recipe.data.title}`}
                >
                  <Eye size={16} aria-hidden="true" />
                </a>
                <a
                  href={`/admin/recipes/${recipe.slug}/`}
                  class="p-1.5 rounded-lg text-ink-soft hover:text-forest hover:bg-cream-deep/50 transition cursor-pointer"
                  title="Edit Recipe"
                  aria-label={`Edit ${recipe.data.title}`}
                >
                  <FilePenLine size={16} aria-hidden="true" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</AdminLayout>
