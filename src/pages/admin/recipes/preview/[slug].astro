---
export const prerender = false;

import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import RecipeDetail from '../../../../components/RecipeDetail.astro';
import {
  ADMIN_COOKIE_NAME,
  getAdminSessionSecret,
  parseAdminSessionCookie,
  verifySessionCookie,
} from '../../../../lib/admin';
import {
  categoryById,
  recipeUrl,
  relatedRecipes,
} from '../../../../utils/recipes';
import { breadcrumbSchema, recipeSchema } from '../../../../utils/jsonld';
import { ArrowLeft, FilePenLine, Clock, CircleCheck } from '@lucide/astro';

const adminCookie = Astro.cookies.get(ADMIN_COOKIE_NAME)?.value ?? '';
const session = parseAdminSessionCookie(adminCookie);
const secret = getAdminSessionSecret();

if (!secret || !session || !verifySessionCookie(adminCookie, secret)) {
  return Astro.redirect('/admin/login/?error=Please+log+in+to+preview+recipes');
}

const slug = String(Astro.params.slug ?? '').trim();
const allRecipes = await getCollection('recipes');
const recipe = allRecipes.find(
  (entry) =>
    entry.id.replace(/\.md$/, '') === slug ||
    (entry.data.slug ?? '').toLowerCase() === slug.toLowerCase()
);

if (!recipe) {
  return Astro.redirect('/admin/recipes/');
}

const { Content } = await render(recipe);
const d = recipe.data;
const cat = categoryById(d.category) ?? { id: d.category, name: d.category };
const related = relatedRecipes(allRecipes as any, recipe as any, 3);

const rawBody = (recipe.body ?? '').trim();
const hasCustomIntro = Boolean(rawBody && rawBody !== (d.description ?? '').trim());

let ogSrc: string;
if (typeof d.image === 'string' && (d.image.startsWith('http://') || d.image.startsWith('https://'))) {
  ogSrc = d.image;
} else {
  try {
    const og = await getImage({ src: d.image as any, width: 1200 });
    ogSrc = og.src;
  } catch {
    ogSrc = typeof d.image === 'string' ? d.image : '/placeholder.svg';
  }
}

const path = recipeUrl(recipe as any);
const jsonLd = [
  recipeSchema(recipe as any, new URL(ogSrc, Astro.site ?? 'https://crockbites.site').href, cat.name),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Recipes', url: '/recipes/' },
    { name: cat.name, url: `/category/${cat.id}/` },
    { name: d.title, url: path },
  ]),
];

const isDraft = d.reviewStatus === 'draft';
---

<BaseLayout
  title={`[Preview] ${d.title}`}
  description={d.description}
  path={path}
  image={ogSrc}
  imageAlt={d.imageAlt}
  type="article"
  noindex={true}
  jsonLd={jsonLd}
>
  <!-- Admin Preview Notification Bar -->
  <aside
    class="bg-forest text-cream px-6 py-3.5 flex flex-wrap justify-between items-center gap-4 sticky top-0 z-50 shadow-md border-b-2 border-terracotta"
    aria-label="Admin Preview Mode"
  >
    <div class="flex items-center gap-3 text-sm">
      <span
        class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white ${
          isDraft ? 'bg-amber-600' : 'bg-emerald-600'
        }`}
      >
        {isDraft ? <Clock size={14} aria-hidden="true" /> : <CircleCheck size={14} aria-hidden="true" />}
        <span>{isDraft ? 'Unpublished Draft' : 'Published'}</span>
      </span>
      <span class="text-cream/90 font-medium">
        {isDraft
          ? 'Draft Preview — Hidden from public visitors and search engines.'
          : 'Live Recipe — Visible to public visitors.'}
      </span>
    </div>

    <div class="flex items-center gap-2.5">
      <a
        href={`/admin/recipes/${recipe.id.replace(/\.md$/, '')}/`}
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white/15 text-white hover:bg-white/25 text-xs font-bold transition shadow-xs"
      >
        <FilePenLine size={14} aria-hidden="true" />
        <span>Edit Recipe</span>
      </a>
      <a
        href="/admin/"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-terracotta text-white hover:bg-terracotta-deep text-xs font-bold transition shadow-xs"
      >
        <ArrowLeft size={14} aria-hidden="true" />
        <span>Back to Admin</span>
      </a>
    </div>
  </aside>

  <!-- Recipe Details -->
  <RecipeDetail recipe={recipe as any} related={related as any}>
    {hasCustomIntro && <Content slot="intro" />}
  </RecipeDetail>
</BaseLayout>

