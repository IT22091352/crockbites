---
export const prerender = false;

// Ensure Cloudflare CDN and browsers never cache admin preview pages
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0, s-maxage=0');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import RecipeDetail from '../../../../components/RecipeDetail.astro';
import {
  ADMIN_COOKIE_NAME,
  getAdminSessionSecret,
  parseAdminSessionCookie,
  verifySessionCookie,
} from '../../../../lib/admin';
import { getLatestAdminRecipe } from '../../../../lib/admin-recipes';
import {
  categoryById,
  recipeUrl,
  relatedRecipes,
} from '../../../../utils/recipes';
import { breadcrumbSchema, recipeSchema } from '../../../../utils/jsonld';
import { ArrowLeft, FilePenLine, Clock, CircleCheck } from '@lucide/astro';

const adminCookie = Astro.cookies.get(ADMIN_COOKIE_NAME)?.value ?? '';
const session = parseAdminSessionCookie(adminCookie);
const secret = getAdminSessionSecret();

if (!secret || !session || !verifySessionCookie(adminCookie, secret)) {
  return Astro.redirect('/admin/login/?error=Please+log+in+to+preview+recipes');
}

const slug = String(Astro.params.slug ?? '').trim();
if (!slug) {
  return Astro.redirect('/admin/recipes/');
}

// Fetch the absolute latest recipe data from D1/cache (bypasses stale build bundle)
const latestRecipe = await getLatestAdminRecipe(slug, { fresh: true, locals: Astro.locals });

if (!latestRecipe) {
  return Astro.redirect('/admin/recipes/?error=Recipe+not+found');
}

// Load background static collection for related recipes and optional content rendering
const allRecipes = await getCollection('recipes');
const staticRecipe = allRecipes.find(
  (entry) =>
    entry.id.replace(/\.md$/, '') === slug ||
    (entry.data.slug ?? '').toLowerCase() === slug.toLowerCase()
);

let Content: any = null;
if (staticRecipe) {
  try {
    const rendered = await render(staticRecipe);
    Content = rendered.Content;
  } catch {}
}

// Construct the recipe object prioritizing the latest saved GitHub data
const rawPubDate = latestRecipe.data.pubDate instanceof Date
  ? latestRecipe.data.pubDate
  : new Date(latestRecipe.data.pubDate || staticRecipe?.data?.pubDate || Date.now());
const rawUpdated = latestRecipe.data.updatedDate || staticRecipe?.data?.updatedDate;
const rawUpdatedDate = rawUpdated ? (rawUpdated instanceof Date ? rawUpdated : new Date(rawUpdated)) : undefined;

const recipe = {
  id: latestRecipe.id,
  slug: latestRecipe.slug,
  body: latestRecipe.body,
  data: {
    ...staticRecipe?.data,
    ...latestRecipe.data,
    pubDate: isNaN(rawPubDate.getTime()) ? new Date() : rawPubDate,
    updatedDate: rawUpdatedDate && !isNaN(rawUpdatedDate.getTime()) ? rawUpdatedDate : undefined,
    related: Array.isArray(latestRecipe.data.related)
      ? latestRecipe.data.related
      : (Array.isArray(staticRecipe?.data?.related) ? staticRecipe.data.related : []),
    tags: Array.isArray(latestRecipe.data.tags)
      ? latestRecipe.data.tags
      : (Array.isArray(staticRecipe?.data?.tags) ? staticRecipe.data.tags : []),
    gallery: Array.isArray(latestRecipe.data.gallery)
      ? latestRecipe.data.gallery
      : (Array.isArray(staticRecipe?.data?.gallery) ? staticRecipe.data.gallery : []),
    ingredients: Array.isArray(latestRecipe.data.ingredients)
      ? latestRecipe.data.ingredients
      : (Array.isArray(staticRecipe?.data?.ingredients) ? staticRecipe.data.ingredients : []),
    instructions: Array.isArray(latestRecipe.data.instructions)
      ? latestRecipe.data.instructions
      : (Array.isArray(staticRecipe?.data?.instructions) ? staticRecipe.data.instructions : []),
    storage: (latestRecipe.data.storage && typeof latestRecipe.data.storage === 'object')
      ? latestRecipe.data.storage
      : ((staticRecipe?.data?.storage && typeof staticRecipe.data.storage === 'object') ? staticRecipe.data.storage : {}),
    equipment: Array.isArray(latestRecipe.data.equipment)
      ? latestRecipe.data.equipment
      : (Array.isArray(staticRecipe?.data?.equipment) ? staticRecipe.data.equipment : []),
    foodSafety: Array.isArray(latestRecipe.data.foodSafety)
      ? latestRecipe.data.foodSafety
      : (Array.isArray(staticRecipe?.data?.foodSafety) ? staticRecipe.data.foodSafety : []),
    servingSuggestions: Array.isArray(latestRecipe.data.servingSuggestions)
      ? latestRecipe.data.servingSuggestions
      : (Array.isArray(staticRecipe?.data?.servingSuggestions) ? staticRecipe.data.servingSuggestions : []),
    tips: Array.isArray(latestRecipe.data.tips)
      ? latestRecipe.data.tips
      : (Array.isArray(staticRecipe?.data?.tips) ? staticRecipe.data.tips : []),
    substitutions: Array.isArray(latestRecipe.data.substitutions)
      ? latestRecipe.data.substitutions
      : (Array.isArray(staticRecipe?.data?.substitutions) ? staticRecipe.data.substitutions : []),
    dietaryLabels: Array.isArray(latestRecipe.data.dietaryLabels)
      ? latestRecipe.data.dietaryLabels
      : (Array.isArray(staticRecipe?.data?.dietaryLabels) ? staticRecipe.data.dietaryLabels : []),
    dietaryVerified: Boolean(latestRecipe.data.dietaryVerified ?? staticRecipe?.data?.dietaryVerified),
    allergens: Array.isArray(latestRecipe.data.allergens)
      ? latestRecipe.data.allergens
      : (Array.isArray(staticRecipe?.data?.allergens) ? staticRecipe.data.allergens : []),
    allergenReviewed: Boolean(latestRecipe.data.allergenReviewed ?? staticRecipe?.data?.allergenReviewed),
    allergenNotes: latestRecipe.data.allergenNotes ?? staticRecipe?.data?.allergenNotes,
  },
};

const d = recipe.data;
const cat = categoryById(d.category) ?? { id: d.category || 'easy-dinners', name: d.category || 'Recipes', short: 'Recipes', description: '', icon: 'utensils' as const };
const related = relatedRecipes(allRecipes as any, recipe as any, 3);

const rawBody = (recipe.body ?? '').trim();
const hasCustomIntro = Boolean(rawBody && rawBody !== (d.description ?? '').trim());

let ogSrc: string;
if (typeof d.image === 'string' && (d.image.startsWith('http://') || d.image.startsWith('https://'))) {
  ogSrc = d.image;
} else {
  try {
    const og = await getImage({ src: d.image as any, width: 1200 });
    ogSrc = og.src;
  } catch {
    ogSrc = typeof d.image === 'string' ? d.image : '/placeholder.svg';
  }
}

const path = recipeUrl(recipe as any);
const jsonLd = [
  recipeSchema(recipe as any, new URL(ogSrc, Astro.site ?? 'https://crockbites.site').href, cat.name),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Recipes', url: '/recipes/' },
    { name: cat.name, url: `/category/${cat.id}/` },
    { name: d.title, url: path },
  ]),
];

const isDraft = d.reviewStatus === 'draft';
---

<BaseLayout
  title={`[Preview] ${d.title}`}
  description={d.description}
  path={path}
  image={ogSrc}
  imageAlt={d.imageAlt}
  type="article"
  noindex={true}
  jsonLd={jsonLd}
>
  <!-- Admin Preview Notification Bar -->
  <aside
    class="bg-forest text-cream px-6 py-3.5 flex flex-wrap justify-between items-center gap-4 sticky top-0 z-50 shadow-md border-b-2 border-terracotta"
    aria-label="Admin Preview Mode"
  >
    <div class="flex items-center gap-3 text-sm">
      <span
        class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider text-white ${
          isDraft ? 'bg-amber-600' : 'bg-emerald-600'
        }`}
      >
        {isDraft ? <Clock size={14} aria-hidden="true" /> : <CircleCheck size={14} aria-hidden="true" />}
        <span>{isDraft ? 'Unpublished Draft' : 'Published'}</span>
      </span>
      <span class="text-cream/90 font-medium">
        {isDraft
          ? 'Draft Preview — Hidden from public visitors and search engines.'
          : 'Live Recipe — Visible to public visitors.'}
      </span>
    </div>

    <div class="flex items-center gap-2.5">
      <a
        href={`/admin/recipes/${recipe.slug}/`}
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white/15 text-white hover:bg-white/25 text-xs font-bold transition shadow-xs"
      >
        <FilePenLine size={14} aria-hidden="true" />
        <span>Edit Recipe</span>
      </a>
      <a
        href="/admin/recipes/?status=draft"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-terracotta text-white hover:bg-terracotta-deep text-xs font-bold transition shadow-xs"
      >
        <ArrowLeft size={14} aria-hidden="true" />
        <span>Back to Drafts</span>
      </a>
    </div>
  </aside>

  <!-- Recipe Details -->
  <RecipeDetail recipe={recipe as any} related={related as any}>
    {hasCustomIntro && (Content ? <Content slot="intro" /> : <div slot="intro" class="prose-crock whitespace-pre-line">{rawBody}</div>)}
  </RecipeDetail>
</BaseLayout>
