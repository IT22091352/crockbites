---
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  CSRF_COOKIE_NAME,
  createCsrfToken,
  getAdminSessionSecret,
  parseAdminSessionCookie,
  verifySessionCookie,
} from '../../../lib/admin';
import { getGithubConfig } from '../../../lib/github';
import { isCloudinaryConfigured } from '../../../lib/cloudinary';
import { ArrowLeft, Eye, Trash } from '@lucide/astro';

const sessionCookie = Astro.cookies.get('crockbites_admin_session')?.value ?? '';
const secret = getAdminSessionSecret();
const session = parseAdminSessionCookie(sessionCookie);

if (!secret || !session || !verifySessionCookie(sessionCookie, secret)) {
  return Astro.redirect('/admin/login/?error=Session+expired');
}

const slugParam = String(Astro.params.slug ?? '').trim();
if (!slugParam) {
  return Astro.redirect('/admin/recipes/');
}

const recipes = await getCollection('recipes');
const recipe = recipes.find(
  (entry) =>
    entry.id.replace(/\.md$/, '') === slugParam ||
    (entry.data.slug ?? '').toLowerCase() === slugParam.toLowerCase()
);

if (!recipe) {
  return Astro.redirect('/admin/recipes/?error=Recipe+not+found');
}

const csrfToken = createCsrfToken(secret, session.id);
const isHttps = Astro.url.protocol === 'https:';
Astro.cookies.set(CSRF_COOKIE_NAME, csrfToken, {
  httpOnly: false,
  sameSite: 'lax',
  secure: isHttps,
  path: '/',
  maxAge: 60 * 60 * 12,
});

const ghActive = Boolean(getGithubConfig().token);
const cloudinaryActive = isCloudinaryConfigured();

const categories = [
  ['slow-cooker-chicken', 'Slow Cooker Chicken'],
  ['beef-pork', 'Beef & Pork'],
  ['soups-stews', 'Soups & Stews'],
  ['easy-dinners', 'Easy Dinners'],
  ['breakfast', 'Breakfast'],
  ['vegetarian', 'Vegetarian'],
  ['desserts-baking', 'Desserts & Baking'],
];

const initialRecipe = {
  title: recipe.data.title,
  slug: recipe.id.replace(/\.md$/, ''),
  description: recipe.data.description,
  category: recipe.data.category,
  tags: recipe.data.tags,
  image: typeof recipe.data.image === 'string' ? recipe.data.image : (recipe.data.image as any)?.src || '/placeholder.svg',
  imageAlt: recipe.data.imageAlt,
  gallery: (recipe.data as any).gallery || [],
  author: recipe.data.author || 'CrockBites',
  prepMinutes: recipe.data.prepMinutes,
  cookMinutes: recipe.data.cookMinutes,
  cookTimeNote: recipe.data.cookTimeNote || '',
  servings: recipe.data.servings,
  reviewStatus: recipe.data.reviewStatus,
  ingredients: recipe.data.ingredients,
  instructions: recipe.data.instructions,
  tips: recipe.data.tips || [],
  equipment: recipe.data.equipment || [],
  foodSafety: recipe.data.foodSafety || [],
  nutrition: recipe.data.nutrition,
  dietaryLabels: recipe.data.dietaryLabels || [],
  dietaryVerified: Boolean(recipe.data.dietaryVerified),
  allergens: recipe.data.allergens || [],
  allergenReviewed: Boolean(recipe.data.allergenReviewed),
  allergenNotes: recipe.data.allergenNotes || '',
  body: recipe.body || '',
};

const isDraft = initialRecipe.reviewStatus === 'draft';
---

<AdminLayout
  title={`Edit ${initialRecipe.title}`}
  subtitle="Update recipe details, ingredients, cooking steps, or publication status."
  activeNav={isDraft ? 'drafts' : 'recipes'}
  breadcrumbs={[
    {
      label: isDraft ? 'Drafts' : 'Recipes',
      href: isDraft ? '/admin/recipes/?status=draft' : '/admin/recipes/',
    },
    { label: `Edit: ${initialRecipe.title}` },
  ]}
>
  <div slot="actions" class="flex flex-wrap items-center gap-2">
    {initialRecipe.reviewStatus === 'tested' ? (
      <a
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-forest-soft/10 text-forest text-sm font-semibold hover:bg-forest-soft/20 transition cursor-pointer"
        href={`/recipe/${initialRecipe.slug}/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Eye size={16} aria-hidden="true" />
        <span>View Live</span>
      </a>
    ) : (
      <a
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-terracotta/10 text-terracotta-deep text-sm font-semibold hover:bg-terracotta/20 transition cursor-pointer"
        href={`/admin/recipes/preview/${initialRecipe.slug}/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Eye size={16} aria-hidden="true" />
        <span>Preview Draft</span>
      </a>
    )}
    <a
      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-line bg-white text-ink text-sm font-semibold hover:bg-cream/50 transition cursor-pointer shadow-xs"
      href={isDraft ? '/admin/recipes/?status=draft' : '/admin/recipes/'}
    >
      <ArrowLeft size={16} aria-hidden="true" />
      <span>Back to recipes</span>
    </a>
  </div>

  <div class="space-y-6 max-w-4xl">
    {!ghActive && (
      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
        ⚠️ <strong>GitHub publishing is not configured.</strong> Updates cannot be committed until repository credentials are set in <a href="/admin/settings/" class="underline font-bold">Settings</a>.
      </div>
    )}

    <form id="recipe-form" class="card stack" data-slug={initialRecipe.slug}>
      <input type="hidden" name="csrfToken" value={csrfToken} />
      <input type="hidden" name="reviewStatus" id="reviewStatusInput" value={initialRecipe.reviewStatus} />

      <!-- Essential: Recipe Overview -->
      <div class="section-box">
        <h2 class="text-base font-bold text-forest mb-4">Recipe Overview</h2>
        <div class="grid">
          <label>
            Recipe Title *
            <input name="title" id="titleInput" value={initialRecipe.title} required />
          </label>
          <label>
            SEO Slug * <span class="hint">(Keep consistent unless renaming)</span>
            <input name="slug" id="slugInput" value={initialRecipe.slug} />
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Category *
            <select name="category">
              {categories.map(([value, label]) => (
                <option value={value} selected={value === initialRecipe.category}>{label}</option>
              ))}
            </select>
          </label>
          <label>
            Author
            <input name="author" value={initialRecipe.author} />
          </label>
        </div>

        <div style="margin-top: 1rem;">
          <label>
            Short Description / SEO Summary *
            <textarea name="description" required>{initialRecipe.description}</textarea>
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Prep Time (Minutes) *
            <input name="prepMinutes" type="number" min="0" value={initialRecipe.prepMinutes} required />
          </label>
          <label>
            Cook Time (Minutes) *
            <input name="cookMinutes" type="number" min="0" value={initialRecipe.cookMinutes} required />
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Slow Cooker Setting *
            <select name="slowCookerSetting" id="slowCookerSettingSelect">
              <option value="Low (6 to 8 hours)" selected={initialRecipe.cookTimeNote.toLowerCase().includes('low')}>Low (6 to 8 hours)</option>
              <option value="High (3 to 4 hours)" selected={initialRecipe.cookTimeNote.toLowerCase().includes('high')}>High (3 to 4 hours)</option>
              <option value="Low or High Dual" selected={initialRecipe.cookTimeNote.toLowerCase().includes('or')}>Low or High Dual</option>
              <option value="Warm">Warm</option>
            </select>
          </label>
          <label>
            Servings *
            <input name="servings" type="number" min="1" value={initialRecipe.servings} required />
          </label>
        </div>

        <div style="margin-top: 1rem;">
          <label>
            Cook Time Note <span class="hint">(e.g. 6 to 8 hours on LOW or 3 to 4 hours on HIGH)</span>
            <input name="cookTimeNote" id="cookTimeNoteInput" value={initialRecipe.cookTimeNote} placeholder="e.g. 6 to 8 hours on LOW" />
          </label>
        </div>
      </div>

      <!-- Essential: Main Recipe Image -->
      <div class="section-box">
        <h2 class="text-base font-bold text-forest mb-4">Main Recipe Image</h2>
        <div class="dropzone" id="imageDropzone">
          <input type="file" id="imageFileInput" accept="image/jpeg,image/png,image/webp,image/avif" style="display: none;" />
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📸</div>
          <p style="margin: 0; font-weight: 700; font-size: 1rem;">Drag &amp; drop main recipe photo here, or click to replace</p>
          <p class="hint" style="margin: 0.25rem 0 0;">Uploads to Cloudinary (JPEG, PNG, WebP, AVIF up to 8 MB)</p>
          <div id="uploadProgress" style="display: none; margin-top: 0.75rem; font-weight: 700; color: var(--terracotta);">
            Uploading to Cloudinary...
          </div>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Image URL
            <input name="image" id="primaryImageUrl" value={initialRecipe.image} />
          </label>
          <label>
            Image Alt Text *
            <input name="imageAlt" id="primaryImageAlt" value={initialRecipe.imageAlt} required />
          </label>
        </div>
      </div>

      <!-- Essential: Ingredients -->
      <div class="section-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 class="text-base font-bold text-forest m-0">Ingredients *</h2>
          <button type="button" class="btn btn-subtle btn-pill" id="addIngredientBtn">+ Add Ingredient</button>
        </div>
        <div id="ingredientList" class="stack"></div>
      </div>

      <!-- Essential: Instructions -->
      <div class="section-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 class="text-base font-bold text-forest m-0">Step-by-Step Instructions *</h2>
          <button type="button" class="btn btn-subtle btn-pill" id="addInstructionBtn">+ Add Step</button>
        </div>
        <div id="instructionList" class="stack"></div>
      </div>

      <!-- Collapsible: Advanced Details (Optional) -->
      <details class="section-box cursor-pointer group">
        <summary class="font-bold text-base text-forest flex items-center justify-between py-1 select-none">
          <span>Advanced Details (Optional)</span>
          <span class="text-xs text-ink-soft group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="pt-5 space-y-6 border-t border-line/60 mt-4 cursor-default">
          <!-- Difficulty & Tags -->
          <div class="grid">
            <label>
              Difficulty
              <select name="difficulty" id="difficultySelect">
                <option value="Easy">Easy</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </label>
            <label>
              Tags <span class="hint">(Comma-separated)</span>
              <input name="tags" value={initialRecipe.tags.join(', ')} placeholder="dinner, chicken, easy, comfort food" />
            </label>
          </div>

          <!-- Additional Gallery Images -->
          <div>
            <label class="font-bold text-sm text-forest mb-2 block">
              Additional Gallery Images
              <span class="hint font-normal block mt-0.5">Extra step-by-step or plated dish photos</span>
            </label>
            <div class="gallery-grid" id="galleryContainer" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 220px)); gap: 1rem; margin-top: 0.5rem;"></div>
          </div>

          <!-- Dietary Labels -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Dietary Labels</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              {['vegetarian', 'vegan', 'gluten-free', 'dairy-free', 'nut-free', 'low-carb', 'keto-friendly', 'high-protein', 'low-sodium', 'pescatarian'].map((label) => (
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: normal; cursor: pointer; font-size: 0.9rem;">
                  <input type="checkbox" name="dietaryLabels" value={label} checked={initialRecipe.dietaryLabels.includes(label as any)} />
                  <span class="capitalize">{label.replace('-', ' ')}</span>
                </label>
              ))}
            </div>
            <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; color: var(--forest); margin-top: 0.75rem; font-size: 0.85rem;">
              <input type="checkbox" name="dietaryVerified" id="dietaryVerifiedInput" checked={initialRecipe.dietaryVerified} />
              Dietary claims reviewed and verified.
            </label>
          </div>

          <!-- Allergen Information -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Major Food Allergens</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              {['milk', 'eggs', 'fish', 'crustacean-shellfish', 'tree-nuts', 'peanuts', 'wheat', 'soybeans', 'sesame'].map((allergen) => (
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: normal; cursor: pointer; font-size: 0.9rem;">
                  <input type="checkbox" name="allergens" value={allergen} checked={initialRecipe.allergens.includes(allergen as any)} />
                  <span class="capitalize">{allergen.replace('-', ' ')}</span>
                </label>
              ))}
            </div>
            <div style="margin-top: 0.75rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; color: var(--forest); font-size: 0.85rem;">
                <input type="checkbox" name="allergenReviewed" id="allergenReviewedInput" checked={initialRecipe.allergenReviewed} />
                Allergens explicitly reviewed.
              </label>
              <input type="text" name="allergenNotes" value={initialRecipe.allergenNotes} placeholder="Allergen notes or substitutions (optional)" style="margin-top: 0.5rem;" />
            </div>
          </div>

          <!-- Nutrition Panel -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Nutrition Information (Optional - Leave blank if unverified)</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              <label>Calories<input type="number" step="any" min="0" name="nutrition_calories" value={initialRecipe.nutrition?.calories ?? ''} placeholder="385" /></label>
              <label>Protein (g)<input type="number" step="any" min="0" name="nutrition_proteinGrams" value={initialRecipe.nutrition?.proteinGrams ?? ''} placeholder="34" /></label>
              <label>Carbs (g)<input type="number" step="any" min="0" name="nutrition_carbsGrams" value={initialRecipe.nutrition?.carbsGrams ?? ''} placeholder="12" /></label>
              <label>Fat (g)<input type="number" step="any" min="0" name="nutrition_fatGrams" value={initialRecipe.nutrition?.fatGrams ?? ''} placeholder="16" /></label>
              <label>Sat Fat (g)<input type="number" step="any" min="0" name="nutrition_saturatedFatGrams" value={initialRecipe.nutrition?.saturatedFatGrams ?? ''} placeholder="4" /></label>
              <label>Fiber (g)<input type="number" step="any" min="0" name="nutrition_fiberGrams" value={initialRecipe.nutrition?.fiberGrams ?? ''} placeholder="3" /></label>
              <label>Sodium (mg)<input type="number" step="any" min="0" name="nutrition_sodiumMilligrams" value={initialRecipe.nutrition?.sodiumMilligrams ?? ''} placeholder="640" /></label>
            </div>
          </div>

          <!-- Notes & Food Safety -->
          <div class="space-y-3">
            <label>
              Food Safety Notes
              <textarea name="foodSafety">{initialRecipe.foodSafety.join('\n')}</textarea>
            </label>
            <label>
              Kitchen Tips
              <textarea name="tips">{initialRecipe.tips.join('\n')}</textarea>
            </label>
            <label>
              Equipment
              <textarea name="equipment">{initialRecipe.equipment.join('\n')}</textarea>
            </label>
            <label>
              Editorial Story / Intro Body
              <textarea name="body">{initialRecipe.body}</textarea>
            </label>
          </div>
        </div>
      </details>

      <!-- Submission Actions -->
      <div class="pt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line/60">
        <a class="btn btn-subtle" href="/admin/recipes/">Cancel</a>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="saveDraftBtn"
            class="btn btn-subtle"
            style="font-weight: 700;"
          >
            Save as Draft
          </button>
          <button
            type="button"
            id="publishBtn"
            class="btn btn-primary"
            style="background: #243A2D;"
          >
            Publish Recipe
          </button>
        </div>
      </div>

      <div id="formStatus" class="status" aria-live="polite"></div>

      <!-- Delete Recipe Zone -->
      <div class="mt-8 pt-6 border-t border-line/70 flex items-center justify-between text-xs text-ink-soft">
        <span>Permanently delete this recipe and clean up Git storage:</span>
        <button
          type="button"
          id="deleteRecipeBtn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
        >
          <Trash size={14} aria-hidden="true" />
          <span>Delete Recipe</span>
        </button>
      </div>
    </form>
  </div>
</AdminLayout>

<style is:global>
  .card { background: rgba(255,255,255,0.95); border: 1px solid var(--line); border-radius: 20px; padding: 1.75rem; box-shadow: 0 4px 14px rgba(36,58,45,0.04); }
  .section-box { border: 1px solid var(--line); border-radius: 16px; padding: 1.35rem; background: var(--paper); margin-bottom: 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem; }
  .stack { display: grid; gap: 1.25rem; }
  label { display: grid; gap: 0.45rem; font-weight: 700; font-size: 0.95rem; }
  input, textarea, select { width: 100%; border: 1px solid rgba(36,58,45,0.2); border-radius: 12px; padding: 0.85rem 1rem; font: inherit; background: #fff; color: var(--forest); }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--terracotta); border-color: transparent; }
  textarea { min-height: 90px; resize: vertical; }
  .hint { font-size: 0.82rem; font-weight: normal; color: rgba(36,58,45,0.7); }
  .item-row { display: grid; grid-template-columns: 100px 140px 1fr 1fr auto; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; background: #fff; padding: 0.65rem; border-radius: 12px; border: 1px solid var(--line); }
  .step-row { display: grid; grid-template-columns: 180px 1fr auto; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; background: #fff; padding: 0.65rem; border-radius: 12px; border: 1px solid var(--line); }
  .btn { border: none; border-radius: 10px; padding: 0.8rem 1.25rem; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s ease; font-size: 0.9rem; }
  .btn-primary { background: var(--forest); color: #fff; }
  .btn-primary:hover { background: #18281f; }
  .btn-subtle { background: rgba(36,58,45,0.08); color: var(--forest); }
  .btn-subtle:hover { background: rgba(36,58,45,0.14); }
  .btn-danger { background: rgba(198,106,69,0.12); color: var(--terracotta); padding: 0.65rem 0.9rem; }
  .btn-danger:hover { background: rgba(198,106,69,0.22); }
  .btn-pill { border-radius: 999px; font-size: 0.8rem; padding: 0.35rem 0.75rem; }

  .dropzone { border: 2px dashed rgba(36,58,45,0.25); border-radius: 16px; padding: 1.75rem 1.25rem; text-align: center; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; background: rgba(255,255,255,0.6); }
  .dropzone.dragover { border-color: var(--terracotta); background: rgba(198,106,69,0.06); }
  .status { margin-top: 1.25rem; padding: 1rem 1.25rem; border-radius: 12px; display: none; font-weight: 600; }
  .status.error { background: #ffebee; color: #c62828; display: block; border: 1px solid #ffcdd2; }
  .status.success { background: #e8f5e9; color: #2e7d32; display: block; border: 1px solid #c8e6c9; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .item-row, .step-row { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ initialRecipe }}>
  let images = initialRecipe.gallery || [];

  const csrfInput = document.querySelector('input[name="csrfToken"]');
  const csrfToken = csrfInput ? csrfInput.value : '';

  const dropzone = document.getElementById('imageDropzone');
  const fileInput = document.getElementById('imageFileInput');
  const progressEl = document.getElementById('uploadProgress');
  const primaryUrlEl = document.getElementById('primaryImageUrl');
  const primaryAltEl = document.getElementById('primaryImageAlt');
  const titleInput = document.getElementById('titleInput');
  const slugInput = document.getElementById('slugInput');
  const form = document.getElementById('recipe-form');
  const formStatus = document.getElementById('formStatus');
  const saveDraftBtn = document.getElementById('saveDraftBtn');
  const publishBtn = document.getElementById('publishBtn');
  const reviewStatusInput = document.getElementById('reviewStatusInput');
  const deleteBtn = document.getElementById('deleteRecipeBtn');

  // Slow cooker setting sync with cookTimeNote
  const slowCookerSelect = document.getElementById('slowCookerSettingSelect');
  const cookTimeNoteInput = document.getElementById('cookTimeNoteInput');
  slowCookerSelect?.addEventListener('change', () => {
    if (!cookTimeNoteInput.dataset.manual) {
      cookTimeNoteInput.value = slowCookerSelect.value;
    }
  });
  cookTimeNoteInput?.addEventListener('input', () => {
    cookTimeNoteInput.dataset.manual = 'true';
  });

  // Upload Logic
  dropzone?.addEventListener('click', () => fileInput?.click());
  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });
  dropzone?.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    if (e.dataTransfer?.files) {
      uploadFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileInput?.addEventListener('change', () => {
    if (fileInput.files) {
      uploadFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  async function uploadFiles(files) {
    if (files.length === 0) return;
    if (progressEl) progressEl.style.display = 'block';

    const formData = new FormData();
    files.forEach((f) => formData.append('images', f));

    try {
      const res = await fetch('/api/admin/images/upload/', {
        method: 'POST',
        headers: { 'x-csrf-token': csrfToken },
        body: formData,
      });

      const json = await res.json();
      if (!res.ok) {
        alert(json.error || 'Failed to upload images to Cloudinary.');
        return;
      }

      if (Array.isArray(json.images) && json.images.length > 0) {
        const first = json.images[0];
        if (primaryUrlEl) primaryUrlEl.value = first.url;
        if (first.originalName && primaryAltEl) {
          primaryAltEl.value = first.originalName.replace(/\.[^/.]+$/, '');
        }
      }
    } catch (err) {
      alert('Upload failed: ' + (err instanceof Error ? err.message : String(err)));
    } finally {
      if (progressEl) progressEl.style.display = 'none';
    }
  }

  // Ingredients & Instructions dynamic builders
  const ingredientList = document.getElementById('ingredientList');
  const instructionList = document.getElementById('instructionList');

  function createIngredientRow(data = {}) {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML = `
      <input type="number" step="0.25" placeholder="Qty" value="${data.quantity ?? ''}" class="ing-qty" />
      <input type="text" placeholder="Unit (cup, lb)" value="${data.unit ?? ''}" class="ing-unit" />
      <input type="text" placeholder="Ingredient *" value="${data.item ?? ''}" required class="ing-item" />
      <input type="text" placeholder="Note (diced, etc.)" value="${data.note ?? ''}" class="ing-note" />
      <button type="button" class="btn btn-danger btn-pill" onclick="this.closest('.item-row').remove()">✕</button>
    `;
    return row;
  }

  function createInstructionRow(data = {}) {
    const row = document.createElement('div');
    row.className = 'step-row';
    row.innerHTML = `
      <input type="text" placeholder="Step title (optional)" value="${data.title ?? ''}" class="step-title" />
      <input type="text" placeholder="Instruction text *" value="${data.text ?? ''}" required class="step-text" />
      <button type="button" class="btn btn-danger btn-pill" onclick="this.closest('.step-row').remove()">✕</button>
    `;
    return row;
  }

  document.getElementById('addIngredientBtn')?.addEventListener('click', () => {
    ingredientList?.appendChild(createIngredientRow());
  });
  document.getElementById('addInstructionBtn')?.addEventListener('click', () => {
    instructionList?.appendChild(createInstructionRow());
  });

  // Populate initial rows
  if (Array.isArray(initialRecipe.ingredients) && initialRecipe.ingredients.length > 0) {
    initialRecipe.ingredients.forEach((ing) => ingredientList?.appendChild(createIngredientRow(ing)));
  } else {
    ingredientList?.appendChild(createIngredientRow({ quantity: 2, unit: 'lb', item: 'chicken breast' }));
  }

  if (Array.isArray(initialRecipe.instructions) && initialRecipe.instructions.length > 0) {
    initialRecipe.instructions.forEach((ins) => instructionList?.appendChild(createInstructionRow(ins)));
  } else {
    instructionList?.appendChild(createInstructionRow({ text: 'Place all ingredients into the slow cooker and cook on low.' }));
  }

  // Submit Recipe
  async function submitRecipe(targetStatus) {
    if (reviewStatusInput) reviewStatusInput.value = targetStatus;

    if (saveDraftBtn) saveDraftBtn.disabled = true;
    if (publishBtn) publishBtn.disabled = true;
    if (formStatus) {
      formStatus.className = 'status';
      formStatus.style.display = 'block';
      formStatus.textContent = 'Saving recipe changes to GitHub...';
    }

    const ingredients = Array.from(ingredientList?.querySelectorAll('.item-row') || []).map((row) => {
      const qty = row.querySelector('.ing-qty').value;
      const unit = row.querySelector('.ing-unit').value.trim();
      const item = row.querySelector('.ing-item').value.trim();
      const note = row.querySelector('.ing-note').value.trim();
      if (!item) return null;
      return {
        quantity: qty ? parseFloat(qty) : undefined,
        unit: unit || undefined,
        item,
        note: note || undefined,
      };
    }).filter(Boolean);

    const instructions = Array.from(instructionList?.querySelectorAll('.step-row') || []).map((row) => {
      const title = row.querySelector('.step-title').value.trim();
      const text = row.querySelector('.step-text').value.trim();
      if (!text) return null;
      return { title: title || undefined, text };
    }).filter(Boolean);

    const getNutrVal = (n) => {
      const el = form?.querySelector(`[name="${n}"]`);
      return el && el.value.trim() !== '' ? el.value.trim() : undefined;
    };

    const nutritionObj = {
      calories: getNutrVal('nutrition_calories'),
      proteinGrams: getNutrVal('nutrition_proteinGrams'),
      carbsGrams: getNutrVal('nutrition_carbsGrams'),
      fatGrams: getNutrVal('nutrition_fatGrams'),
      saturatedFatGrams: getNutrVal('nutrition_saturatedFatGrams'),
      fiberGrams: getNutrVal('nutrition_fiberGrams'),
      sodiumMilligrams: getNutrVal('nutrition_sodiumMilligrams'),
    };
    const hasNutrition = Object.values(nutritionObj).some((v) => v !== undefined);

    const selectedDietaryLabels = Array.from(form?.querySelectorAll('input[name="dietaryLabels"]:checked') || []).map((el) => el.value);
    const isDietaryVerified = form?.querySelector('input[name="dietaryVerified"]')?.checked ?? false;
    const selectedAllergens = Array.from(form?.querySelectorAll('input[name="allergens"]:checked') || []).map((el) => el.value);
    const isAllergenReviewed = form?.querySelector('input[name="allergenReviewed"]')?.checked ?? false;
    const allergenNotesVal = form?.querySelector('input[name="allergenNotes"]')?.value.trim() || undefined;

    const cookTimeNoteVal = form?.querySelector('[name="cookTimeNote"]')?.value.trim() || undefined;
    const foodSafetyLines = (form?.querySelector('[name="foodSafety"]')?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const tipsLines = (form?.querySelector('[name="tips"]')?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const equipmentLines = (form?.querySelector('[name="equipment"]')?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const bodyVal = (form?.querySelector('[name="body"]')?.value || '').trim() || undefined;

    const payload = {
      title: form?.querySelector('[name="title"]')?.value.trim(),
      slug: form?.querySelector('[name="slug"]')?.value.trim(),
      description: form?.querySelector('[name="description"]')?.value.trim(),
      category: form?.querySelector('[name="category"]')?.value,
      author: form?.querySelector('[name="author"]')?.value.trim() || 'CrockBites',
      prepMinutes: parseInt(form?.querySelector('[name="prepMinutes"]')?.value) || 0,
      cookMinutes: parseInt(form?.querySelector('[name="cookMinutes"]')?.value) || 0,
      cookTimeNote: cookTimeNoteVal,
      servings: parseInt(form?.querySelector('[name="servings"]')?.value) || 1,
      reviewStatus: targetStatus,
      tags: (form?.querySelector('[name="tags"]')?.value || '').split(',').map((s) => s.trim()).filter(Boolean),
      image: primaryUrlEl?.value.trim(),
      imageAlt: primaryAltEl?.value.trim(),
      gallery: images,
      ingredients,
      instructions,
      foodSafety: foodSafetyLines,
      tips: tipsLines,
      equipment: equipmentLines,
      body: bodyVal,
      dietaryLabels: selectedDietaryLabels,
      dietaryVerified: isDietaryVerified,
      allergens: selectedAllergens,
      allergenReviewed: isAllergenReviewed,
      allergenNotes: allergenNotesVal,
      nutrition: hasNutrition ? nutritionObj : undefined,
    };

    if (!payload.title || !payload.description || ingredients.length === 0 || instructions.length === 0) {
      if (formStatus) {
        formStatus.className = 'status error';
        formStatus.textContent = 'Please provide a title, description, at least one ingredient, and one instruction.';
      }
      if (saveDraftBtn) saveDraftBtn.disabled = false;
      if (publishBtn) publishBtn.disabled = false;
      return;
    }

    try {
      const res = await fetch(`/api/admin/recipes/${initialRecipe.slug}/`, {
        method: 'PUT',
        headers: {
          'content-type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        if (formStatus) {
          formStatus.className = 'status error';
          formStatus.textContent = data.error || 'Failed to update recipe.';
        }
        if (saveDraftBtn) saveDraftBtn.disabled = false;
        if (publishBtn) publishBtn.disabled = false;
        return;
      }

      if (formStatus) {
        formStatus.className = 'status success';
        formStatus.textContent = `✓ Recipe successfully updated to ${targetStatus === 'tested' ? 'published' : 'draft'} status!`;
      }
      setTimeout(() => {
        window.location.href = targetStatus === 'tested' ? '/admin/recipes/' : '/admin/recipes/?status=draft';
      }, 1000);
    } catch (err) {
      if (formStatus) {
        formStatus.className = 'status error';
        formStatus.textContent = 'Network error: ' + (err instanceof Error ? err.message : String(err));
      }
      if (saveDraftBtn) saveDraftBtn.disabled = false;
      if (publishBtn) publishBtn.disabled = false;
    }
  }

  saveDraftBtn?.addEventListener('click', () => submitRecipe('draft'));
  publishBtn?.addEventListener('click', () => submitRecipe('tested'));

  // Delete Recipe
  deleteBtn?.addEventListener('click', async () => {
    const confirmed = window.confirm(`Permanently delete "${initialRecipe.title}"? This will delete the recipe file from GitHub. This action cannot be undone.`);
    if (!confirmed) return;

    deleteBtn.disabled = true;
    try {
      const res = await fetch(`/api/admin/recipes/${initialRecipe.slug}/`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Delete failed.');
      }

      window.location.href = '/admin/recipes/';
    } catch (err) {
      alert(err instanceof Error ? err.message : 'Delete failed.');
      deleteBtn.disabled = false;
    }
  });
</script>
