---
export const prerender = false;

// Ensure Cloudflare CDN and browsers never cache admin recipe management pages
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0, s-maxage=0');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Cloudflare-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getAdminRecipeList } from '../../../lib/admin-recipes';
import {
  CirclePlus,
  Search,
  ListFilter,
  RotateCcw,
  RefreshCw,
  Eye,
  FilePenLine,
  Trash,
  CircleCheck,
  Clock,
  ArrowUpRight,
} from '@lucide/astro';

// Read initial URL filters
const statusParam = Astro.url.searchParams.get('status') || 'all';
const categoryParam = Astro.url.searchParams.get('category') || 'all';
const queryParam = Astro.url.searchParams.get('q') || '';

// Load admin recipes from unified source (Astro content + GitHub + runtime cache)
const recipesWithMeta = await getAdminRecipeList();

const publishedCount = recipesWithMeta.filter((r) => r.reviewStatus === 'tested').length;
const draftsCount = recipesWithMeta.filter((r) => r.reviewStatus === 'draft').length;

const activeNav = statusParam === 'draft' ? 'drafts' : 'recipes';
---

<AdminLayout
  title={statusParam === 'draft' ? 'Draft Recipes' : 'Recipe Management'}
  subtitle="Search, filter, edit, and organize your slow cooker recipe catalog."
  activeNav={activeNav}
  breadcrumbs={[{ label: 'Recipes' }]}
>
  <!-- Topbar Action Slot -->
  <div slot="actions">
    <a
      href="/admin/recipes/new/"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-forest text-cream font-bold text-sm hover:bg-forest-deep shadow-xs transition hover:scale-[1.02] cursor-pointer"
    >
      <CirclePlus size={16} aria-hidden="true" />
      <span>New Recipe</span>
    </a>
  </div>

  <div class="space-y-6">
    <!-- Success / Action Flash Notification Banner -->
    <div
      id="adminFlashBanner"
      class="hidden rounded-2xl p-4 border transition-all duration-300"
      role="alert"
    >
      <div class="flex items-start justify-between gap-3">
        <div class="flex items-center gap-3">
          <div id="flashBannerIcon" class="size-9 rounded-xl flex items-center justify-center shrink-0"></div>
          <div>
            <h3 id="flashBannerTitle" class="text-sm font-bold font-display"></h3>
            <p id="flashBannerMessage" class="text-xs mt-0.5"></p>
          </div>
        </div>
        <button
          type="button"
          id="closeFlashBtn"
          class="text-ink-soft hover:text-ink p-1 rounded-lg hover:bg-black/5 transition cursor-pointer"
          aria-label="Close notification"
        >
          <span class="text-lg leading-none" aria-hidden="true">&times;</span>
        </button>
      </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-ink-soft">
            <Search size={18} aria-hidden="true" />
          </div>
          <input
            id="searchInput"
            type="search"
            value={queryParam}
            placeholder="Search recipes by title..."
            aria-label="Search recipes"
            class="w-full pl-10 pr-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest focus:border-forest transition"
          />
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Category Filter -->
          <div class="relative flex items-center">
            <label for="categoryFilter" class="sr-only">Filter by category</label>
            <div class="absolute left-3 pointer-events-none text-ink-soft">
              <ListFilter size={16} aria-hidden="true" />
            </div>
            <select
              id="categoryFilter"
              aria-label="Filter by category"
              class="pl-9 pr-8 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition appearance-none"
            >
              <option value="all" selected={categoryParam === 'all'}>All Categories</option>
              <option value="slow-cooker-chicken" selected={categoryParam === 'slow-cooker-chicken'}>Slow Cooker Chicken</option>
              <option value="beef-pork" selected={categoryParam === 'beef-pork'}>Beef &amp; Pork</option>
              <option value="soups-stews" selected={categoryParam === 'soups-stews'}>Soups &amp; Stews</option>
              <option value="easy-dinners" selected={categoryParam === 'easy-dinners'}>Easy Dinners</option>
              <option value="breakfast" selected={categoryParam === 'breakfast'}>Breakfast</option>
              <option value="vegetarian" selected={categoryParam === 'vegetarian'}>Vegetarian</option>
              <option value="desserts-baking" selected={categoryParam === 'desserts-baking'}>Desserts &amp; Baking</option>
            </select>
          </div>

          <!-- Status Filter -->
          <div class="relative flex items-center">
            <label for="statusFilter" class="sr-only">Filter by status</label>
            <select
              id="statusFilter"
              aria-label="Filter by status"
              class="px-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition"
            >
              <option value="all" selected={statusParam === 'all'}>All Status</option>
              <option value="tested" selected={statusParam === 'tested'}>Published</option>
              <option value="draft" selected={statusParam === 'draft'}>Draft</option>
            </select>
          </div>

          <!-- Refresh List Button -->
          <button
            type="button"
            id="refreshListBtn"
            class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold text-ink-soft hover:text-forest bg-cream/80 hover:bg-cream rounded-xl border border-line/70 transition cursor-pointer"
            title="Refresh recipe list from GitHub"
          >
            <RefreshCw size={14} id="refreshListIcon" aria-hidden="true" />
            <span>Refresh</span>
          </button>

          <!-- Clear Filters Button -->
          <button
            type="button"
            id="clearFiltersBtn"
            class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold text-ink-soft hover:text-forest bg-cream/80 hover:bg-cream rounded-xl border border-line/70 transition cursor-pointer"
            title="Reset all filters"
          >
            <RotateCcw size={14} aria-hidden="true" />
            <span>Reset</span>
          </button>
        </div>
      </div>

      <!-- Results Count -->
      <div class="flex items-center justify-between text-xs text-ink-soft pt-2 border-t border-line/40">
        <span id="resultsCount">Showing {recipesWithMeta.length} recipes</span>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1">
            <span class="size-2 rounded-full bg-emerald-500"></span>
            <span id="publishedCountLabel">{publishedCount} Published</span>
          </span>
          <span class="text-line">&middot;</span>
          <span class="inline-flex items-center gap-1">
            <span class="size-2 rounded-full bg-amber-500"></span>
            <span id="draftsCountLabel">{draftsCount} Drafts</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Desktop Table View -->
    <div class="hidden lg:block bg-paper rounded-2xl border border-line/70 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-line/60 bg-cream/40 text-[11px] font-bold uppercase tracking-wider text-ink-soft">
              <th scope="col" class="px-6 py-3.5">Recipe</th>
              <th scope="col" class="px-4 py-3.5">Category</th>
              <th scope="col" class="px-4 py-3.5">Status</th>
              <th scope="col" class="px-4 py-3.5">Last Updated</th>
              <th scope="col" class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="recipeTableBody" class="divide-y divide-line/40">
            {recipesWithMeta.map((recipe) => (
              <tr
                data-slug={recipe.slug}
                data-title={recipe.title.toLowerCase()}
                data-category={recipe.category}
                data-status={recipe.reviewStatus}
                class="hover:bg-cream/30 transition-colors group"
              >
                <!-- Recipe Thumbnail & Title -->
                <td class="px-6 py-3.5">
                  <div class="flex items-center gap-3.5">
                    <img
                      src={recipe.thumbUrl}
                      alt=""
                      class="size-12 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
                      loading="lazy"
                    />
                    <div class="min-w-0 max-w-md">
                      <a
                        href={`/admin/recipes/${recipe.slug}/`}
                        class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-1 block"
                      >
                        {recipe.title}
                      </a>
                      <p class="text-xs text-ink-soft line-clamp-1 mt-0.5 font-sans">
                        {recipe.description}
                      </p>
                    </div>
                  </div>
                </td>

                <!-- Category Badge -->
                <td class="px-4 py-3.5">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-cream border border-line/60 text-forest">
                    {recipe.categoryName}
                  </span>
                </td>

                <!-- Status Badge -->
                <td class="px-4 py-3.5">
                  {recipe.reviewStatus === 'tested' ? (
                    <span class="status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                      <span>Published</span>
                    </span>
                  ) : (
                    <span class="status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                      <Clock size={12} class="text-amber-600" aria-hidden="true" />
                      <span>Draft</span>
                    </span>
                  )}
                </td>

                <!-- Date -->
                <td class="px-4 py-3.5 text-xs text-ink-soft font-medium">
                  {recipe.formattedDate}
                </td>

                <!-- Actions -->
                <td class="px-6 py-3.5 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- View / Preview Link -->
                    <a
                      href={recipe.reviewStatus === 'tested' ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
                      title={recipe.reviewStatus === 'tested' ? 'View live recipe' : 'Preview draft recipe'}
                      aria-label={recipe.reviewStatus === 'tested' ? 'View live recipe' : 'Preview draft recipe'}
                    >
                      <Eye size={16} aria-hidden="true" />
                    </a>

                    <!-- Edit Recipe Link -->
                    <a
                      href={`/admin/recipes/${recipe.slug}/`}
                      class="p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
                      title="Edit recipe"
                      aria-label="Edit recipe"
                    >
                      <FilePenLine size={16} aria-hidden="true" />
                    </a>

                    <!-- Delete Button with Confirmation -->
                    <button
                      type="button"
                      data-delete={recipe.slug}
                      class="p-2 rounded-lg text-terracotta/70 hover:text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
                      title="Delete recipe"
                      aria-label="Delete recipe"
                    >
                      <Trash size={16} aria-hidden="true" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Card View -->
    <div id="recipeCardsContainer" class="lg:hidden space-y-4">
      {recipesWithMeta.map((recipe) => (
        <article
          data-slug={recipe.slug}
          data-title={recipe.title.toLowerCase()}
          data-category={recipe.category}
          data-status={recipe.reviewStatus}
          class="recipe-mobile-card bg-paper rounded-2xl border border-line/70 p-4 shadow-xs space-y-3"
        >
          <div class="flex items-start gap-3.5">
            <!-- Thumbnail -->
            <img
              src={recipe.thumbUrl}
              alt=""
              class="size-16 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
              loading="lazy"
            />

            <!-- Info -->
            <div class="min-w-0 flex-1">
              <a
                href={`/admin/recipes/${recipe.slug}/`}
                class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-2"
              >
                {recipe.title}
              </a>
              <div class="flex flex-wrap items-center gap-2 mt-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-cream border border-line/60 text-forest">
                  {recipe.categoryName}
                </span>

                {recipe.reviewStatus === 'tested' ? (
                  <span class="status-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                    <CircleCheck size={10} class="text-emerald-600" aria-hidden="true" />
                    <span>Published</span>
                  </span>
                ) : (
                  <span class="status-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                    <Clock size={10} class="text-amber-600" aria-hidden="true" />
                    <span>Draft</span>
                  </span>
                )}
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-line/40 text-xs text-ink-soft">
            <span>Updated {recipe.formattedDate}</span>

            <!-- Actions Row -->
            <div class="flex items-center gap-1.5">
              <a
                href={recipe.reviewStatus === 'tested' ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
              >
                <span>{recipe.reviewStatus === 'tested' ? 'View' : 'Preview'}</span>
                <ArrowUpRight size={12} aria-hidden="true" />
              </a>

              <a
                href={`/admin/recipes/${recipe.slug}/`}
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
              >
                <FilePenLine size={12} aria-hidden="true" />
                <span>Edit</span>
              </a>

              <button
                type="button"
                data-delete={recipe.slug}
                class="p-1.5 rounded-lg text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
                title="Delete recipe"
                aria-label="Delete recipe"
              >
                <Trash size={14} aria-hidden="true" />
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="emptyState"
      class="hidden bg-paper rounded-2xl border border-line/70 p-12 text-center max-w-lg mx-auto"
    >
      <div class="flex size-14 items-center justify-center rounded-2xl bg-cream text-forest mx-auto mb-4 border border-line/60">
        <Search size={26} aria-hidden="true" />
      </div>
      <h2 class="font-display font-bold text-lg text-forest">No recipes found</h2>
      <p class="text-sm text-ink-soft mt-1.5 max-w-sm mx-auto">
        No recipes match your search criteria. Try a different title or reset your filters.
      </p>
      <button
        type="button"
        id="emptyResetBtn"
        class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-forest bg-cream hover:bg-white border border-line shadow-xs transition cursor-pointer"
      >
        <RotateCcw size={14} aria-hidden="true" />
        <span>Clear all filters</span>
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  const tableBody = document.getElementById('recipeTableBody') as HTMLTableSectionElement | null;
  const cardsContainer = document.getElementById('recipeCardsContainer') as HTMLDivElement | null;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement | null;
  const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement | null;
  const emptyState = document.getElementById('emptyState') as HTMLDivElement | null;
  const clearFiltersBtn = document.getElementById('clearFiltersBtn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('emptyResetBtn') as HTMLButtonElement | null;
  const resultsCount = document.getElementById('resultsCount') as HTMLElement | null;
  const publishedCountLabel = document.getElementById('publishedCountLabel') as HTMLElement | null;
  const draftsCountLabel = document.getElementById('draftsCountLabel') as HTMLElement | null;
  const refreshListBtn = document.getElementById('refreshListBtn') as HTMLButtonElement | null;
  const refreshListIcon = document.getElementById('refreshListIcon') as SVGElement | null;

  // Flash Notification Elements
  const flashBanner = document.getElementById('adminFlashBanner') as HTMLDivElement | null;
  const flashBannerIcon = document.getElementById('flashBannerIcon') as HTMLDivElement | null;
  const flashBannerTitle = document.getElementById('flashBannerTitle') as HTMLElement | null;
  const flashBannerMessage = document.getElementById('flashBannerMessage') as HTMLElement | null;
  const closeFlashBtn = document.getElementById('closeFlashBtn') as HTMLButtonElement | null;

  const csrfToken = document.cookie
    .split('; ')
    .find((entry) => entry.startsWith('crockbites_admin_csrf='))
    ?.split('=')[1] ?? '';

  if (!tableBody || !searchInput || !categoryFilter || !statusFilter || !emptyState) {
    throw new Error('Admin recipe elements are missing.');
  }

  const safeTableBody = tableBody;
  const safeSearchInput = searchInput;
  const safeCategoryFilter = categoryFilter;
  const safeStatusFilter = statusFilter;
  const safeEmptyState = emptyState;

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function escapeAttr(str: string): string {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function showFlash(title: string, message: string, type: 'success' | 'warning' | 'error' = 'success') {
    if (!flashBanner || !flashBannerTitle || !flashBannerMessage || !flashBannerIcon) return;

    flashBannerTitle.textContent = title;
    flashBannerMessage.textContent = message;

    if (type === 'success') {
      flashBanner.className = 'rounded-2xl p-4 border bg-emerald-50 border-emerald-200 text-emerald-900 transition-all duration-300';
      flashBannerIcon.className = 'size-9 rounded-xl flex items-center justify-center shrink-0 bg-emerald-600 text-white font-bold text-sm';
      flashBannerIcon.innerHTML = '✓';
    } else if (type === 'warning') {
      flashBanner.className = 'rounded-2xl p-4 border bg-amber-50 border-amber-200 text-amber-900 transition-all duration-300';
      flashBannerIcon.className = 'size-9 rounded-xl flex items-center justify-center shrink-0 bg-amber-600 text-white font-bold text-sm';
      flashBannerIcon.innerHTML = '!';
    } else {
      flashBanner.className = 'rounded-2xl p-4 border bg-rose-50 border-rose-200 text-rose-900 transition-all duration-300';
      flashBannerIcon.className = 'size-9 rounded-xl flex items-center justify-center shrink-0 bg-rose-600 text-white font-bold text-sm';
      flashBannerIcon.innerHTML = '✕';
    }

    flashBanner.classList.remove('hidden');
    flashBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  closeFlashBtn?.addEventListener('click', () => {
    flashBanner?.classList.add('hidden');
  });

  function updateCounts() {
    const allRows = Array.from(safeTableBody.querySelectorAll('tr'));
    const published = allRows.filter((r) => r.dataset.status === 'tested').length;
    const drafts = allRows.filter((r) => r.dataset.status === 'draft').length;

    if (publishedCountLabel) publishedCountLabel.textContent = `${published} Published`;
    if (draftsCountLabel) draftsCountLabel.textContent = `${drafts} Drafts`;
  }

  function applyFilters() {
    const query = safeSearchInput.value.trim().toLowerCase();
    const category = safeCategoryFilter.value;
    const status = safeStatusFilter.value;
    const rows = Array.from(safeTableBody.querySelectorAll('tr'));
    const mobileCards = cardsContainer ? Array.from(cardsContainer.querySelectorAll<HTMLElement>('.recipe-mobile-card')) : [];
    let visible = 0;

    rows.forEach((row) => {
      const title = row.dataset.title || '';
      const rowCategory = row.dataset.category || '';
      const rowStatus = row.dataset.status || '';
      const matchText = !query || title.includes(query);
      const matchCategory = category === 'all' || rowCategory === category;
      const matchStatus = status === 'all' || rowStatus === status;
      const isVisible = matchText && matchCategory && matchStatus;
      row.hidden = !isVisible;
      if (isVisible) visible += 1;
    });

    mobileCards.forEach((card) => {
      const title = card.dataset.title || '';
      const rowCategory = card.dataset.category || '';
      const rowStatus = card.dataset.status || '';
      const matchText = !query || title.includes(query);
      const matchCategory = category === 'all' || rowCategory === category;
      const matchStatus = status === 'all' || rowStatus === status;
      card.hidden = !(matchText && matchCategory && matchStatus);
    });

    safeEmptyState.classList.toggle('hidden', visible > 0);
    if (resultsCount) {
      resultsCount.textContent = `Showing ${visible} recipe${visible === 1 ? '' : 's'}`;
    }
  }

  safeSearchInput.addEventListener('input', applyFilters);
  safeCategoryFilter.addEventListener('change', applyFilters);
  safeStatusFilter.addEventListener('change', applyFilters);

  function resetFilters() {
    safeSearchInput.value = '';
    safeCategoryFilter.value = 'all';
    safeStatusFilter.value = 'all';
    applyFilters();
  }

  clearFiltersBtn?.addEventListener('click', resetFilters);
  emptyResetBtn?.addEventListener('click', resetFilters);

  // Single recipe delete handler
  function attachDeleteListener(button: HTMLElement) {
    button.addEventListener('click', async () => {
      const slug = button.dataset.delete;
      if (!slug) return;

      const confirmed = window.confirm(`Delete recipe "${slug}"? This will permanently remove the recipe file from GitHub. This action cannot be undone.`);
      if (!confirmed) return;

      try {
        const response = await fetch(`/api/admin/recipes/${slug}/`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken,
          },
        });

        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          throw new Error(data.error || 'Delete failed.');
        }

        // Remove row and card from DOM
        document.querySelectorAll(`[data-slug="${slug}"]`).forEach((el) => {
          el.remove();
        });
        updateCounts();
        applyFilters();
        showFlash('Recipe Deleted', `Recipe "${slug}" was removed successfully.`, 'success');
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Delete failed.');
      }
    });
  }

  // Attach delete listeners to initial elements
  document.querySelectorAll<HTMLElement>('[data-delete]').forEach(attachDeleteListener);

  function createTableRowElement(recipe: any): HTMLTableRowElement {
    const isTested = recipe.reviewStatus === 'tested';
    const categoryName = recipe.categoryName || recipe.category || 'Easy Dinners';
    const thumbUrl = recipe.thumbUrl || recipe.imageUrl || '/placeholder.svg';
    const viewUrl = isTested ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`;
    const viewTitle = isTested ? 'View live recipe' : 'Preview draft recipe';

    const tr = document.createElement('tr');
    tr.dataset.slug = recipe.slug;
    tr.dataset.title = (recipe.title || '').toLowerCase();
    tr.dataset.category = recipe.category;
    tr.dataset.status = recipe.reviewStatus;
    tr.className = 'hover:bg-cream/30 transition-all duration-500 group ring-2 ring-forest/30 bg-forest/5';

    tr.innerHTML = `
      <td class="px-6 py-3.5">
        <div class="flex items-center gap-3.5">
          <img
            src="${escapeAttr(thumbUrl)}"
            alt=""
            class="size-12 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
            loading="lazy"
          />
          <div class="min-w-0 max-w-md">
            <a
              href="/admin/recipes/${escapeAttr(recipe.slug)}/"
              class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-1 block"
            >
              ${escapeHtml(recipe.title)}
            </a>
            <p class="text-xs text-ink-soft line-clamp-1 mt-0.5 font-sans">
              ${escapeHtml(recipe.description || '')}
            </p>
          </div>
        </div>
      </td>
      <td class="px-4 py-3.5">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-cream border border-line/60 text-forest">
          ${escapeHtml(categoryName)}
        </span>
      </td>
      <td class="px-4 py-3.5">
        <span class="status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold ${
          isTested
            ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
            : 'bg-amber-50 text-amber-800 border border-amber-200'
        }">
          <span>${isTested ? 'Published' : 'Draft'}</span>
        </span>
      </td>
      <td class="px-4 py-3.5 text-xs text-ink-soft font-medium">
        ${escapeHtml(recipe.formattedDate || 'Just now')}
      </td>
      <td class="px-6 py-3.5 text-right">
        <div class="flex items-center justify-end gap-1.5">
          <a
            href="${escapeAttr(viewUrl)}"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
            title="${escapeAttr(viewTitle)}"
            aria-label="${escapeAttr(viewTitle)}"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
          </a>
          <a
            href="/admin/recipes/${escapeAttr(recipe.slug)}/"
            class="p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
            title="Edit recipe"
            aria-label="Edit recipe"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </a>
          <button
            type="button"
            data-delete="${escapeAttr(recipe.slug)}"
            class="p-2 rounded-lg text-terracotta/70 hover:text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
            title="Delete recipe"
            aria-label="Delete recipe"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        </div>
      </td>
    `;

    const delBtn = tr.querySelector<HTMLElement>('[data-delete]');
    if (delBtn) attachDeleteListener(delBtn);

    // Fade highlight out after 3.5 seconds
    setTimeout(() => {
      tr.className = 'hover:bg-cream/30 transition-all duration-500 group';
    }, 3500);

    return tr;
  }

  function createMobileCardElement(recipe: any): HTMLElement {
    const isTested = recipe.reviewStatus === 'tested';
    const categoryName = recipe.categoryName || recipe.category || 'Easy Dinners';
    const thumbUrl = recipe.thumbUrl || recipe.imageUrl || '/placeholder.svg';
    const viewUrl = isTested ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`;

    const article = document.createElement('article');
    article.dataset.slug = recipe.slug;
    article.dataset.title = (recipe.title || '').toLowerCase();
    article.dataset.category = recipe.category;
    article.dataset.status = recipe.reviewStatus;
    article.className = 'recipe-mobile-card bg-paper rounded-2xl border border-forest/40 p-4 shadow-xs space-y-3 ring-2 ring-forest/30';

    article.innerHTML = `
      <div class="flex items-start gap-3.5">
        <img
          src="${escapeAttr(thumbUrl)}"
          alt=""
          class="size-16 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
          loading="lazy"
        />
        <div class="min-w-0 flex-1">
          <a
            href="/admin/recipes/${escapeAttr(recipe.slug)}/"
            class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-2"
          >
            ${escapeHtml(recipe.title)}
          </a>
          <div class="flex flex-wrap items-center gap-2 mt-2">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-cream border border-line/60 text-forest">
              ${escapeHtml(categoryName)}
            </span>
            <span class="status-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold ${
              isTested
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                : 'bg-amber-50 text-amber-800 border border-amber-200'
            }">
              <span>${isTested ? 'Published' : 'Draft'}</span>
            </span>
          </div>
        </div>
      </div>
      <div class="flex items-center justify-between pt-3 border-t border-line/40 text-xs text-ink-soft">
        <span>Updated ${escapeHtml(recipe.formattedDate || 'Just now')}</span>
        <div class="flex items-center gap-1.5">
          <a
            href="${escapeAttr(viewUrl)}"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
          >
            <span>${isTested ? 'View' : 'Preview'}</span>
          </a>
          <a
            href="/admin/recipes/${escapeAttr(recipe.slug)}/"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
          >
            <span>Edit</span>
          </a>
          <button
            type="button"
            data-delete="${escapeAttr(recipe.slug)}"
            class="p-1.5 rounded-lg text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
            title="Delete recipe"
            aria-label="Delete recipe"
          >
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
    `;

    const delBtn = article.querySelector<HTMLElement>('[data-delete]');
    if (delBtn) attachDeleteListener(delBtn);

    setTimeout(() => {
      article.className = 'recipe-mobile-card bg-paper rounded-2xl border border-line/70 p-4 shadow-xs space-y-3';
    }, 3500);

    return article;
  }

  function handleSavedRecipeOptimistic(recipe: any) {
    if (!recipe || !recipe.slug) return;

    // Prevent duplicate entries: remove existing rows/cards with this slug
    const existingRows = safeTableBody.querySelectorAll(`[data-slug="${recipe.slug}"]`);
    existingRows.forEach((row) => row.remove());

    if (cardsContainer) {
      const existingCards = cardsContainer.querySelectorAll(`[data-slug="${recipe.slug}"]`);
      existingCards.forEach((card) => card.remove());
    }

    // Prepend new row and card to the very top (sorted newest first)
    const newRow = createTableRowElement(recipe);
    safeTableBody.prepend(newRow);

    if (cardsContainer) {
      const newCard = createMobileCardElement(recipe);
      cardsContainer.prepend(newCard);
    }

    updateCounts();
    applyFilters();
  }

  // Check for flash notification from recipe save
  try {
    const rawFlash = sessionStorage.getItem('crockbites_admin_flash');
    if (rawFlash) {
      sessionStorage.removeItem('crockbites_admin_flash');
      const flash = JSON.parse(rawFlash);

      showFlash(flash.title || 'Success', flash.message || 'Recipe saved successfully.', flash.type || 'success');

      if (flash.recipe) {
        handleSavedRecipeOptimistic(flash.recipe);
      }
    }
  } catch {}

  // Refresh list button action (fetch latest from API)
  refreshListBtn?.addEventListener('click', async () => {
    if (refreshListIcon) refreshListIcon.classList.add('animate-spin');
    refreshListBtn.disabled = true;

    try {
      const res = await fetch('/api/admin/recipes/?fresh=1');
      if (!res.ok) throw new Error('Failed to refresh recipe list');
      const data = await res.json();
      if (Array.isArray(data.recipes)) {
        // Clear and rebuild table body
        safeTableBody.innerHTML = '';
        if (cardsContainer) cardsContainer.innerHTML = '';

        for (const r of data.recipes) {
          const row = createTableRowElement(r);
          row.className = 'hover:bg-cream/30 transition-colors group';
          safeTableBody.appendChild(row);

          if (cardsContainer) {
            const card = createMobileCardElement(r);
            card.className = 'recipe-mobile-card bg-paper rounded-2xl border border-line/70 p-4 shadow-xs space-y-3';
            cardsContainer.appendChild(card);
          }
        }

        updateCounts();
        applyFilters();
        showFlash('List Refreshed', 'Recipe catalog synchronized with GitHub.', 'success');
      }
    } catch (err) {
      showFlash('Refresh Failed', err instanceof Error ? err.message : 'Could not refresh recipes', 'error');
    } finally {
      if (refreshListIcon) refreshListIcon.classList.remove('animate-spin');
      refreshListBtn.disabled = false;
    }
  });

  // Apply initial filter state on page load (e.g. for ?status=draft)
  updateCounts();
  applyFilters();
</script>
