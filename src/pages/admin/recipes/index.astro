---
export const prerender = false;

import { getCollection } from 'astro:content';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getOptimizedCloudinaryUrl } from '../../../lib/cloudinary';
import {
  CirclePlus,
  Search,
  ListFilter,
  RotateCcw,
  Eye,
  FilePenLine,
  Trash,
  CircleCheck,
  Clock,
  ArrowUpRight,
} from '@lucide/astro';

const recipes = await getCollection('recipes');

// Read initial URL filters
const statusParam = Astro.url.searchParams.get('status') || 'all';
const categoryParam = Astro.url.searchParams.get('category') || 'all';
const queryParam = Astro.url.searchParams.get('q') || '';

const categoryMap: Record<string, string> = {
  'slow-cooker-chicken': 'Slow Cooker Chicken',
  'beef-pork': 'Beef & Pork',
  'soups-stews': 'Soups & Stews',
  'easy-dinners': 'Easy Dinners',
  'breakfast': 'Breakfast',
  'vegetarian': 'Vegetarian',
  'desserts-baking': 'Desserts & Baking',
};

// Sort recipes: newest updated first
const sortedRecipes = [...recipes].sort((a, b) => {
  const aDate = a.data.updatedDate ?? a.data.pubDate;
  const bDate = b.data.updatedDate ?? b.data.pubDate;
  return Number(bDate) - Number(aDate);
});

const recipesWithMeta = sortedRecipes.map((recipe) => {
  const slug = recipe.id.replace(/\.md$/, '');
  const rawImage = recipe.data.image;
  const imageUrl = typeof rawImage === 'string' ? rawImage : (rawImage as any)?.src || '/placeholder.svg';
  const isCloudinary = imageUrl.startsWith('http://') || imageUrl.startsWith('https://');
  const thumbUrl = isCloudinary ? getOptimizedCloudinaryUrl(imageUrl, 160) : imageUrl;
  const dateObj = recipe.data.updatedDate ?? recipe.data.pubDate;
  const formattedDate = dateObj.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
  const categoryName = categoryMap[recipe.data.category] || recipe.data.category;

  return {
    ...recipe,
    slug,
    thumbUrl,
    imageUrl,
    formattedDate,
    categoryName,
  };
});

const activeNav = statusParam === 'draft' ? 'drafts' : 'recipes';
---

<AdminLayout
  title={statusParam === 'draft' ? 'Draft Recipes' : 'Recipe Management'}
  subtitle="Organize, review, publish, and curate your editorial slow cooker recipe catalog."
  activeNav={activeNav}
  breadcrumbs={[{ label: 'Recipes' }]}
>
  <!-- Topbar Action Slot -->
  <div slot="actions">
    <a
      href="/admin/recipes/new/"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-forest text-cream font-bold text-sm hover:bg-forest-deep shadow-xs transition hover:scale-[1.02] cursor-pointer"
    >
      <CirclePlus size={16} aria-hidden="true" />
      <span>New Recipe</span>
    </a>
  </div>

  <div class="space-y-6">
    <!-- Toolbar Card -->
    <div class="bg-paper rounded-2xl border border-line/70 p-5 shadow-xs space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-ink-soft">
            <Search size={18} aria-hidden="true" />
          </div>
          <input
            id="searchInput"
            type="search"
            value={queryParam}
            placeholder="Search recipes by title or keyword..."
            aria-label="Search recipes"
            class="w-full pl-10 pr-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest focus:border-forest transition"
          />
        </div>

        <!-- Filter Controls -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Category Filter -->
          <div class="relative flex items-center">
            <label for="categoryFilter" class="sr-only">Filter by category</label>
            <div class="absolute left-3 pointer-events-none text-ink-soft">
              <ListFilter size={16} aria-hidden="true" />
            </div>
            <select
              id="categoryFilter"
              aria-label="Filter by category"
              class="pl-9 pr-8 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition appearance-none"
            >
              <option value="all" selected={categoryParam === 'all'}>All Categories</option>
              <option value="slow-cooker-chicken" selected={categoryParam === 'slow-cooker-chicken'}>Slow Cooker Chicken</option>
              <option value="beef-pork" selected={categoryParam === 'beef-pork'}>Beef &amp; Pork</option>
              <option value="soups-stews" selected={categoryParam === 'soups-stews'}>Soups &amp; Stews</option>
              <option value="easy-dinners" selected={categoryParam === 'easy-dinners'}>Easy Dinners</option>
              <option value="breakfast" selected={categoryParam === 'breakfast'}>Breakfast</option>
              <option value="vegetarian" selected={categoryParam === 'vegetarian'}>Vegetarian</option>
              <option value="desserts-baking" selected={categoryParam === 'desserts-baking'}>Desserts &amp; Baking</option>
            </select>
          </div>

          <!-- Status Filter -->
          <div class="relative flex items-center">
            <label for="statusFilter" class="sr-only">Filter by status</label>
            <select
              id="statusFilter"
              aria-label="Filter by status"
              class="px-4 py-2.5 text-sm bg-cream/50 border border-line rounded-xl focus:bg-white focus:outline-hidden focus:ring-2 focus:ring-forest text-ink font-medium cursor-pointer transition"
            >
              <option value="all" selected={statusParam === 'all'}>All Status</option>
              <option value="tested" selected={statusParam === 'tested'}>Published (Tested)</option>
              <option value="draft" selected={statusParam === 'draft'}>Draft</option>
            </select>
          </div>

          <!-- Clear Filters Button -->
          <button
            type="button"
            id="clearFiltersBtn"
            class="inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold text-ink-soft hover:text-forest bg-cream/80 hover:bg-cream rounded-xl border border-line/70 transition cursor-pointer"
            title="Reset all filters"
          >
            <RotateCcw size={14} aria-hidden="true" />
            <span>Reset</span>
          </button>
        </div>
      </div>

      <!-- Quick Metrics / Status Summary Row -->
      <div class="flex items-center justify-between text-xs text-ink-soft pt-2 border-t border-line/40">
        <span id="resultsCount">Showing {recipesWithMeta.length} recipes</span>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1">
            <span class="size-2 rounded-full bg-emerald-500"></span>
            <span>{recipes.filter((r) => r.data.reviewStatus === 'tested').length} Published</span>
          </span>
          <span class="text-line">&middot;</span>
          <span class="inline-flex items-center gap-1">
            <span class="size-2 rounded-full bg-amber-500"></span>
            <span>{recipes.filter((r) => r.data.reviewStatus === 'draft').length} Drafts</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Bulk Actions Floating/Sticky Bar -->
    <div
      id="bulkActionsBar"
      class="hidden items-center justify-between gap-4 p-4 bg-forest text-cream rounded-2xl shadow-lg border border-forest-deep transition-all"
    >
      <div class="flex items-center gap-3">
        <div class="flex size-7 items-center justify-center rounded-lg bg-white/10 text-cream font-bold text-xs">
          <CircleCheck size={16} aria-hidden="true" />
        </div>
        <strong id="selectedCountText" class="text-sm font-semibold text-cream">0 recipes selected</strong>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          type="button"
          id="bulkPublishBtn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded-lg bg-emerald-600 text-white hover:bg-emerald-500 transition shadow-xs cursor-pointer"
        >
          <CircleCheck size={14} aria-hidden="true" />
          <span>Publish Selected</span>
        </button>
        <button
          type="button"
          id="bulkDraftBtn"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold rounded-lg bg-amber-600 text-white hover:bg-amber-500 transition shadow-xs cursor-pointer"
        >
          <Clock size={14} aria-hidden="true" />
          <span>Set as Draft</span>
        </button>
        <button
          type="button"
          id="bulkClearBtn"
          class="inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg text-cream/70 hover:text-white hover:bg-white/10 transition cursor-pointer ml-2"
        >
          Clear selection
        </button>
      </div>
    </div>

    <!-- Desktop Table View (Hidden on Small Screens) -->
    <div class="hidden lg:block bg-paper rounded-2xl border border-line/70 shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-line/60 bg-cream/40 text-[11px] font-bold uppercase tracking-wider text-ink-soft">
              <th scope="col" class="w-12 px-5 py-3.5 text-center">
                <input
                  type="checkbox"
                  id="selectAllCheckbox"
                  aria-label="Select all recipes"
                  class="size-4 rounded-sm border-line text-forest focus:ring-forest cursor-pointer"
                />
              </th>
              <th scope="col" class="px-4 py-3.5">Recipe</th>
              <th scope="col" class="px-4 py-3.5">Category</th>
              <th scope="col" class="px-4 py-3.5">Status</th>
              <th scope="col" class="px-4 py-3.5">Last Updated</th>
              <th scope="col" class="px-5 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="recipeTableBody" class="divide-y divide-line/40">
            {recipesWithMeta.map((recipe) => (
              <tr
                data-slug={recipe.slug}
                data-title={recipe.data.title.toLowerCase()}
                data-category={recipe.data.category}
                data-status={recipe.data.reviewStatus}
                class="hover:bg-cream/30 transition-colors group"
              >
                <!-- Selection Checkbox -->
                <td class="px-5 py-3.5 text-center">
                  <input
                    type="checkbox"
                    class="recipe-select-checkbox size-4 rounded-sm border-line text-forest focus:ring-forest cursor-pointer"
                    data-slug={recipe.slug}
                    aria-label={`Select ${recipe.data.title}`}
                  />
                </td>

                <!-- Recipe Thumbnail & Title -->
                <td class="px-4 py-3.5">
                  <div class="flex items-center gap-3.5">
                    <img
                      src={recipe.thumbUrl}
                      alt=""
                      class="size-13 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
                      loading="lazy"
                    />
                    <div class="min-w-0 max-w-md">
                      <a
                        href={`/admin/recipes/${recipe.slug}/`}
                        class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-1 block"
                      >
                        {recipe.data.title}
                      </a>
                      <p class="text-xs text-ink-soft line-clamp-1 mt-0.5 font-sans">
                        {recipe.data.description}
                      </p>
                    </div>
                  </div>
                </td>

                <!-- Category Badge -->
                <td class="px-4 py-3.5">
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-cream border border-line/60 text-forest">
                    {recipe.categoryName}
                  </span>
                </td>

                <!-- Status Badge -->
                <td class="px-4 py-3.5">
                  {recipe.data.reviewStatus === 'tested' ? (
                    <span class="status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <CircleCheck size={12} class="text-emerald-600" aria-hidden="true" />
                      <span>Published</span>
                    </span>
                  ) : (
                    <span class="status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                      <Clock size={12} class="text-amber-600" aria-hidden="true" />
                      <span>Draft</span>
                    </span>
                  )}
                </td>

                <!-- Date -->
                <td class="px-4 py-3.5 text-xs text-ink-soft font-medium">
                  {recipe.formattedDate}
                </td>

                <!-- Actions -->
                <td class="px-5 py-3.5 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <!-- View / Preview Link -->
                    <a
                      href={recipe.data.reviewStatus === 'tested' ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="view-link p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
                      title={recipe.data.reviewStatus === 'tested' ? 'View live recipe' : 'Preview draft recipe'}
                      aria-label={recipe.data.reviewStatus === 'tested' ? 'View live recipe' : 'Preview draft recipe'}
                    >
                      <Eye size={16} aria-hidden="true" />
                    </a>

                    <!-- Edit Recipe Link -->
                    <a
                      href={`/admin/recipes/${recipe.slug}/`}
                      class="p-2 rounded-lg text-ink-soft hover:text-forest hover:bg-cream transition"
                      title="Edit recipe"
                      aria-label="Edit recipe"
                    >
                      <FilePenLine size={16} aria-hidden="true" />
                    </a>

                    <!-- Single Status Quick Action -->
                    {recipe.data.reviewStatus === 'tested' ? (
                      <button
                        type="button"
                        data-single-status="draft"
                        data-slug={recipe.slug}
                        class="single-status-btn p-2 rounded-lg text-amber-700 hover:text-amber-900 hover:bg-amber-50 transition cursor-pointer"
                        title="Unpublish (set to draft)"
                        aria-label="Set to draft"
                      >
                        <Clock size={16} aria-hidden="true" />
                      </button>
                    ) : (
                      <button
                        type="button"
                        data-single-status="tested"
                        data-slug={recipe.slug}
                        class="single-status-btn p-2 rounded-lg text-emerald-700 hover:text-emerald-900 hover:bg-emerald-50 transition cursor-pointer"
                        title="Publish recipe"
                        aria-label="Publish recipe"
                      >
                        <CircleCheck size={16} aria-hidden="true" />
                      </button>
                    )}

                    <!-- Delete Button -->
                    <button
                      type="button"
                      data-delete={recipe.slug}
                      class="p-2 rounded-lg text-terracotta/70 hover:text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
                      title="Delete recipe"
                      aria-label="Delete recipe"
                    >
                      <Trash size={16} aria-hidden="true" />
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Card View (Visible on < lg Screens) -->
    <div id="recipeCardsContainer" class="lg:hidden space-y-4">
      {recipesWithMeta.map((recipe) => (
        <article
          data-slug={recipe.slug}
          data-title={recipe.data.title.toLowerCase()}
          data-category={recipe.data.category}
          data-status={recipe.data.reviewStatus}
          class="recipe-mobile-card bg-paper rounded-2xl border border-line/70 p-4 shadow-xs space-y-3"
        >
          <div class="flex items-start gap-3.5">
            <!-- Mobile Select Checkbox -->
            <input
              type="checkbox"
              class="recipe-select-checkbox size-4 mt-1 rounded-sm border-line text-forest focus:ring-forest cursor-pointer shrink-0"
              data-slug={recipe.slug}
              aria-label={`Select ${recipe.data.title}`}
            />

            <!-- Thumbnail -->
            <img
              src={recipe.thumbUrl}
              alt=""
              class="size-16 rounded-xl object-cover bg-cream border border-line/70 shrink-0"
              loading="lazy"
            />

            <!-- Info -->
            <div class="min-w-0 flex-1">
              <a
                href={`/admin/recipes/${recipe.slug}/`}
                class="font-display font-bold text-sm text-forest hover:text-terracotta transition line-clamp-2"
              >
                {recipe.data.title}
              </a>
              <div class="flex flex-wrap items-center gap-2 mt-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-cream border border-line/60 text-forest">
                  {recipe.categoryName}
                </span>

                {recipe.data.reviewStatus === 'tested' ? (
                  <span class="status-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                    <CircleCheck size={10} class="text-emerald-600" aria-hidden="true" />
                    <span>Published</span>
                  </span>
                ) : (
                  <span class="status-tag inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-200">
                    <Clock size={10} class="text-amber-600" aria-hidden="true" />
                    <span>Draft</span>
                  </span>
                )}
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-line/40 text-xs text-ink-soft">
            <span>Updated {recipe.formattedDate}</span>

            <!-- Actions Row -->
            <div class="flex items-center gap-1.5">
              <a
                href={recipe.data.reviewStatus === 'tested' ? `/recipe/${recipe.slug}/` : `/admin/recipes/preview/${recipe.slug}/`}
                target="_blank"
                rel="noopener noreferrer"
                class="view-link inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
              >
                <span>{recipe.data.reviewStatus === 'tested' ? 'View' : 'Preview'}</span>
                <ArrowUpRight size={12} aria-hidden="true" />
              </a>

              <a
                href={`/admin/recipes/${recipe.slug}/`}
                class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-forest bg-cream hover:bg-cream/70 border border-line/60"
              >
                <FilePenLine size={12} aria-hidden="true" />
                <span>Edit</span>
              </a>

              <button
                type="button"
                data-delete={recipe.slug}
                class="p-1.5 rounded-lg text-terracotta hover:bg-terracotta/10 transition cursor-pointer"
                title="Delete recipe"
                aria-label="Delete recipe"
              >
                <Trash size={14} aria-hidden="true" />
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div
      id="emptyState"
      class="hidden bg-paper rounded-2xl border border-line/70 p-12 text-center max-w-lg mx-auto"
    >
      <div class="flex size-14 items-center justify-center rounded-2xl bg-cream text-forest mx-auto mb-4 border border-line/60">
        <Search size={26} aria-hidden="true" />
      </div>
      <h2 class="font-display font-bold text-lg text-forest">No recipes found</h2>
      <p class="text-sm text-ink-soft mt-1.5 max-w-sm mx-auto">
        No recipes match your current search criteria or active filters. Try broadening your terms or reset the filters.
      </p>
      <button
        type="button"
        id="emptyResetBtn"
        class="mt-5 inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-forest bg-cream hover:bg-white border border-line shadow-xs transition cursor-pointer"
      >
        <RotateCcw size={14} aria-hidden="true" />
        <span>Clear all filters</span>
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  const tableBody = document.getElementById('recipeTableBody') as HTMLTableSectionElement | null;
  const cardsContainer = document.getElementById('recipeCardsContainer') as HTMLDivElement | null;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
  const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement | null;
  const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement | null;
  const emptyState = document.getElementById('emptyState') as HTMLDivElement | null;
  const selectAllCheckbox = document.getElementById('selectAllCheckbox') as HTMLInputElement | null;
  const bulkActionsBar = document.getElementById('bulkActionsBar') as HTMLDivElement | null;
  const selectedCountText = document.getElementById('selectedCountText') as HTMLElement | null;
  const bulkPublishBtn = document.getElementById('bulkPublishBtn') as HTMLButtonElement | null;
  const bulkDraftBtn = document.getElementById('bulkDraftBtn') as HTMLButtonElement | null;
  const bulkClearBtn = document.getElementById('bulkClearBtn') as HTMLButtonElement | null;
  const clearFiltersBtn = document.getElementById('clearFiltersBtn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('emptyResetBtn') as HTMLButtonElement | null;
  const resultsCount = document.getElementById('resultsCount') as HTMLElement | null;

  const csrfToken = document.cookie
    .split('; ')
    .find((entry) => entry.startsWith('crockbites_admin_csrf='))
    ?.split('=')[1] ?? '';

  if (!tableBody || !searchInput || !categoryFilter || !statusFilter || !emptyState) {
    throw new Error('Admin recipe table elements are missing.');
  }

  const safeTableBody = tableBody;
  const safeSearchInput = searchInput;
  const safeCategoryFilter = categoryFilter;
  const safeStatusFilter = statusFilter;
  const safeEmptyState = emptyState;

  function getSelectedSlugs(): string[] {
    const checkedBoxes = Array.from(document.querySelectorAll<HTMLInputElement>('.recipe-select-checkbox:checked'));
    const uniqueSlugs = new Set<string>();
    checkedBoxes.forEach((cb) => {
      const slug = cb.dataset.slug;
      if (slug) uniqueSlugs.add(slug);
    });
    return Array.from(uniqueSlugs);
  }

  function updateBulkBar() {
    const selected = getSelectedSlugs();
    if (bulkActionsBar && selectedCountText) {
      if (selected.length > 0) {
        bulkActionsBar.classList.remove('hidden');
        bulkActionsBar.classList.add('flex');
        selectedCountText.textContent = `${selected.length} recipe${selected.length === 1 ? '' : 's'} selected`;
      } else {
        bulkActionsBar.classList.add('hidden');
        bulkActionsBar.classList.remove('flex');
      }
    }
    if (selectAllCheckbox) {
      const visibleCheckboxes = Array.from(safeTableBody.querySelectorAll<HTMLInputElement>('tr:not([hidden]) .recipe-select-checkbox'));
      if (visibleCheckboxes.length > 0) {
        selectAllCheckbox.checked = visibleCheckboxes.every((cb) => cb.checked);
      } else {
        selectAllCheckbox.checked = false;
      }
    }
  }

  function applyFilters() {
    const query = safeSearchInput.value.trim().toLowerCase();
    const category = safeCategoryFilter.value;
    const status = safeStatusFilter.value;
    const rows = Array.from(safeTableBody.querySelectorAll('tr'));
    const mobileCards = cardsContainer ? Array.from(cardsContainer.querySelectorAll<HTMLElement>('.recipe-mobile-card')) : [];
    let visible = 0;

    rows.forEach((row) => {
      const title = row.dataset.title || '';
      const rowCategory = row.dataset.category || '';
      const rowStatus = row.dataset.status || '';
      const matchText = !query || title.includes(query);
      const matchCategory = category === 'all' || rowCategory === category;
      const matchStatus = status === 'all' || rowStatus === status;
      const isVisible = matchText && matchCategory && matchStatus;
      row.hidden = !isVisible;
      if (isVisible) visible += 1;
    });

    mobileCards.forEach((card) => {
      const title = card.dataset.title || '';
      const rowCategory = card.dataset.category || '';
      const rowStatus = card.dataset.status || '';
      const matchText = !query || title.includes(query);
      const matchCategory = category === 'all' || rowCategory === category;
      const matchStatus = status === 'all' || rowStatus === status;
      card.hidden = !(matchText && matchCategory && matchStatus);
    });

    safeEmptyState.classList.toggle('hidden', visible > 0);
    if (resultsCount) {
      resultsCount.textContent = `Showing ${visible} recipe${visible === 1 ? '' : 's'}`;
    }
    updateBulkBar();
  }

  safeSearchInput.addEventListener('input', applyFilters);
  safeCategoryFilter.addEventListener('change', applyFilters);
  safeStatusFilter.addEventListener('change', applyFilters);

  function resetFilters() {
    safeSearchInput.value = '';
    safeCategoryFilter.value = 'all';
    safeStatusFilter.value = 'all';
    applyFilters();
  }

  clearFiltersBtn?.addEventListener('click', resetFilters);
  emptyResetBtn?.addEventListener('click', resetFilters);

  selectAllCheckbox?.addEventListener('change', () => {
    const isChecked = selectAllCheckbox.checked;
    const visibleCheckboxes = safeTableBody.querySelectorAll<HTMLInputElement>('tr:not([hidden]) .recipe-select-checkbox');
    visibleCheckboxes.forEach((cb) => {
      cb.checked = isChecked;
      // Also sync matching mobile checkbox
      const slug = cb.dataset.slug;
      if (slug && cardsContainer) {
        const mobileCb = cardsContainer.querySelector<HTMLInputElement>(`.recipe-select-checkbox[data-slug="${slug}"]`);
        if (mobileCb) mobileCb.checked = isChecked;
      }
    });
    updateBulkBar();
  });

  // Handle checkbox changes across table and mobile cards
  document.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('recipe-select-checkbox')) {
      const input = target as HTMLInputElement;
      const slug = input.dataset.slug;
      if (slug) {
        // Sync desktop and mobile checkboxes for the same slug
        const matchingCheckboxes = document.querySelectorAll<HTMLInputElement>(`.recipe-select-checkbox[data-slug="${slug}"]`);
        matchingCheckboxes.forEach((cb) => {
          cb.checked = input.checked;
        });
      }
      updateBulkBar();
    }
  });

  bulkClearBtn?.addEventListener('click', () => {
    document.querySelectorAll<HTMLInputElement>('.recipe-select-checkbox').forEach((cb) => {
      cb.checked = false;
    });
    if (selectAllCheckbox) selectAllCheckbox.checked = false;
    updateBulkBar();
  });

  async function applyBulkStatusChange(targetStatus: 'draft' | 'tested', targetSlugs?: string[]) {
    const slugs = targetSlugs && targetSlugs.length > 0 ? targetSlugs : getSelectedSlugs();
    if (slugs.length === 0) return;

    const label = targetStatus === 'tested' ? 'Published' : 'Draft';
    const confirmed = window.confirm(
      `Are you sure you want to change the status of ${slugs.length} recipe(s) to "${label}"? This will commit updates directly to GitHub.`
    );
    if (!confirmed) return;

    if (bulkPublishBtn) bulkPublishBtn.disabled = true;
    if (bulkDraftBtn) bulkDraftBtn.disabled = true;
    if (selectedCountText) selectedCountText.textContent = `Updating ${slugs.length} recipe(s)...`;

    try {
      const response = await fetch('/api/admin/recipes/bulk-status/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify({ slugs, status: targetStatus }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(data.error || 'Bulk update failed.');
      }

      // Update UI for modified rows and cards
      if (Array.isArray(data.updated)) {
        data.updated.forEach((slug: string) => {
          const elements = document.querySelectorAll(`[data-slug="${slug}"]`);
          elements.forEach((el) => {
            el.setAttribute('data-status', targetStatus);

            const statusTag = el.querySelector('.status-tag');
            if (statusTag) {
              if (targetStatus === 'tested') {
                statusTag.className = 'status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
                statusTag.innerHTML = `<span>Published</span>`;
              } else {
                statusTag.className = 'status-tag inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200';
                statusTag.innerHTML = `<span>Draft</span>`;
              }
            }

            const viewLink = el.querySelector<HTMLAnchorElement>('.view-link');
            if (viewLink) {
              if (targetStatus === 'tested') {
                viewLink.href = `/recipe/${slug}/`;
                viewLink.title = 'View live recipe';
              } else {
                viewLink.href = `/admin/recipes/preview/${slug}/`;
                viewLink.title = 'Preview draft recipe';
              }
            }
          });
        });
      }

      if (Array.isArray(data.failed) && data.failed.length > 0) {
        const failDetails = data.failed.map((f: { slug: string; error: string }) => `${f.slug}: ${f.error}`).join('\n');
        window.alert(
          `Updated ${data.updated?.length ?? 0} recipe(s).\nFailed to update ${data.failed.length} recipe(s):\n${failDetails}`
        );
      } else {
        window.alert(`Successfully updated ${data.updated?.length ?? 0} recipe(s) to ${label}.`);
      }

      // Uncheck selection and re-run filter
      document.querySelectorAll<HTMLInputElement>('.recipe-select-checkbox').forEach((cb) => {
        cb.checked = false;
      });
      if (selectAllCheckbox) selectAllCheckbox.checked = false;
      applyFilters();
    } catch (error) {
      window.alert(error instanceof Error ? error.message : 'Status update failed.');
    } finally {
      if (bulkPublishBtn) bulkPublishBtn.disabled = false;
      if (bulkDraftBtn) bulkDraftBtn.disabled = false;
      updateBulkBar();
    }
  }

  bulkPublishBtn?.addEventListener('click', () => applyBulkStatusChange('tested'));
  bulkDraftBtn?.addEventListener('click', () => applyBulkStatusChange('draft'));

  // Quick single-status toggle buttons
  document.querySelectorAll<HTMLButtonElement>('.single-status-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const targetStatus = button.dataset.singleStatus as 'draft' | 'tested' | undefined;
      const slug = button.dataset.slug;
      if (targetStatus && slug) {
        applyBulkStatusChange(targetStatus, [slug]);
      }
    });
  });

  // Single recipe delete handler
  document.querySelectorAll('[data-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      const slug = (button as HTMLElement).dataset.delete;
      const confirmed = window.confirm(`Delete recipe "${slug}"? This will permanently remove the recipe file from GitHub and clean up unused media. This action cannot be undone.`);
      if (!confirmed || !slug) return;

      try {
        const response = await fetch(`/api/admin/recipes/${slug}/`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
            'x-csrf-token': csrfToken,
          },
        });

        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          throw new Error(data.error || 'Delete failed.');
        }

        // Remove row and card from DOM
        document.querySelectorAll(`[data-slug="${slug}"]`).forEach((el) => {
          el.remove();
        });
        applyFilters();
      } catch (error) {
        window.alert(error instanceof Error ? error.message : 'Delete failed.');
      }
    });
  });

  // Apply initial filter state on page load (e.g. for ?status=draft)
  applyFilters();
</script>
