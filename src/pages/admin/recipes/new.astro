---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  ADMIN_COOKIE_NAME,
  CSRF_COOKIE_NAME,
  createCsrfToken,
  getAdminSessionSecret,
  parseAdminSessionCookie,
  verifySessionCookie,
} from '../../../lib/admin';
import { getGithubConfig } from '../../../lib/github';
import { isCloudinaryConfigured } from '../../../lib/cloudinary';
import { ArrowLeft } from '@lucide/astro';

const sessionCookie = Astro.cookies.get(ADMIN_COOKIE_NAME)?.value ?? '';
const secret = getAdminSessionSecret();
const session = parseAdminSessionCookie(sessionCookie);

if (!secret || !session || !verifySessionCookie(sessionCookie, secret)) {
  return Astro.redirect('/admin/login/?error=Session+expired');
}

const csrfToken = createCsrfToken(secret, session.id);
const isHttps = Astro.url.protocol === 'https:';
Astro.cookies.set(CSRF_COOKIE_NAME, csrfToken, {
  httpOnly: false,
  sameSite: 'lax',
  secure: isHttps,
  path: '/',
  maxAge: 60 * 60 * 12,
});

const ghActive = Boolean(getGithubConfig().token);
const cloudinaryActive = isCloudinaryConfigured();

const categories = [
  ['slow-cooker-chicken', 'Slow Cooker Chicken'],
  ['beef-pork', 'Beef & Pork'],
  ['soups-stews', 'Soups & Stews'],
  ['easy-dinners', 'Easy Dinners'],
  ['breakfast', 'Breakfast'],
  ['vegetarian', 'Vegetarian'],
  ['desserts-baking', 'Desserts & Baking'],
];
---

<AdminLayout
  title="Create Recipe"
  subtitle="Author, configure, and publish a new slow cooker recipe."
  activeNav="new-recipe"
  breadcrumbs={[
    { label: 'Recipes', href: '/admin/recipes/' },
    { label: 'New Recipe' },
  ]}
>
  <div slot="actions">
    <a
      href="/admin/recipes/"
      class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-line bg-white text-ink text-sm font-semibold hover:bg-cream/50 transition cursor-pointer shadow-xs"
    >
      <ArrowLeft size={16} aria-hidden="true" />
      <span>Back to recipes</span>
    </a>
  </div>

  <div class="space-y-6 max-w-4xl">
    {!ghActive && (
      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm">
        ⚠️ <strong>GitHub publishing is not configured.</strong> Recipes cannot be committed until repository credentials are set in <a href="/admin/settings/" class="underline font-bold">Settings</a>.
      </div>
    )}

    <form id="recipe-form" class="card stack">
      <input type="hidden" name="csrfToken" value={csrfToken} />
      <input type="hidden" name="reviewStatus" id="reviewStatusInput" value="draft" />

      <!-- Essential: Recipe Overview -->
      <div class="section-box">
        <h2 class="text-base font-bold text-forest mb-4">Recipe Overview</h2>
        <div class="grid">
          <label>
            Recipe Title *
            <input name="title" id="titleInput" required placeholder="e.g. Slow Cooker Pulled Pork" />
          </label>
          <label>
            SEO Slug * <span class="hint">(Auto-generated, editable)</span>
            <input name="slug" id="slugInput" placeholder="slow-cooker-pulled-pork" />
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Category *
            <select name="category">
              {categories.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label>
            Author
            <input name="author" value="CrockBites" />
          </label>
        </div>

        <div style="margin-top: 1rem;">
          <label>
            Short Description / SEO Summary *
            <textarea name="description" required placeholder="A brief, mouthwatering 1-2 sentence description for search engines and social cards..."></textarea>
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Prep Time (Minutes) *
            <input name="prepMinutes" type="number" min="0" value="15" required />
          </label>
          <label>
            Cook Time (Minutes) *
            <input name="cookMinutes" type="number" min="0" value="240" required />
          </label>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Slow Cooker Setting *
            <select name="slowCookerSetting" id="slowCookerSettingSelect">
              <option value="Low (6 to 8 hours)">Low (6 to 8 hours)</option>
              <option value="High (3 to 4 hours)">High (3 to 4 hours)</option>
              <option value="Low or High Dual">Low or High Dual</option>
              <option value="Warm">Warm</option>
            </select>
          </label>
          <label>
            Servings *
            <input name="servings" type="number" min="1" value="6" required />
          </label>
        </div>

        <div style="margin-top: 1rem;">
          <label>
            Cook Time Note <span class="hint">(e.g. 6 to 8 hours on LOW or 3 to 4 hours on HIGH)</span>
            <input name="cookTimeNote" id="cookTimeNoteInput" value="6 to 8 hours on LOW" placeholder="e.g. 6 to 8 hours on LOW" />
          </label>
        </div>
      </div>

      <!-- Essential: Main Recipe Image -->
      <div class="section-box">
        <h2 class="text-base font-bold text-forest mb-4">Main Recipe Image</h2>
        <div class="dropzone" id="imageDropzone">
          <input type="file" id="imageFileInput" accept="image/jpeg,image/png,image/webp,image/avif" style="display: none;" />
          <div style="font-size: 2rem; margin-bottom: 0.5rem;">📸</div>
          <p style="margin: 0; font-weight: 700; font-size: 1rem;">Drag &amp; drop main recipe photo here, or click to browse</p>
          <p class="hint" style="margin: 0.25rem 0 0;">Uploads to Cloudinary (JPEG, PNG, WebP, AVIF up to 8 MB)</p>
          <div id="uploadProgress" style="display: none; margin-top: 0.75rem; font-weight: 700; color: var(--terracotta);">
            Uploading to Cloudinary...
          </div>
        </div>

        <div class="grid" style="margin-top: 1rem;">
          <label>
            Image URL
            <input name="image" id="primaryImageUrl" value="../../assets/recipes/placeholder.svg" />
          </label>
          <label>
            Image Alt Text *
            <input name="imageAlt" id="primaryImageAlt" value="Illustrated CrockBites recipe" required />
          </label>
        </div>
      </div>

      <!-- Essential: Ingredients -->
      <div class="section-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 class="text-base font-bold text-forest m-0">Ingredients *</h2>
          <button type="button" class="btn btn-subtle btn-pill" id="addIngredientBtn">+ Add Ingredient</button>
        </div>
        <div id="ingredientList" class="stack"></div>
      </div>

      <!-- Essential: Instructions -->
      <div class="section-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 class="text-base font-bold text-forest m-0">Step-by-Step Instructions *</h2>
          <button type="button" class="btn btn-subtle btn-pill" id="addInstructionBtn">+ Add Step</button>
        </div>
        <div id="instructionList" class="stack"></div>
      </div>

      <!-- Collapsible: Advanced Details (Optional) -->
      <details class="section-box cursor-pointer group">
        <summary class="font-bold text-base text-forest flex items-center justify-between py-1 select-none">
          <span>Advanced Details (Optional)</span>
          <span class="text-xs text-ink-soft group-open:rotate-180 transition-transform">▼</span>
        </summary>

        <div class="pt-5 space-y-6 border-t border-line/60 mt-4 cursor-default">
          <!-- Difficulty & Tags -->
          <div class="grid">
            <label>
              Difficulty
              <select name="difficulty" id="difficultySelect">
                <option value="Easy">Easy</option>
                <option value="Intermediate">Intermediate</option>
                <option value="Advanced">Advanced</option>
              </select>
            </label>
            <label>
              Tags <span class="hint">(Comma-separated)</span>
              <input name="tags" placeholder="dinner, chicken, easy, comfort food" />
            </label>
          </div>

          <!-- Additional Gallery Images -->
          <div>
            <label class="font-bold text-sm text-forest mb-2 block">
              Additional Gallery Images
              <span class="hint font-normal block mt-0.5">Extra step-by-step or plated dish photos</span>
            </label>
            <div class="gallery-grid" id="galleryContainer" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 220px)); gap: 1rem; margin-top: 0.5rem;"></div>
          </div>

          <!-- Dietary Labels -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Dietary Labels</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              {['vegetarian', 'vegan', 'gluten-free', 'dairy-free', 'nut-free', 'low-carb', 'keto-friendly', 'high-protein', 'low-sodium', 'pescatarian'].map((label) => (
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: normal; cursor: pointer; font-size: 0.9rem;">
                  <input type="checkbox" name="dietaryLabels" value={label} />
                  <span class="capitalize">{label.replace('-', ' ')}</span>
                </label>
              ))}
            </div>
            <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; color: var(--forest); margin-top: 0.75rem; font-size: 0.85rem;">
              <input type="checkbox" name="dietaryVerified" id="dietaryVerifiedInput" />
              Dietary claims reviewed and verified.
            </label>
          </div>

          <!-- Allergen Information -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Major Food Allergens</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              {['milk', 'eggs', 'fish', 'crustacean-shellfish', 'tree-nuts', 'peanuts', 'wheat', 'soybeans', 'sesame'].map((allergen) => (
                <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: normal; cursor: pointer; font-size: 0.9rem;">
                  <input type="checkbox" name="allergens" value={allergen} />
                  <span class="capitalize">{allergen.replace('-', ' ')}</span>
                </label>
              ))}
            </div>
            <div style="margin-top: 0.75rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; font-weight: 600; cursor: pointer; color: var(--forest); font-size: 0.85rem;">
                <input type="checkbox" name="allergenReviewed" id="allergenReviewedInput" />
                Allergens explicitly reviewed.
              </label>
              <input type="text" name="allergenNotes" placeholder="Allergen notes or substitutions (optional)" style="margin-top: 0.5rem;" />
            </div>
          </div>

          <!-- Nutrition Panel -->
          <div>
            <label class="font-bold text-sm text-forest mb-1 block">Nutrition Information (Optional - Leave blank if unverified)</label>
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.5rem; margin-top: 0.5rem;">
              <label>Calories<input type="number" step="any" min="0" name="nutrition_calories" placeholder="385" /></label>
              <label>Protein (g)<input type="number" step="any" min="0" name="nutrition_proteinGrams" placeholder="34" /></label>
              <label>Carbs (g)<input type="number" step="any" min="0" name="nutrition_carbsGrams" placeholder="12" /></label>
              <label>Fat (g)<input type="number" step="any" min="0" name="nutrition_fatGrams" placeholder="16" /></label>
              <label>Sat Fat (g)<input type="number" step="any" min="0" name="nutrition_saturatedFatGrams" placeholder="4" /></label>
              <label>Fiber (g)<input type="number" step="any" min="0" name="nutrition_fiberGrams" placeholder="3" /></label>
              <label>Sodium (mg)<input type="number" step="any" min="0" name="nutrition_sodiumMilligrams" placeholder="640" /></label>
            </div>
          </div>

          <!-- Notes & Food Safety -->
          <div class="space-y-3">
            <label>
              Food Safety Notes <span class="hint">(e.g. Cook poultry to min 165°F / 74°C)</span>
              <textarea name="foodSafety" placeholder="Cook poultry to a minimum internal temperature of 165°F (74°C)."></textarea>
            </label>
            <label>
              Kitchen Tips
              <textarea name="tips" placeholder="Helpful slow cooker tips..."></textarea>
            </label>
            <label>
              Equipment
              <textarea name="equipment" placeholder="6-quart slow cooker"></textarea>
            </label>
            <label>
              Editorial Story / Intro Body
              <textarea name="body" placeholder="Optional background or recipe notes..."></textarea>
            </label>
          </div>
        </div>
      </details>

      <!-- Submission Actions -->
      <div class="pt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line/60">
        <a class="btn btn-subtle" href="/admin/recipes/">Cancel</a>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="saveDraftBtn"
            class="btn btn-subtle"
            style="font-weight: 700;"
          >
            Save as Draft
          </button>
          <button
            type="button"
            id="publishBtn"
            class="btn btn-primary"
            style="background: #243A2D;"
          >
            Publish Recipe
          </button>
        </div>
      </div>

      <div id="formStatus" class="status" aria-live="polite"></div>
    </form>
  </div>
</AdminLayout>

<style is:global>
  .card { background: rgba(255,255,255,0.95); border: 1px solid var(--line); border-radius: 20px; padding: 1.75rem; box-shadow: 0 4px 14px rgba(36,58,45,0.04); }
  .section-box { border: 1px solid var(--line); border-radius: 16px; padding: 1.35rem; background: var(--paper); margin-bottom: 1.5rem; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem; }
  .stack { display: grid; gap: 1.25rem; }
  label { display: grid; gap: 0.45rem; font-weight: 700; font-size: 0.95rem; }
  input, textarea, select { width: 100%; border: 1px solid rgba(36,58,45,0.2); border-radius: 12px; padding: 0.85rem 1rem; font: inherit; background: #fff; color: var(--forest); }
  input:focus, textarea:focus, select:focus { outline: 2px solid var(--terracotta); border-color: transparent; }
  textarea { min-height: 90px; resize: vertical; }
  .hint { font-size: 0.82rem; font-weight: normal; color: rgba(36,58,45,0.7); }
  .item-row { display: grid; grid-template-columns: 100px 140px 1fr 1fr auto; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; background: #fff; padding: 0.65rem; border-radius: 12px; border: 1px solid var(--line); }
  .step-row { display: grid; grid-template-columns: 180px 1fr auto; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem; background: #fff; padding: 0.65rem; border-radius: 12px; border: 1px solid var(--line); }
  .btn { border: none; border-radius: 10px; padding: 0.8rem 1.25rem; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; transition: all 0.15s ease; font-size: 0.9rem; }
  .btn-primary { background: var(--forest); color: #fff; }
  .btn-primary:hover { background: #18281f; }
  .btn-subtle { background: rgba(36,58,45,0.08); color: var(--forest); }
  .btn-subtle:hover { background: rgba(36,58,45,0.14); }
  .btn-danger { background: rgba(198,106,69,0.12); color: var(--terracotta); padding: 0.65rem 0.9rem; }
  .btn-danger:hover { background: rgba(198,106,69,0.22); }
  .btn-pill { border-radius: 999px; font-size: 0.8rem; padding: 0.35rem 0.75rem; }

  .dropzone { border: 2px dashed rgba(36,58,45,0.25); border-radius: 16px; padding: 1.75rem 1.25rem; text-align: center; cursor: pointer; transition: border-color 0.2s, background-color 0.2s; background: rgba(255,255,255,0.6); }
  .dropzone.dragover { border-color: var(--terracotta); background: rgba(198,106,69,0.06); }
  .status { margin-top: 1.25rem; padding: 1rem 1.25rem; border-radius: 12px; display: none; font-weight: 600; }
  .status.error { background: #ffebee; color: #c62828; display: block; border: 1px solid #ffcdd2; }
  .status.success { background: #e8f5e9; color: #2e7d32; display: block; border: 1px solid #c8e6c9; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .item-row, .step-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  let images: Array<{
    url: string;
    publicId?: string;
    alt: string;
    width?: number;
    height?: number;
    isPrimary?: boolean;
  }> = [];

  const csrfInput = document.querySelector('input[name="csrfToken"]') as HTMLInputElement;
  const csrfToken = csrfInput ? csrfInput.value : '';

  const dropzone = document.getElementById('imageDropzone')!;
  const fileInput = document.getElementById('imageFileInput') as HTMLInputElement;
  const progressEl = document.getElementById('uploadProgress')!;
  const primaryUrlEl = document.getElementById('primaryImageUrl') as HTMLInputElement;
  const primaryAltEl = document.getElementById('primaryImageAlt') as HTMLInputElement;
  const titleInput = document.getElementById('titleInput') as HTMLInputElement;
  const slugInput = document.getElementById('slugInput') as HTMLInputElement;
  const form = document.getElementById('recipe-form') as HTMLFormElement;
  const formStatus = document.getElementById('formStatus')!;
  const saveDraftBtn = document.getElementById('saveDraftBtn') as HTMLButtonElement;
  const publishBtn = document.getElementById('publishBtn') as HTMLButtonElement;
  const reviewStatusInput = document.getElementById('reviewStatusInput') as HTMLInputElement;

  // Auto-slugify title
  titleInput.addEventListener('input', () => {
    if (!slugInput.dataset.manual) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/['’]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }
  });
  slugInput.addEventListener('input', () => {
    slugInput.dataset.manual = 'true';
  });

  // Slow cooker setting sync with cookTimeNote
  const slowCookerSelect = document.getElementById('slowCookerSettingSelect') as HTMLSelectElement;
  const cookTimeNoteInput = document.getElementById('cookTimeNoteInput') as HTMLInputElement;
  slowCookerSelect?.addEventListener('change', () => {
    if (!cookTimeNoteInput.dataset.manual) {
      cookTimeNoteInput.value = slowCookerSelect.value;
    }
  });
  cookTimeNoteInput?.addEventListener('input', () => {
    cookTimeNoteInput.dataset.manual = 'true';
  });

  // Upload Logic
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('dragover');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    if (e.dataTransfer?.files) {
      uploadFiles(Array.from(e.dataTransfer.files));
    }
  });

  fileInput.addEventListener('change', () => {
    if (fileInput.files) {
      uploadFiles(Array.from(fileInput.files));
      fileInput.value = '';
    }
  });

  async function uploadFiles(files: File[]) {
    if (files.length === 0) return;
    progressEl.style.display = 'block';

    const formData = new FormData();
    files.forEach((f) => formData.append('images', f));

    try {
      const res = await fetch('/api/admin/images/upload/', {
        method: 'POST',
        headers: { 'x-csrf-token': csrfToken },
        body: formData,
      });

      const json = await res.json();
      if (!res.ok) {
        alert(json.error || 'Failed to upload images to Cloudinary.');
        return;
      }

      if (Array.isArray(json.images) && json.images.length > 0) {
        const first = json.images[0];
        primaryUrlEl.value = first.url;
        if (first.originalName) {
          primaryAltEl.value = first.originalName.replace(/\.[^/.]+$/, '');
        }
        json.images.forEach((up: any) => {
          images.push({
            url: up.url,
            publicId: up.publicId,
            alt: up.originalName ? up.originalName.replace(/\.[^/.]+$/, '') : 'Recipe photo',
            width: up.width,
            height: up.height,
            isPrimary: images.length === 0,
          });
        });
      }
    } catch (err) {
      alert('Upload failed: ' + (err instanceof Error ? err.message : String(err)));
    } finally {
      progressEl.style.display = 'none';
    }
  }

  // Ingredients & Instructions dynamic builders
  const ingredientList = document.getElementById('ingredientList')!;
  const instructionList = document.getElementById('instructionList')!;

  function createIngredientRow(data: any = {}) {
    const row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML = `
      <input type="number" step="0.25" placeholder="Qty" value="${data.quantity ?? ''}" class="ing-qty" />
      <input type="text" placeholder="Unit (cup, lb)" value="${data.unit ?? ''}" class="ing-unit" />
      <input type="text" placeholder="Ingredient *" value="${data.item ?? ''}" required class="ing-item" />
      <input type="text" placeholder="Note (diced, etc.)" value="${data.note ?? ''}" class="ing-note" />
      <button type="button" class="btn btn-danger btn-pill" onclick="this.closest('.item-row').remove()">✕</button>
    `;
    return row;
  }

  function createInstructionRow(data: any = {}) {
    const row = document.createElement('div');
    row.className = 'step-row';
    row.innerHTML = `
      <input type="text" placeholder="Step title (optional)" value="${data.title ?? ''}" class="step-title" />
      <input type="text" placeholder="Instruction text *" value="${data.text ?? ''}" required class="step-text" />
      <button type="button" class="btn btn-danger btn-pill" onclick="this.closest('.step-row').remove()">✕</button>
    `;
    return row;
  }

  document.getElementById('addIngredientBtn')?.addEventListener('click', () => {
    ingredientList.appendChild(createIngredientRow());
  });
  document.getElementById('addInstructionBtn')?.addEventListener('click', () => {
    instructionList.appendChild(createInstructionRow());
  });

  // Default initial rows
  ingredientList.appendChild(createIngredientRow({ quantity: 2, unit: 'lb', item: 'chicken breast' }));
  instructionList.appendChild(createInstructionRow({ text: 'Place all ingredients into the slow cooker and cook on low.' }));

  // Form submission handler
  async function submitRecipe(targetStatus: 'draft' | 'tested') {
    reviewStatusInput.value = targetStatus;

    saveDraftBtn.disabled = true;
    publishBtn.disabled = true;
    formStatus.className = 'status';
    formStatus.style.display = 'block';
    formStatus.textContent = targetStatus === 'tested' ? 'Publishing recipe to GitHub...' : 'Saving draft to GitHub...';

    const ingredients = Array.from(ingredientList.querySelectorAll('.item-row')).map((row) => {
      const qty = (row.querySelector('.ing-qty') as HTMLInputElement).value;
      const unit = (row.querySelector('.ing-unit') as HTMLInputElement).value.trim();
      const item = (row.querySelector('.ing-item') as HTMLInputElement).value.trim();
      const note = (row.querySelector('.ing-note') as HTMLInputElement).value.trim();
      if (!item) return null;
      return {
        quantity: qty ? parseFloat(qty) : undefined,
        unit: unit || undefined,
        item,
        note: note || undefined,
      };
    }).filter(Boolean);

    const instructions = Array.from(instructionList.querySelectorAll('.step-row')).map((row) => {
      const title = (row.querySelector('.step-title') as HTMLInputElement).value.trim();
      const text = (row.querySelector('.step-text') as HTMLInputElement).value.trim();
      if (!text) return null;
      return { title: title || undefined, text };
    }).filter(Boolean);

    const getNutrVal = (n: string) => {
      const el = form.querySelector(`[name="${n}"]`) as HTMLInputElement | null;
      return el && el.value.trim() !== '' ? el.value.trim() : undefined;
    };

    const nutritionObj = {
      calories: getNutrVal('nutrition_calories'),
      proteinGrams: getNutrVal('nutrition_proteinGrams'),
      carbsGrams: getNutrVal('nutrition_carbsGrams'),
      fatGrams: getNutrVal('nutrition_fatGrams'),
      saturatedFatGrams: getNutrVal('nutrition_saturatedFatGrams'),
      fiberGrams: getNutrVal('nutrition_fiberGrams'),
      sodiumMilligrams: getNutrVal('nutrition_sodiumMilligrams'),
    };
    const hasNutrition = Object.values(nutritionObj).some((v) => v !== undefined);

    const selectedDietaryLabels = Array.from(form.querySelectorAll('input[name="dietaryLabels"]:checked')).map((el) => (el as HTMLInputElement).value);
    const isDietaryVerified = (form.querySelector('input[name="dietaryVerified"]') as HTMLInputElement)?.checked ?? false;
    const selectedAllergens = Array.from(form.querySelectorAll('input[name="allergens"]:checked')).map((el) => (el as HTMLInputElement).value);
    const isAllergenReviewed = (form.querySelector('input[name="allergenReviewed"]') as HTMLInputElement)?.checked ?? false;
    const allergenNotesVal = (form.querySelector('input[name="allergenNotes"]') as HTMLInputElement)?.value.trim() || undefined;

    const cookTimeNoteVal = (form.querySelector('[name="cookTimeNote"]') as HTMLInputElement)?.value.trim() || undefined;
    const foodSafetyLines = ((form.querySelector('[name="foodSafety"]') as HTMLTextAreaElement)?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const tipsLines = ((form.querySelector('[name="tips"]') as HTMLTextAreaElement)?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const equipmentLines = ((form.querySelector('[name="equipment"]') as HTMLTextAreaElement)?.value || '').split(/\r?\n/).map((s) => s.trim()).filter(Boolean);
    const bodyVal = ((form.querySelector('[name="body"]') as HTMLTextAreaElement)?.value || '').trim() || undefined;

    const payload = {
      title: (form.querySelector('[name="title"]') as HTMLInputElement).value.trim(),
      slug: (form.querySelector('[name="slug"]') as HTMLInputElement).value.trim(),
      description: (form.querySelector('[name="description"]') as HTMLTextAreaElement).value.trim(),
      category: (form.querySelector('[name="category"]') as HTMLSelectElement).value,
      author: (form.querySelector('[name="author"]') as HTMLInputElement).value.trim() || 'CrockBites',
      prepMinutes: parseInt((form.querySelector('[name="prepMinutes"]') as HTMLInputElement).value) || 0,
      cookMinutes: parseInt((form.querySelector('[name="cookMinutes"]') as HTMLInputElement).value) || 0,
      cookTimeNote: cookTimeNoteVal,
      servings: parseInt((form.querySelector('[name="servings"]') as HTMLInputElement).value) || 1,
      reviewStatus: targetStatus,
      tags: (form.querySelector('[name="tags"]') as HTMLInputElement).value.split(',').map((s) => s.trim()).filter(Boolean),
      image: primaryUrlEl.value.trim(),
      imageAlt: primaryAltEl.value.trim(),
      gallery: images,
      ingredients,
      instructions,
      foodSafety: foodSafetyLines,
      tips: tipsLines,
      equipment: equipmentLines,
      body: bodyVal,
      dietaryLabels: selectedDietaryLabels,
      dietaryVerified: isDietaryVerified,
      allergens: selectedAllergens,
      allergenReviewed: isAllergenReviewed,
      allergenNotes: allergenNotesVal,
      nutrition: hasNutrition ? nutritionObj : undefined,
    };

    if (!payload.title || !payload.description || ingredients.length === 0 || instructions.length === 0) {
      formStatus.className = 'status error';
      formStatus.textContent = 'Please provide a title, description, at least one ingredient, and one instruction.';
      saveDraftBtn.disabled = false;
      publishBtn.disabled = false;
      return;
    }

    try {
      const res = await fetch('/api/admin/recipes/', {
        method: 'POST',
        headers: {
          'content-type': 'application/json',
          'x-csrf-token': csrfToken,
        },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        formStatus.className = 'status error';
        formStatus.textContent = data.error || 'Failed to save recipe.';
        saveDraftBtn.disabled = false;
        publishBtn.disabled = false;
        return;
      }

      formStatus.className = 'status success';
      formStatus.textContent = `✓ Recipe successfully ${targetStatus === 'tested' ? 'published' : 'saved as draft'} to GitHub! Redirecting...`;
      setTimeout(() => {
        window.location.href = targetStatus === 'tested' ? '/admin/recipes/' : '/admin/recipes/?status=draft';
      }, 1000);
    } catch (err) {
      formStatus.className = 'status error';
      formStatus.textContent = 'Network error: ' + (err instanceof Error ? err.message : String(err));
      saveDraftBtn.disabled = false;
      publishBtn.disabled = false;
    }
  }

  saveDraftBtn.addEventListener('click', () => submitRecipe('draft'));
  publishBtn.addEventListener('click', () => submitRecipe('tested'));
</script>
