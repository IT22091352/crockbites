---
import { Image } from 'astro:assets';
import { Clock, Heart } from '@lucide/astro';
import { categoryById, recipeSlug, recipeUrl, totalMinutes, type Recipe } from '../utils/recipes';
import { formatMinutes } from '../utils/time';
import { rw, isRemoteImage, getOptimizedCloudinaryUrl } from '../utils/images';

interface Props {
  recipe: Recipe;
  /** Eager only for images that are visible without scrolling. */
  eager?: boolean;
  /** Horizontal list layout (used for "Latest recipes"). */
  layout?: 'card' | 'row';
}
const { recipe, eager = false, layout = 'card' } = Astro.props;
const d = recipe.data;
const slug = recipeSlug(recipe);
const cat = categoryById(d.category);
const isDraft = d.reviewStatus === 'draft';
const isRemote = isRemoteImage(d.image);
const imageUrl = typeof d.image === 'string' ? d.image : d.image.src;
---
{layout === 'card' ? (
  <article class="recipe-card card relative h-full">
    {!isDraft && (
      <button
        type="button"
        data-favorite-slug={slug}
        aria-pressed="false"
        aria-label="Save recipe"
        title="Save recipe"
        class="absolute right-3 top-3 z-10 inline-flex size-9 items-center justify-center rounded-full border border-line bg-paper/95 text-ink shadow-xs transition hover:scale-105 hover:border-terracotta-deep"
      >
        <Heart size={17} aria-hidden="true" />
      </button>
    )}
    <a href={recipeUrl(recipe)} class="recipe-card-link group">
      <div class="relative overflow-hidden">
        {isRemote ? (
          <img
            src={getOptimizedCloudinaryUrl(imageUrl, 720)}
            srcset={`${getOptimizedCloudinaryUrl(imageUrl, 360)} 360w, ${getOptimizedCloudinaryUrl(imageUrl, 540)} 540w, ${getOptimizedCloudinaryUrl(imageUrl, 720)} 720w`}
            sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 92vw"
            alt={d.imageAlt}
            width={720}
            height={540}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        ) : (
          <Image src={d.image as any} alt={d.imageAlt} {...rw(d.image as any, [360, 540, 720])} sizes="(min-width: 1024px) 24rem, (min-width: 640px) 45vw, 92vw"
            loading={eager ? 'eager' : 'lazy'} decoding="async" class="aspect-[4/3] w-full object-cover" />
        )}
        {isDraft && <span class="absolute left-3 top-3 rounded-full bg-paper/95 px-2.5 py-0.5 text-xs font-bold text-ink">Draft</span>}
      </div>
      <div class="p-5">
        <p class="text-sm font-semibold text-terracotta-deep">{cat?.name}</p>
        <h3 class="mt-1 text-[1.3rem] leading-snug transition-colors">{d.title}</h3>
        {d.dietaryVerified && d.dietaryLabels && d.dietaryLabels.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1">
            {d.dietaryLabels.slice(0, 3).map((lbl: string) => (
              <span class="rounded bg-forest/10 px-1.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wider text-forest">
                {lbl}
              </span>
            ))}
          </div>
        )}
        <p class="mt-2 line-clamp-2 text-[0.97rem] text-ink-soft">{d.description}</p>
        <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Clock size={16} aria-hidden="true" /><span class="sr-only">Total time:</span>{formatMinutes(totalMinutes(recipe))}</p>
      </div>
    </a>
  </article>
) : (
  <article class="recipe-card group relative border-b border-line py-5 first:pt-0 last:border-b-0">
    <a href={recipeUrl(recipe)} class="recipe-card-link grid grid-cols-[6.5rem_1fr] items-center gap-4 sm:grid-cols-[9rem_1fr] sm:gap-6">
      <div class="overflow-hidden rounded-xl">
        {isRemote ? (
          <img
            src={getOptimizedCloudinaryUrl(imageUrl, 432)}
            srcset={`${getOptimizedCloudinaryUrl(imageUrl, 216)} 216w, ${getOptimizedCloudinaryUrl(imageUrl, 288)} 288w, ${getOptimizedCloudinaryUrl(imageUrl, 432)} 432w`}
            sizes="(min-width: 640px) 9rem, 6.5rem"
            alt={d.imageAlt}
            width={288}
            height={216}
            loading={eager ? 'eager' : 'lazy'}
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        ) : (
          <Image src={d.image as any} alt={d.imageAlt} {...rw(d.image as any, [216, 288, 432])} sizes="(min-width: 640px) 9rem, 6.5rem"
            loading={eager ? 'eager' : 'lazy'} decoding="async" class="aspect-[4/3] w-full object-cover" />
        )}
      </div>
      <div class="pr-10">
        <p class="text-sm font-semibold text-terracotta-deep">{cat?.name}{isDraft && <span class="ml-2 rounded-full border border-line px-2 py-0.5 text-xs font-bold text-ink-soft">Draft</span>}</p>
        <h3 class="mt-0.5 text-[1.25rem] leading-snug transition-colors">{d.title}</h3>
        <p class="mt-1 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Clock size={16} aria-hidden="true" /><span class="sr-only">Total time:</span>{formatMinutes(totalMinutes(recipe))}</p>
      </div>
    </a>
    {!isDraft && (
      <button
        type="button"
        data-favorite-slug={slug}
        aria-pressed="false"
        aria-label="Save recipe"
        title="Save recipe"
        class="absolute right-1 top-1/2 -translate-y-1/2 inline-flex size-9 items-center justify-center rounded-full border border-line bg-paper text-ink transition hover:border-terracotta-deep"
      >
        <Heart size={16} aria-hidden="true" />
      </button>
    )}
  </article>
)}
