---
import { Image } from 'astro:assets';
import {
  Clock,
  Users,
  Printer,
  Thermometer,
  Minus,
  Plus,
  ArrowDown,
  ListOrdered,
  TriangleAlert,
  Info,
  ChefHat,
  Timer,
  ShieldAlert,
  ShieldCheck,
  X,
  ChevronLeft,
  ChevronRight,
  Heart,
  FolderPlus,
  MessageSquare,
} from '@lucide/astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RecipeCard from './RecipeCard.astro';
import AdSlot from './AdSlot.astro';
import { categoryById, recipeSlug, recipeUrl, totalMinutes, absoluteUrl, type Recipe } from '../utils/recipes';
import { amountText, itemText } from '../utils/quantity';
import { formatMinutes } from '../utils/time';
import { rw, isRemoteImage, getOptimizedCloudinaryUrl } from '../utils/images';
import { extractInstructionDuration } from '../utils/timer';

interface Props { recipe: Recipe; related: Recipe[] }
const { recipe, related } = Astro.props;
const d = recipe.data;
const slug = recipeSlug(recipe);
const isDraft = d.reviewStatus === 'draft';
const cat = categoryById(d.category);
const total = totalMinutes(recipe);
const fmtDate = (dt: Date) => dt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isRemote = isRemoteImage(d.image);
const imageUrl = typeof d.image === 'string' ? d.image : (d.image as any).src;
const gallery = (d as any).gallery as Array<{ url: string; alt: string; width?: number; height?: number }> | undefined;

// Group ingredients under their optional headings, keeping the original order.
const groups: { name?: string; items: typeof d.ingredients }[] = [];
for (const ing of d.ingredients) {
  const last = groups[groups.length - 1];
  if (last && last.name === ing.group) last.items.push(ing);
  else groups.push({ name: ing.group, items: [ing] });
}
const maxServings = Math.max(d.servings * 4, 24);
const n = d.nutrition;
const hasNutrition = Boolean(
  n && (
    n.calories != null ||
    n.proteinGrams != null ||
    n.carbsGrams != null ||
    n.fatGrams != null ||
    n.saturatedFatGrams != null ||
    n.unsaturatedFatGrams != null ||
    n.fiberGrams != null ||
    n.sugarGrams != null ||
    n.sodiumMilligrams != null ||
    n.cholesterolMilligrams != null
  )
);

const dietaryLabelNames: Record<string, string> = {
  'vegetarian': 'Vegetarian',
  'vegan': 'Vegan',
  'gluten-free': 'Gluten-Free',
  'dairy-free': 'Dairy-Free',
  'nut-free': 'Nut-Free',
  'low-carb': 'Low-Carb',
  'keto-friendly': 'Keto-Friendly',
  'high-protein': 'High-Protein',
  'low-sodium': 'Low-Sodium',
  'pescatarian': 'Pescatarian',
};

const allergenNames: Record<string, string> = {
  'milk': 'Milk',
  'eggs': 'Eggs',
  'fish': 'Fish',
  'crustacean-shellfish': 'Crustacean Shellfish',
  'tree-nuts': 'Tree Nuts',
  'peanuts': 'Peanuts',
  'wheat': 'Wheat',
  'soybeans': 'Soybeans',
  'sesame': 'Sesame',
};
---
<article>
  <div class="container-page pb-6 pt-6" data-noprint>
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Recipes', href: '/recipes/' }, { name: cat!.name, href: `/category/${cat!.id}/` }, { name: d.title }]} />
    <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-12">
      <div>
        <a class="chip" href={`/category/${cat!.id}/`}>{cat!.name}</a>
        {d.dietaryVerified && d.dietaryLabels && d.dietaryLabels.length > 0 && (
          <div class="mt-3 flex flex-wrap items-center gap-1.5" aria-label="Verified dietary suitability" data-dietary-badges>
            {d.dietaryLabels.map((lbl: string) => (
              <span class="inline-flex items-center gap-1 rounded-full border border-forest/20 bg-forest/10 px-2.5 py-0.5 text-xs font-semibold text-forest">
                <ShieldCheck size={13} class="text-forest" aria-hidden="true" />
                {dietaryLabelNames[lbl] || lbl}
              </span>
            ))}
          </div>
        )}
        <h1 class="mt-4">{d.title}</h1>
        {!isDraft && (
          <div class="mt-2.5 flex flex-wrap items-center gap-3 text-sm" data-recipe-header-rating>
            <a
              href="#recipe-reviews"
              id="recipe-rating-summary-pill"
              class="inline-flex items-center gap-1.5 rounded-full border border-line bg-paper px-3 py-1 text-xs font-semibold text-ink no-underline transition hover:border-forest"
            >
              <span id="header-stars-display" class="text-terracotta-deep">★★★★★</span>
              <span id="header-rating-text">Rate this recipe</span>
            </a>
          </div>
        )}
        <p class="mt-4 max-w-xl text-lg text-ink-soft">{d.description}</p>
        <p class="mt-4 text-sm text-ink-soft">
          By {d.author} · Published <time datetime={d.pubDate.toISOString().slice(0, 10)}>{fmtDate(d.pubDate)}</time>
          {d.updatedDate && <> · Updated <time datetime={d.updatedDate.toISOString().slice(0, 10)}>{fmtDate(d.updatedDate)}</time></>}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a class="btn" href="#recipe-card"><ArrowDown size={18} aria-hidden="true" />Jump to recipe</a>
          <button type="button" class="btn btn-outline" data-start-cooking><ChefHat size={18} aria-hidden="true" />Start Cooking</button>
          {!isDraft && (
            <>
              <button
                type="button"
                class="btn btn-outline"
                data-favorite-slug={slug}
                aria-pressed="false"
                aria-label="Save recipe"
              >
                <Heart size={18} aria-hidden="true" />
                <span>Save Recipe</span>
              </button>
              <div class="relative">
                <button
                  type="button"
                  id="recipe-collection-btn"
                  class="btn btn-outline"
                  aria-expanded="false"
                  aria-controls="recipe-collection-popover"
                >
                  <FolderPlus size={18} aria-hidden="true" />
                  <span>Add to Collection</span>
                </button>
                <div
                  id="recipe-collection-popover"
                  hidden
                  class="absolute left-0 top-full z-30 mt-2 w-72 rounded-2xl border border-line bg-paper p-4 shadow-lg"
                >
                  <div class="flex items-center justify-between border-b border-line pb-2">
                    <p class="font-display text-sm font-semibold text-forest">Save to Collection</p>
                    <button
                      type="button"
                      id="close-collection-popover"
                      class="rounded p-1 text-xs text-ink-soft hover:text-ink"
                      aria-label="Close collection menu"
                    >
                      ✕
                    </button>
                  </div>
                  <div id="collection-popover-list" class="mt-3 max-h-48 space-y-2 overflow-y-auto text-sm">
                    <p class="text-xs text-ink-soft">Loading your collections...</p>
                  </div>
                  <form id="quick-create-collection-form" class="mt-3 flex gap-1.5 border-t border-line pt-3">
                    <input
                      type="text"
                      name="name"
                      required
                      minlength="2"
                      maxlength="80"
                      placeholder="New collection name..."
                      class="min-w-0 flex-1 rounded-lg border border-line bg-cream/60 px-2.5 py-1.5 text-xs text-ink focus:border-forest focus:outline-hidden"
                    />
                    <button
                      type="submit"
                      class="rounded-lg bg-forest px-2.5 py-1.5 text-xs font-semibold text-cream hover:bg-forest/90"
                    >
                      Create
                    </button>
                  </form>
                </div>
              </div>
            </>
          )}
          <a class="btn btn-outline" href="#instructions"><ListOrdered size={18} aria-hidden="true" />Jump to instructions</a>
          <button type="button" class="btn btn-outline" data-print><Printer size={18} aria-hidden="true" />Print recipe</button>
        </div>
      </div>
      <div class="overflow-hidden rounded-[1.75rem] border border-line shadow-[var(--shadow-card)]">
        {isRemote ? (
          <img
            src={getOptimizedCloudinaryUrl(imageUrl, 1280)}
            srcset={`${getOptimizedCloudinaryUrl(imageUrl, 640)} 640w, ${getOptimizedCloudinaryUrl(imageUrl, 960)} 960w, ${getOptimizedCloudinaryUrl(imageUrl, 1280)} 1280w, ${getOptimizedCloudinaryUrl(imageUrl, 1600)} 1600w`}
            sizes="(min-width: 1024px) 40rem, 100vw"
            alt={d.imageAlt}
            width={1280}
            height={960}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
        ) : (
          <Image src={d.image as any} alt={d.imageAlt} {...rw(d.image as any, [640, 960, 1280, 1600])} sizes="(min-width: 1024px) 40rem, 100vw"
            loading="eager" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full object-cover" />
        )}
      </div>
    </div>

    {d.reviewStatus === 'draft' && (
      <div class="notice mt-8 flex gap-3" role="note">
        <TriangleAlert class="mt-0.5 shrink-0 text-terracotta-deep" size={20} aria-hidden="true" />
        <p><strong>Editorial draft.</strong> This recipe has not been cooked and tested by a person yet. Quantities and times are estimates, so use your judgment and a food thermometer. Images on this page are placeholder illustrations.</p>
      </div>
    )}

    <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
      <div class="bg-paper p-4"><dt class="flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Clock size={16} aria-hidden="true" />Prep</dt><dd class="mt-1 font-display text-xl font-semibold text-forest">{formatMinutes(d.prepMinutes)}</dd></div>
      <div class="bg-paper p-4"><dt class="flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Clock size={16} aria-hidden="true" />Cook</dt><dd class="mt-1 font-display text-xl font-semibold text-forest">{formatMinutes(d.cookMinutes)}</dd></div>
      <div class="bg-paper p-4"><dt class="flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Clock size={16} aria-hidden="true" />Total</dt><dd class="mt-1 font-display text-xl font-semibold text-forest">{formatMinutes(total)}</dd></div>
      <div class="bg-paper p-4"><dt class="flex items-center gap-1.5 text-sm font-semibold text-ink-soft"><Users size={16} aria-hidden="true" />Serves</dt><dd class="mt-1 font-display text-xl font-semibold text-forest">{d.servings} {d.servingsLabel}</dd></div>
    </dl>
    {d.cookTimeNote && <p class="mt-3 text-[0.97rem] text-ink-soft">{d.cookTimeNote}. Times are estimates; slow cookers vary, so cook to temperature and tenderness.</p>}

    {Astro.slots.has('intro') && (
      <div class="prose-crock mt-10"><slot name="intro" /></div>
    )}
    {gallery && gallery.length > 0 && (
      <section aria-labelledby="gallery-heading" class="mt-12">
        <h2 id="gallery-heading" class="text-[1.6rem]">Recipe Gallery</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
          {gallery.map((img) => (
            <figure class="overflow-hidden rounded-2xl border border-line bg-paper">
              <img
                src={getOptimizedCloudinaryUrl(img.url, 600)}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full object-cover transition-transform duration-300 hover:scale-105"
              />
              {img.alt && <figcaption class="p-3 text-xs text-ink-soft">{img.alt}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
    <AdSlot slot="recipeAfterIntro" />
  </div>

  <!-- The structured recipe card: also the only thing that prints. -->
  <section id="recipe-card" aria-labelledby="recipe-card-title" class="container-page scroll-mt-20">
    <div class="card recipe-card-print p-5 sm:p-8 lg:p-10" data-scaler data-base={d.servings} data-max={maxServings}>
      <p class="print-only mb-3 text-sm font-semibold">CrockBites · Good Food. Less Fuss. · {absoluteUrl(recipeUrl(recipe))}</p>
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-line pb-6">
        <div>
          <h2 id="recipe-card-title">{d.title}</h2>
          <p class="mt-2 text-[0.97rem] text-ink-soft">Prep {formatMinutes(d.prepMinutes)} · Cook {formatMinutes(d.cookMinutes)} · Total {formatMinutes(total)}{d.cookTimeNote ? ` · ${d.cookTimeNote}` : ''}</p>
        </div>
        <div class="flex items-center gap-2" data-noprint>
          <button type="button" class="btn btn-primary btn-small" data-start-cooking><ChefHat size={16} aria-hidden="true" />Start Cooking</button>
          <button type="button" class="btn btn-outline btn-small" data-print><Printer size={16} aria-hidden="true" />Print recipe</button>
        </div>
      </div>

      <!-- Interactive Controls: Servings Scaler & Unit Converter -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-b border-line pb-6" role="group" aria-label="Recipe controls">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <p id="servings-label" class="font-semibold text-forest">Servings:</p>
          <div class="inline-flex items-center gap-1 rounded-full border border-forest-soft bg-cream p-1" data-noprint>
            <button type="button" class="grid size-9 place-content-center rounded-full hover:bg-cream-deep disabled:opacity-40" data-dec aria-label="Decrease servings"><Minus size={16} aria-hidden="true" /></button>
            <output class="min-w-[3.2rem] text-center font-display text-lg font-semibold text-forest" data-servings-out aria-live="polite">{d.servings}</output>
            <button type="button" class="grid size-9 place-content-center rounded-full hover:bg-cream-deep disabled:opacity-40" data-inc aria-label="Increase servings"><Plus size={16} aria-hidden="true" /></button>
          </div>
          <span class="print-only">Makes <span data-servings-out>{d.servings}</span> {d.servingsLabel}</span>
          <button type="button" class="link-text text-[0.92rem] font-semibold" data-reset hidden data-noprint>Reset ({d.servings})</button>
        </div>

        <div class="flex items-center gap-2" data-noprint>
          <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Units:</span>
          <div class="unit-toggle" role="radiogroup" aria-label="Measurement unit system">
            <button type="button" class="unit-toggle-btn active" data-unit-btn="us" role="radio" aria-checked="true">US Customary</button>
            <button type="button" class="unit-toggle-btn" data-unit-btn="metric" role="radio" aria-checked="false">Metric</button>
          </div>
        </div>
      </div>

      <p class="mt-3 text-sm text-ink-soft" data-scale-note hidden data-noprint role="status">
        <Info size={14} class="mr-1 inline align-[-2px]" aria-hidden="true" />Only the ingredient amounts change. Cooking time does not scale in proportion, and a slow cooker should be about half to two-thirds full. Check temperature, not just time.
      </p>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12 print:block">
        <div>
          <h3 class="font-display text-2xl">Ingredients</h3>
          <p class="mt-1 text-sm text-ink-soft" data-noprint>Tick items off as you gather them.</p>
          {groups.map((g) => (
            <div class="mt-5">
              {g.name && <h4 class="font-display text-lg font-semibold text-terracotta-deep">{g.name}</h4>}
              <ul class="mt-1">
                {g.items.map((ing) => (
                  <li data-ing data-qty={ing.quantity ?? 0} data-unit={ing.unit ?? ''} data-item={ing.item} data-plural={ing.itemPlural ?? ''} data-scale={String(ing.scale)}>
                    <label class="check-row">
                      <input type="checkbox" />
                      <span>
                        {ing.quantity ? <strong class="font-semibold text-forest" data-amount>{amountText(ing)}</strong> : null}{' '}
                        {ing.alt && <span class="text-ink-soft" data-alt>{ing.alt}</span>}{ing.alt ? ' ' : ''}
                        <span data-name>{itemText(ing)}</span>{ing.note && <span class="text-ink-soft">, {ing.note}</span>}
                      </span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {d.equipment.length > 0 && (
            <div class="mt-8">
              <h3 class="font-display text-xl">Equipment</h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 marker:text-terracotta-deep">{d.equipment.map((e) => <li>{e}</li>)}</ul>
            </div>
          )}
        </div>

        <div id="instructions" class="scroll-mt-24 print:mt-8">
          <h3 class="font-display text-2xl">Instructions</h3>
          <ol class="mt-4 space-y-6">
            {d.instructions.map((s, i) => {
              const duration = extractInstructionDuration(s.text);
              return (
                <li id={`step-${i + 1}`} class="step-row flex gap-4">
                  <span class="step-num" aria-hidden="true">{i + 1}</span>
                  <div class="flex-1">
                    {s.title && <p class="font-display text-lg font-semibold text-forest"><span class="sr-only">Step {i + 1}: </span>{s.title}</p>}
                    <p class="mt-1 text-ink">{s.text}</p>
                    {duration && (
                      <div class="mt-3 flex flex-wrap items-center gap-2.5" data-noprint>
                        <button
                          type="button"
                          class="step-timer-badge"
                          data-step-timer-btn={i + 1}
                          data-total-seconds={duration.totalSeconds}
                          data-label={duration.label}
                          aria-label={`Cooking timer for step ${i + 1}: ${duration.label}`}
                        >
                          <Timer size={14} aria-hidden="true" />
                          <span data-timer-label>Start {duration.label} timer</span>
                        </button>
                        <span class="timer-countdown font-mono text-xs font-bold text-terracotta-deep hidden" data-timer-countdown={i + 1}></span>
                        <button type="button" class="link-text text-xs" data-timer-reset={i + 1} hidden>Reset</button>
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </div>
      </div>

      {d.foodSafety.length > 0 && (
        <div class="notice mt-10" role="note">
          <p class="flex items-center gap-2 font-display text-lg font-semibold text-forest"><Thermometer size={20} class="text-terracotta-deep" aria-hidden="true" />Food safety</p>
          <ul class="mt-2 list-disc space-y-1.5 pl-5 marker:text-terracotta-deep">{d.foodSafety.map((f) => <li>{f}</li>)}</ul>
        </div>
      )}
      {hasNutrition && (
        <section id="recipe-nutrition" aria-labelledby="nutrition-heading" class="mt-8 border-t border-line pt-6" data-recipe-nutrition>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 id="nutrition-heading" class="font-display text-xl font-bold text-forest">Nutrition Information</h3>
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-soft">Per serving ({d.servingsLabel || 'serving'})</span>
          </div>

          <!-- Quick Macro Cards -->
          <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
            {n!.calories != null && (
              <div class="rounded-xl border border-line bg-cream p-3 text-center">
                <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">Calories</span>
                <span class="mt-1 font-display text-xl font-bold text-forest">{n!.calories} <span class="text-xs font-normal text-ink-soft">kcal</span></span>
              </div>
            )}
            {n!.proteinGrams != null && (
              <div class="rounded-xl border border-line bg-cream p-3 text-center">
                <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">Protein</span>
                <span class="mt-1 font-display text-xl font-bold text-forest">{n!.proteinGrams} <span class="text-xs font-normal text-ink-soft">g</span></span>
              </div>
            )}
            {n!.carbsGrams != null && (
              <div class="rounded-xl border border-line bg-cream p-3 text-center">
                <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">Carbs</span>
                <span class="mt-1 font-display text-xl font-bold text-forest">{n!.carbsGrams} <span class="text-xs font-normal text-ink-soft">g</span></span>
              </div>
            )}
            {n!.fatGrams != null && (
              <div class="rounded-xl border border-line bg-cream p-3 text-center">
                <span class="block text-xs font-semibold uppercase tracking-wider text-ink-soft">Total Fat</span>
                <span class="mt-1 font-display text-xl font-bold text-forest">{n!.fatGrams} <span class="text-xs font-normal text-ink-soft">g</span></span>
              </div>
            )}
          </div>

          <!-- Detailed Verified Micronutrient Breakdown -->
          <div class="mt-4 overflow-hidden rounded-xl border border-line bg-paper">
            <dl class="divide-y divide-line text-sm">
              {n!.fatGrams != null && (
                <div class="flex justify-between px-4 py-2 font-medium">
                  <dt class="text-forest">Total Fat</dt>
                  <dd class="font-semibold text-ink">{n!.fatGrams} g</dd>
                </div>
              )}
              {n!.saturatedFatGrams != null && (
                <div class="flex justify-between px-4 py-2 pl-8 text-ink-soft">
                  <dt>Saturated Fat</dt>
                  <dd class="font-medium text-ink">{n!.saturatedFatGrams} g</dd>
                </div>
              )}
              {n!.unsaturatedFatGrams != null && (
                <div class="flex justify-between px-4 py-2 pl-8 text-ink-soft">
                  <dt>Unsaturated Fat</dt>
                  <dd class="font-medium text-ink">{n!.unsaturatedFatGrams} g</dd>
                </div>
              )}
              {n!.cholesterolMilligrams != null && (
                <div class="flex justify-between px-4 py-2 font-medium">
                  <dt class="text-forest">Cholesterol</dt>
                  <dd class="font-semibold text-ink">{n!.cholesterolMilligrams} mg</dd>
                </div>
              )}
              {n!.sodiumMilligrams != null && (
                <div class="flex justify-between px-4 py-2 font-medium">
                  <dt class="text-forest">Sodium</dt>
                  <dd class="font-semibold text-ink">{n!.sodiumMilligrams} mg</dd>
                </div>
              )}
              {n!.carbsGrams != null && (
                <div class="flex justify-between px-4 py-2 font-medium">
                  <dt class="text-forest">Total Carbohydrates</dt>
                  <dd class="font-semibold text-ink">{n!.carbsGrams} g</dd>
                </div>
              )}
              {n!.fiberGrams != null && (
                <div class="flex justify-between px-4 py-2 pl-8 text-ink-soft">
                  <dt>Dietary Fiber</dt>
                  <dd class="font-medium text-ink">{n!.fiberGrams} g</dd>
                </div>
              )}
              {n!.sugarGrams != null && (
                <div class="flex justify-between px-4 py-2 pl-8 text-ink-soft">
                  <dt>Total Sugars</dt>
                  <dd class="font-medium text-ink">{n!.sugarGrams} g</dd>
                </div>
              )}
              {n!.proteinGrams != null && (
                <div class="flex justify-between px-4 py-2 font-medium">
                  <dt class="text-forest">Protein</dt>
                  <dd class="font-semibold text-ink">{n!.proteinGrams} g</dd>
                </div>
              )}
            </dl>
          </div>

          <!-- Metadata & Disclaimer Footer -->
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-soft">
            <div>
              {n!.source && <span>Source: <strong class="text-forest">{n!.source}</strong></span>}
              {n!.source && n!.verifiedDate && <span> · </span>}
              {n!.verifiedDate && <span>Verified: <time datetime={n!.verifiedDate}>{n!.verifiedDate}</time></span>}
            </div>
