---
import { Search, Menu, X, User } from '@lucide/astro';
import Logo from './Logo.astro';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Recipes', href: '/recipes/' },
  { label: 'Slow Cooker', href: '/category/slow-cooker/' },
  { label: 'Dinner Ideas', href: '/category/dinner-ideas/' },
  { label: 'About', href: '/about/' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-line bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85" data-noprint>
  <div class="container-page flex h-16 items-center justify-between gap-4 md:h-[4.5rem]">
    <Logo />
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1 lg:gap-2">
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}
               class="rounded-full px-3.5 py-2 text-[0.97rem] font-semibold text-ink no-underline transition-colors hover:bg-cream-deep aria-[current=page]:bg-forest aria-[current=page]:text-cream">
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/search/" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-paper px-3.5 text-[0.95rem] font-semibold text-ink no-underline transition-colors hover:border-forest" data-search-link>
        <Search size={18} aria-hidden="true" /><span class="hidden sm:inline">Search</span><span class="sr-only sm:hidden">Search recipes</span>
        <kbd class="hidden rounded border border-line bg-cream px-1.5 text-xs text-ink-soft lg:inline" aria-hidden="true">/</kbd>
      </a>
      <a
        href="/login/"
        data-header-account-link
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-paper px-3.5 text-[0.95rem] font-semibold text-ink no-underline transition-colors hover:border-forest"
      >
        <User size={18} aria-hidden="true" />
        <span data-header-account-label class="hidden sm:inline">Sign In</span>
        <span class="sr-only sm:hidden">Account</span>
      </a>
      <button type="button" id="menu-open" class="inline-flex size-11 items-center justify-center rounded-full border border-line bg-paper md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
        <Menu size={22} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col overflow-y-auto bg-forest text-cream md:hidden" role="dialog" aria-modal="true" aria-label="Menu" data-noprint>
  <div class="flex h-16 shrink-0 items-center justify-between px-5">
    <Logo variant="light" />
    <button type="button" id="menu-close" class="inline-flex size-11 items-center justify-center rounded-full border border-cream/40" aria-label="Close menu">
      <X size={22} aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Mobile" class="px-5 pb-10 pt-4">
    <ul class="divide-y divide-cream/15">
      {nav.map((n) => (
        <li><a href={n.href} class="block py-4 font-display text-2xl font-semibold text-cream no-underline" aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a href="/search/" class="block py-4 font-display text-2xl font-semibold text-cream no-underline">Search</a></li>
      <li><a href="/login/" data-mobile-account-link class="block py-4 font-display text-2xl font-semibold text-cream no-underline">Sign In / Register</a></li>
    </ul>
    <p class="mt-8 font-display text-lg text-cream/80">Good Food. Less Fuss.</p>
  </nav>
</div>

<script>
  const menu = document.getElementById('mobile-menu')!;
  const openBtn = document.getElementById('menu-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('menu-close') as HTMLButtonElement;
  const focusables = () => Array.from(menu.querySelectorAll<HTMLElement>('a[href], button'));

  function open() {
    menu.classList.remove('hidden'); menu.classList.add('flex');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }
  function close(returnFocus = true) {
    menu.classList.add('hidden'); menu.classList.remove('flex');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (returnFocus) openBtn.focus();
  }
  openBtn.addEventListener('click', open);
  closeBtn.addEventListener('click', () => close());
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) close(false); });
  menu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { close(); return; }
    if (e.key !== 'Tab') return;
    const items = focusables(); const first = items[0], last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (m) => { if (m.matches) close(false); });

  // Progressive Community Auth & Card Favorites Hydration
  async function initCommunityHeaderAndCards() {
    try {
      const meRes = await fetch('/api/auth/me/', { credentials: 'same-origin' });
      if (!meRes.ok) return;
      const meData = await meRes.json();

      const headerLink = document.querySelector<HTMLAnchorElement>('[data-header-account-link]');
      const headerLabel = document.querySelector<HTMLElement>('[data-header-account-label]');
      const mobileLink = document.querySelector<HTMLAnchorElement>('[data-mobile-account-link]');

      let savedSet = new Set<string>();

      function decodeDisplayText(str: unknown): string {
        return String(str ?? '')
          .replace(/&#39;|&apos;/g, "'")
          .replace(/&quot;/g, '"')
          .replace(/&gt;/g, '>')
          .replace(/&lt;/g, '<')
          .replace(/&amp;/g, '&');
      }

      if (meData.authenticated && meData.user) {
        const cleanDisplayName = decodeDisplayText(meData.user.displayName) || 'My Kitchen';
        if (headerLink) {
          headerLink.href = '/account/';
          headerLink.classList.add('border-forest/40');
        }
        if (headerLabel) {
          headerLabel.textContent = cleanDisplayName;
        }
        if (mobileLink) {
          mobileLink.href = '/account/';
          mobileLink.textContent = `My Kitchen (${cleanDisplayName})`;
        }

        if (Array.isArray(meData.favoriteSlugs)) {
          for (const slug of meData.favoriteSlugs) {
            if (slug) savedSet.add(String(slug).toLowerCase());
          }
        }
      }

      (window as any).__CROCKBITES_AUTH__ = {
        authenticated: Boolean(meData.authenticated),
        user: meData.user || null,
        csrfToken: meData.csrfToken || '',
        savedSlugs: Array.from(savedSet),
      };
      window.dispatchEvent(new CustomEvent('crockbites:auth-ready', { detail: (window as any).__CROCKBITES_AUTH__ }));

      function applyFavoriteButtonState(btn: HTMLButtonElement, isSaved: boolean) {
        btn.setAttribute('aria-pressed', isSaved ? 'true' : 'false');
        btn.setAttribute('aria-label', isSaved ? 'Remove from saved recipes' : 'Save recipe');
        btn.title = isSaved ? 'Saved to My Kitchen' : 'Save recipe';
        const icon = btn.querySelector('svg');
        if (icon) {
          if (isSaved) {
            icon.setAttribute('fill', 'currentColor');
            btn.classList.add('text-terracotta-deep', 'border-terracotta-deep/40');
          } else {
            icon.setAttribute('fill', 'none');
            btn.classList.remove('text-terracotta-deep', 'border-terracotta-deep/40');
          }
        }
      }

      document.querySelectorAll<HTMLButtonElement>('[data-favorite-slug]').forEach((btn) => {
        const slug = (btn.getAttribute('data-favorite-slug') || '').toLowerCase();
        if (!slug) return;
        applyFavoriteButtonState(btn, savedSet.has(slug));

        if (btn.dataset.boundFav === '1') return;
        btn.dataset.boundFav = '1';

        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();

          const auth = (window as any).__CROCKBITES_AUTH__;
          if (!auth || !auth.authenticated) {
            const returnTo = window.location.pathname + window.location.search;
            window.location.href = `/login/?returnTo=${encodeURIComponent(returnTo)}`;
            return;
          }

          btn.disabled = true;
          try {
            const res = await fetch('/api/community/favorites/', {
              method: 'POST',
              headers: {
                'content-type': 'application/json',
                'x-csrf-token': auth.csrfToken || '',
              },
              body: JSON.stringify({
                recipeSlug: slug,
                action: 'toggle',
                csrfToken: auth.csrfToken || '',
              }),
            });
            if (res.status === 401) {
              window.location.href = `/login/?returnTo=${encodeURIComponent(window.location.pathname)}`;
              return;
            }
            const data = await res.json();
            if (res.ok) {
              const nowSaved = Boolean(data.saved);
              if (nowSaved) savedSet.add(slug);
              else savedSet.delete(slug);
              document
                .querySelectorAll<HTMLButtonElement>(`[data-favorite-slug="${slug}"]`)
                .forEach((b) => applyFavoriteButtonState(b, nowSaved));
            }
          } finally {
            btn.disabled = false;
          }
        });
      });
    } catch {
      // Progressive enhancement: ignore offline/network errors silently
    }
  }

  initCommunityHeaderAndCards();
</script>
